   20. DASHBOARD
--------------------------------------------------------- */
ROUTE_RENDERERS['dashboard'] = async function(container){
  const [customers, vendors, accounts, allTxns, allEntries, invoices] = await Promise.all([
    dbGetAll('customers'), dbGetAll('vendors'), dbGetAll('accounts'), dbGetAll('transactions'), dbGetAll('serviceEntries'), dbGetAll('invoices')
  ]);

  // Total cash+bank position in IDR
  let totalCashBankBase = 0;
  for(const a of accounts){
    if(a.system) continue;
    const bal = await getAccountBalance(a.id);
    totalCashBankBase += toBase(bal, a.currency===BASE_CURRENCY?1:getRate(a.currency));
  }
  // Receivable / payable totals
  let totalReceivable=0, totalPayable=0;
  for(const c of customers){ const rows = await getPartyLedger('customer', c.id); const bal = rows.length?rows[rows.length-1].balance:0; if(bal>0) totalReceivable+=bal; }
  for(const v of vendors){ const rows = await getPartyLedger('vendor', v.id); const bal = rows.length?rows[rows.length-1].balance:0; if(bal>0) totalPayable+=bal; }

  // This month's entries count
  const now = new Date(); const monthStart = localISO(new Date(now.getFullYear(), now.getMonth(), 1));
  const entriesThisMonth = allEntries.filter(e=>e.date>=monthStart).length;

  // Visa expiry alerts
  const alertDays = Number(STATE.settings.visaAlertDays)||90;
  const visaAlerts = allEntries.filter(e=>{
    const cfg = getServiceCfg(e.type);
    return cfg && cfg.trackExpiry && e.data && e.data.expiryDate;
  }).map(e=>{
    const cfg = getServiceCfg(e.type);
    const cust = customers.find(c=>c.id===e.customerId);
    const days = daysBetween(todayISO(), e.data.expiryDate);
    return {refNo:e.refNo, service:cfg.label, client: cust?cust.name:'—', expiry:e.data.expiryDate, days};
  }).filter(a=>a.days<=alertDays).sort((a,b)=>a.days-b.days);

  // Service distribution (pie) — count by service type, all time
  const pieData = SERVICE_CONFIG.map(s=>({label:s.label, value: allEntries.filter(e=>e.type===s.key).length})).filter(d=>d.value>0);

  // Monthly revenue (bar) — sum of Paid Amount (common) + loan disbursements this year, by month, in IDR
  const year = now.getFullYear();
  const monthly = Array.from({length:12},(_,i)=>({label: new Date(year,i,1).toLocaleDateString('en-GB',{month:'short'}), value:0}));
  allEntries.forEach(e=>{
    if(!e.date || new Date(e.date).getFullYear()!==year) return;
    const m = new Date(e.date).getMonth();
    if(e.finance && e.finance.paidAmount){ monthly[m].value += toBase(e.finance.paidAmount, e.finance.currency===BASE_CURRENCY?1:(e.finance.rate||getRate(e.finance.currency))); }
  });

  // Cash flow trend (line) — net movement per month across all accounts, last 6 months
  const last6 = [];
  for(let i=5;i>=0;i--){
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    last6.push({y:d.getFullYear(), m:d.getMonth(), label:d.toLocaleDateString('en-GB',{month:'short'})});
  }
  const lineData = last6.map(({y,m,label})=>{
    const from = localISO(new Date(y,m,1));
    const to = localISO(new Date(y,m+1,0));
    let net = 0;
    allTxns.forEach(t=>{ if(t.date>=from && t.date<=to && STATE.accounts.find(a=>a.id===t.accountId && !a.system)){ net += (t.direction==='in'?1:-1)*(t.amountBase||0); } });
    return {label, value: net};
  });

  container.innerHTML = `
    <div class="grid grid-4">
      <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">Total Cash &amp; Bank (USD)</div><div class="stat-value">${fmtMoney(totalCashBankBase,'USD')}</div><div class="stat-foot">Across ${accounts.filter(a=>!a.system).length} accounts</div></div>
      <div class="stat-card" style="--accent:var(--amber);"><div class="stat-label">Total Receivable</div><div class="stat-value">${fmtMoney(totalReceivable,'USD')}</div><div class="stat-foot">${customers.length} customers on file</div></div>
      <div class="stat-card" style="--accent:var(--red);"><div class="stat-label">Total Payable</div><div class="stat-value">${fmtMoney(totalPayable,'USD')}</div><div class="stat-foot">${vendors.length} vendors on file</div></div>
      <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Entries This Month</div><div class="stat-value">${entriesThisMonth}</div><div class="stat-foot">${invoices.length} invoices issued total</div></div>
    </div>

    ${visaAlerts.length>0 ? `
    <div class="card mt-14">
      <div class="card-header">
        <span class="card-title">⚠️ Visa Expiry Alerts <span class="muted" style="font-weight:500;">(within ${alertDays} days)</span></span>
        <div class="toolbar-left">
          <select id="va-sort" class="btn-sm" style="padding:6px 10px;">
            <option value="days">Sort: Soonest expiry</option>
            <option value="client">Sort: Client name</option>
          </select>
        </div>
      </div>
      <div class="table-wrap" id="va-table"></div>
    </div>` : `<div class="callout callout-green mt-14" style="background:var(--green-bg);border:1px solid #cfe6d8;color:var(--green);">✅ No visas expiring within the next ${alertDays} days.</div>`}

    <div class="grid grid-2 mt-14">
      <div class="card">
        <div class="card-title mb-0">Service Mix <span class="muted" style="font-weight:500;font-size:12px;">(all-time entries by service)</span></div>
        <div class="mt-14">${svgPieChart(pieData)}</div>
      </div>
      <div class="card">
        <div class="card-title mb-0">Monthly Collections ${year} <span class="muted" style="font-weight:500;font-size:12px;">(Paid Amount, IDR)</span></div>
        <div class="mt-14">${svgBarChart(monthly)}</div>
      </div>
    </div>
    <div class="card mt-14">
      <div class="card-title mb-0">Cash Flow Trend <span class="muted" style="font-weight:500;font-size:12px;">(net movement, last 6 months, IDR)</span></div>
      <div class="mt-14">${svgLineChart(lineData)}</div>
