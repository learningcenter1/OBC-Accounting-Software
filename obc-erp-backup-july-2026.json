/* ---------------------------------------------------------
   14. FUND TRANSFER (incl. cross-currency, partner settlement)
--------------------------------------------------------- */
ROUTE_RENDERERS['fund-transfer'] = async function(container){
  const transfers = (await dbGetAll('transfers')).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Internal Fund Transfers</h2>
        <button class="btn btn-primary" id="ft-add">+ New Transfer</button>
      </div>
      <p class="muted mt-0">Move money between any two accounts, including cross-currency transfers. Transfers to a Partner account settle (reduce) what the company owes that partner.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>From</th><th>To</th><th class="num">From Amt</th><th class="num">To Amt</th><th>Note</th></tr></thead>
        <tbody>${transfers.length? transfers.map(t=>{
          const fa = STATE.accounts.find(a=>a.id===t.fromAccountId), ta = STATE.accounts.find(a=>a.id===t.toAccountId);
          return `<tr><td>${fmtDate(t.date)}</td><td>${fa?esc(fa.name):'—'}</td><td>${ta?esc(ta.name):'—'}</td>
          <td class="num">${fmtMoney(t.fromAmount,t.fromCurrency)}</td><td class="num">${fmtMoney(t.toAmount,t.toCurrency)}</td><td>${esc(t.description||'')}</td></tr>`;
        }).join('') : `<tr class="empty-row"><td colspan="6">No transfers recorded yet.</td></tr>`}</tbody>
      </table></div>
    </div>`;

  container.querySelector('#ft-add').onclick = ()=>{
    const allAccOpts = accountOptionsHTML('', a=>true) + STATE.accounts.filter(a=>a.type==='partner').map(a=>`<option value="${a.id}">${esc(a.name)}</option>`).join('');
    const body = `
      <div class="form-grid">
        <div class="field"><label>Date *</label><input type="date" id="ft_date" value="${todayISO()}"></div>
        <div class="field span-2"><label>Description</label><input type="text" id="ft_desc" placeholder="e.g. Top-up Cash from Company BCA"></div>
        <div class="field"><label>From Account *</label><select id="ft_from">${accountOptionsHTML('')}</select></div>
        <div class="field"><label>From Amount *</label><input type="number" step="any" id="ft_from_amt"></div>
        <div class="field"><label>To Account *</label><select id="ft_to">${allAccOpts}</select></div>
        <div class="field"><label>To Amount *</label><input type="number" step="any" id="ft_to_amt"></div>
      </div>
      <div class="callout callout-navy" id="ft_hint">Same-currency transfer: To Amount should normally equal From Amount. For cross-currency transfers, enter the converted amount actually received.</div>
      <div class="form-actions"><button class="btn" id="ft-cancel">Cancel</button><button class="btn btn-primary" id="ft-save">Save Transfer</button></div>`;
    const {close} = openModal('New Fund Transfer', body, {wide:true});
    document.getElementById('ft-cancel').onclick = close;
    document.getElementById('ft-save').onclick = async ()=>{
      const fromId = document.getElementById('ft_from').value, toId = document.getElementById('ft_to').value;
      const fromAmt = Number(document.getElementById('ft_from_amt').value)||0;
      const toAmt = Number(document.getElementById('ft_to_amt').value)||0;
      if(!fromId||!toId||!fromAmt||!toAmt){ toast('All amount and account fields are required','error'); return; }
      if(fromId===toId){ toast('From and To accounts must differ','error'); return; }
      const fromAcc = STATE.accounts.find(a=>a.id===fromId), toAcc = STATE.accounts.find(a=>a.id===toId);
      const rec = {id: uid('trf'), date: document.getElementById('ft_date').value||todayISO(),
        fromAccountId:fromId, toAccountId:toId, fromAmount:fromAmt, toAmount:toAmt,
        fromCurrency: fromAcc.currency, toCurrency: toAcc.currency,
        description: document.getElementById('ft_desc').value, createdAt:new Date().toISOString()};
      await dbPut('transfers', rec);
      await postTransaction({date:rec.date, type:'transfer', refType:'transfer', refId:rec.id, accountId:fromId, currency:fromAcc.currency, amount:fromAmt, rate:getRate(fromAcc.currency), direction:'out', description:`Transfer to ${toAcc.name}${rec.description?': '+rec.description:''}`});
      await postTransaction({date:rec.date, type:'transfer', refType:'transfer', refId:rec.id, accountId:toId, currency:toAcc.currency, amount:toAmt, rate:getRate(toAcc.currency), direction: toAcc.type==='partner' ? 'out':'in', description:`Transfer from ${fromAcc.name}${rec.description?': '+rec.description:''}`});
      toast('Transfer recorded','success'); close(); renderRoute();
    };
  };
};

/* ---------------------------------------------------------
   14b. PARTNER DRAWING & DEPOSIT
   Deposit: the partner puts their own money into the business — increases
   the chosen bank/cash balance AND increases what the company owes that
   partner. Drawing: the partner takes money out — decreases the chosen
   bank/cash balance AND reduces what the company owes that partner. Every
   entry here automatically appears in Reports → Partner Ledger.
--------------------------------------------------------- */
ROUTE_RENDERERS['partner-capital'] = async function(container){
  const [rows, partners, accounts] = await Promise.all([dbGetAll('partnerTxns'), dbGetAll('partners'), dbGetAll('accounts')]);
  rows.sort((a,b)=>(b.date||'').localeCompare(a.date||'') || (b.createdAt||'').localeCompare(a.createdAt||''));
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Partner Drawing &amp; Deposit</h2>
        <div class="toolbar-left">
          <button class="btn btn-navy" id="pc-deposit">+ Deposit</button>
          <button class="btn btn-primary" id="pc-drawing">+ Drawing</button>
        </div>
      </div>
      <p class="muted mt-0">A <b>Deposit</b> records a partner putting their own money into the business — it increases the selected bank/cash balance and increases what the company owes that partner. A <b>Drawing</b> records a partner taking money out — it decreases the selected bank/cash balance and reduces what the company owes them. Every entry posts automatically to that partner's <a class="link" id="pc-go-ledger">Partner Ledger</a> in Reports.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Partner</th><th>Type</th><th>Account</th><th class="num">Amount</th><th>Note</th><th></th></tr></thead>
        <tbody>${rows.length? rows.map(rowHtml).join('') : `<tr class="empty-row"><td colspan="7">No partner drawings or deposits recorded yet.</td></tr>`}</tbody>
      </table></div>
    </div>`;

  function rowHtml(r){
    const p = partners.find(x=>x.id===r.partnerId);
    const a = accounts.find(x=>x.id===r.accountId);
    return `<tr>
      <td>${fmtDate(r.date)}</td><td>${p?esc(p.name):'—'}</td>
      <td>${r.kind==='deposit'?'<span class="badge badge-green">Deposit</span>':'<span class="badge badge-red">Drawing</span>'}</td>
      <td>${a?esc(a.name):'—'}</td><td class="num">${fmtMoney(r.amount, r.currency)}</td>
      <td>${esc(r.description||'')}</td>
      <td class="row-actions"><button class="icon-btn pc-del" data-id="${r.id}" title="Delete">&#128465;</button></td>
    </tr>`;
  }

  const goLedgerEl = container.querySelector('#pc-go-ledger');
  if(goLedgerEl) goLedgerEl.onclick = (e)=>{ e.preventDefault(); navigate('reports/partner-ledger'); };
  container.querySelectorAll('.pc-del').forEach(b=>b.onclick=async ()=>{
    const ok = await confirmModal('Delete this entry? This reverses its effect on the bank/cash and partner balances.');
    if(!ok) return;
    await deletePartnerCapitalTxn(b.dataset.id);
    toast('Entry deleted', 'success'); renderRoute();
  });

  function openForm(kind){
    if(partners.length===0){ toast('Add a partner first from Master Data → Partners', 'error'); return; }
    const bankAccOpts = accountOptionsHTML('', a=>a.type==='bank'||a.type==='cash');
    if(!bankAccOpts){ toast('Add a bank or cash account first from Master Data → Banks, Cash & Accounts', 'error'); return; }
    const body = `
      <div class="form-grid">
        <div class="field"><label>Date *</label><input type="date" id="pc_date" value="${todayISO()}"></div>
        <div class="field"><label>Partner *</label><select id="pc_partner">${partnerOptionsHTML('')}</select></div>
        <div class="field span-2"><label>${kind==='deposit'?'Deposit Into (Bank/Cash) *':'Draw From (Bank/Cash) *'}</label><select id="pc_acc">${bankAccOpts}</select></div>
        <div class="field"><label>Currency</label><select id="pc_cur">${currencyOptionsHTML(BASE_CURRENCY)}</select></div>
        <div class="field"><label>Amount *</label><input type="number" step="any" id="pc_amt"></div>
        <div class="field"><label>Rate → USD</label><input type="number" step="any" id="pc_rate" value="1"></div>
        <div class="field span-2"><label>Note</label><input type="text" id="pc_note" placeholder="e.g. Capital injection for Q3 float"></div>
      </div>
      <div class="callout callout-navy">${kind==='deposit' ? 'This increases the selected account\u2019s balance and increases the amount the company owes this partner.' : 'This decreases the selected account\u2019s balance and reduces the amount the company owes this partner.'}</div>
      <div class="form-actions"><button class="btn" id="pc-cancel">Cancel</button><button class="btn btn-primary" id="pc-save">Save ${kind==='deposit'?'Deposit':'Drawing'}</button></div>`;
    const {close} = openModal(kind==='deposit' ? 'New Partner Deposit' : 'New Partner Drawing', body, {wide:true});
    const curSel = document.getElementById('pc_cur'), rateInp = document.getElementById('pc_rate'), accSel = document.getElementById('pc_acc');
    curSel.addEventListener('change', e=>{ rateInp.value = getRate(e.target.value)||1; });
    function syncToAccount(){
      const a = accounts.find(x=>x.id===accSel.value);
      if(a){ curSel.value = a.currency; rateInp.value = getRate(a.currency)||1; }
    }
    accSel.addEventListener('change', syncToAccount);
    syncToAccount();
    document.getElementById('pc-cancel').onclick = close;
    document.getElementById('pc-save').onclick = async ()=>{
      const amount = Number(document.getElementById('pc_amt').value)||0;
      const accountId = accSel.value;
      const partnerId = document.getElementById('pc_partner').value;
      if(!amount || !accountId || !partnerId){ toast('Partner, account and amount are required', 'error'); return; }
      try{
        await postPartnerCapitalTxn({
          date: document.getElementById('pc_date').value||todayISO(),
          partnerId, kind, accountId,
          currency: curSel.value, amount, rate: Number(rateInp.value)||1,
          description: document.getElementById('pc_note').value.trim(),
        });
      }catch(err){ toast(err.message||'Could not save this entry', 'error'); return; }
      toast(`${kind==='deposit'?'Deposit':'Drawing'} recorded`, 'success'); close(); renderRoute();
    };
  }
  container.querySelector('#pc-deposit').onclick = ()=>openForm('deposit');
  container.querySelector('#pc-drawing').onclick = ()=>openForm('drawing');
};

