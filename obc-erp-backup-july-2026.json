      </div>
      <p class="muted mt-0">Use this for quick receipts and payments not tied to one of the 12 service forms — e.g. a general customer receipt, a vendor payment, or a miscellaneous transfer of funds.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Date</th><th>Description</th><th>Party</th><th>Account</th><th class="num">Amount</th><th>Direction</th></tr></thead>
        <tbody>${allTxns.length? allTxns.map(rowHtml).join('') : `<tr class="empty-row"><td colspan="6">No general receipts/payments yet.</td></tr>`}</tbody>
