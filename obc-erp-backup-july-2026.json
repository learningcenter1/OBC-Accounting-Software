/* =========================================================
   22. CHART OF ACCOUNTS
   Stored in 'coa'. Entries may be linked to a real cash/bank/partner
   account (linkedAccountId) so their balance is live; others carry a
   manual opening balance (USD) and, for income/expense heads, optional
   live activity matched from the Expenses screen by category name.
========================================================= */
const COA_CLASSES = [
