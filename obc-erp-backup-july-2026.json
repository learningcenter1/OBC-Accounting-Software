/* =========================================================
   23. BANK RECONCILIATION
   Statement lines live in 'bankLines'. Auto-match pairs each line with an
   unmatched book transaction on the same account: same direction, same
   amount, date within the tolerance window; closest date (then best
   description overlap) wins and each book entry is used once.
========================================================= */
const RECON_UI = { accountId:'', tolerance:3, stmtDate:'', stmtBalance:'' };

function reconNorm(s){ return String(s||'').toLowerCase().replace(/[^a-z0-9 ]/g,' ').split(/\s+/).filter(w=>w.length>2); }
function reconSim(a,b){
  const A = new Set(reconNorm(a)), B = reconNorm(b);
  if(!A.size || !B.length) return 0;
  return B.filter(w=>A.has(w)).length / Math.max(A.size, B.length);
}
const amtEq = (a,b)=> Math.abs((Number(a)||0)-(Number(b)||0)) < 0.005;

async function autoMatchLines(accountId, tolerance, stmtDate){
  const [lines, txns] = await Promise.all([dbGetByIndex('bankLines','accountId',accountId), dbGetByIndex('transactions','accountId',accountId)]);
  const taken = new Set(lines.filter(l=>l.matchedTxnId).map(l=>l.matchedTxnId));
  const open = txns.filter(t=>!taken.has(t.id));
  let n = 0;
  const todo = lines.filter(l=>!l.matchedTxnId).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  for(const l of todo){
    let best=null, bestScore=-1;
    for(const t of open){
      if(taken.has(t.id) || t.direction!==l.direction || !amtEq(t.amount,l.amount)) continue;
      const gap = Math.abs(daysBetween(t.date, l.date));
      if(isNaN(gap) || gap>tolerance) continue;
      const score = (tolerance - gap)*10 + reconSim(l.description, t.description)*5;
      if(score>bestScore){ best=t; bestScore=score; }
    }
    if(best){
      taken.add(best.id);
      l.matchedTxnId = best.id; l.matchType = 'auto'; l.matchedAt = new Date().toISOString();
      await dbPut('bankLines', l); n++;
    }
  }
  return n;
}

function parseCSVText(text){
  const rows = []; let cur = [], f = '', q = false;
  for(let i=0;i<text.length;i++){
    const ch = text[i];
    if(q){ if(ch==='"'){ if(text[i+1]==='"'){ f+='"'; i++; } else q=false; } else f+=ch; }
    else if(ch==='"') q=true;
    else if(ch===','||ch==='\t'||ch===';'){ cur.push(f); f=''; }
    else if(ch==='\n'||ch==='\r'){ if(ch==='\r'&&text[i+1]==='\n') i++; cur.push(f); f=''; if(cur.some(x=>x.trim()!=='')) rows.push(cur); cur=[]; }
    else f+=ch;
  }
  cur.push(f); if(cur.some(x=>x.trim()!=='')) rows.push(cur);
  return rows;
}
function parseStmtDate(s){
  s = String(s||'').trim();
  let m = s.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})/);
  if(m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
  m = s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})/);   // day-first (Indonesia / Pakistan / UK)
  if(m){ const y = m[3].length===2 ? '20'+m[3] : m[3]; return `${y}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`; }
  const d = new Date(s); return isNaN(d) ? null : d.toISOString().slice(0,10);
}
function parseStmtNum(s){
  s = String(s||'').trim(); if(!s) return 0;
  let neg = /^\(.*\)$/.test(s) || /^-/.test(s) || /DR$/i.test(s);
  s = s.replace(/[^\d.,]/g,'');
  if(/,\d{1,2}$/.test(s) && s.includes('.')) s = s.replace(/\./g,'').replace(',','.');  // 1.234,56
  else s = s.replace(/,/g,'');
  const v = parseFloat(s)||0; return neg ? -v : v;
}
/* Accepts: Date, Description, Debit, Credit  |  Date, Description, Amount (negative = money out)
   Header row optional. Debit/Withdrawal = out, Credit/Deposit = in. */
function parseStatement(text){
  const rows = parseCSVText(text);
  if(!rows.length) return [];
  const head = rows[0].map(x=>x.trim().toLowerCase());
  const hasHead = head.some(h=>/date|desc|debit|credit|amount|withdraw|deposit|particular|narr/.test(h)) && !parseStmtDate(rows[0][0]);
  const idx = (re)=>head.findIndex(h=>re.test(h));
  let iDate=0, iDesc=1, iDr=-1, iCr=-1, iAmt=-1, iRef=-1;
  if(hasHead){
    iDate = Math.max(0, idx(/date/));
    iDesc = idx(/desc|particular|narr|detail|remark/); 
    iDr = idx(/debit|withdraw|paid out|money out|\bdr\b/);
    iCr = idx(/credit|deposit|paid in|money in|\bcr\b/);
    iAmt = idx(/^amount|amount$/);
    iRef = idx(/ref|cheque|chq|txn id|transaction id/);
    if(iDesc<0) iDesc = rows[0].findIndex((_,i)=>i!==iDate && i!==iDr && i!==iCr && i!==iAmt);
  } else if(rows[0].length>=4){ iDr=2; iCr=3; } else { iAmt=2; }
  const out = [];
  rows.slice(hasHead?1:0).forEach(r=>{
    const date = parseStmtDate(r[iDate]); if(!date) return;
    let dr=0, cr=0;
    if(iDr>=0||iCr>=0){ dr = Math.abs(parseStmtNum(r[iDr])); cr = Math.abs(parseStmtNum(r[iCr])); }
    else { const a = parseStmtNum(r[iAmt]); if(a<0) dr=-a; else cr=a; }
    if(!dr && !cr) return;
    out.push({date, description:(r[iDesc]||'').trim(), reference: iRef>=0?(r[iRef]||'').trim():'', direction: cr>0?'in':'out', amount: cr>0?cr:dr});
  });
  return out;
}

ROUTE_RENDERERS['bank-recon'] = async function(container){
  await syncCOAWithAccounts();
  const accounts = STATE.accounts.filter(a=>!a.system && (a.type==='bank'||a.type==='cash'));
  if(!accounts.length){ container.innerHTML = '<div class="callout callout-amber">Add a bank account under Master Data → Banks, Cash &amp; Accounts first.</div>'; return; }
  if(!accounts.find(a=>a.id===RECON_UI.accountId)) RECON_UI.accountId = accounts[0].id;
  const acc = accounts.find(a=>a.id===RECON_UI.accountId);
  const [lines, txnsAll, recs, accRow] = await Promise.all([
    dbGetByIndex('bankLines','accountId',acc.id), dbGetByIndex('transactions','accountId',acc.id),
    dbGetByIndex('reconciliations','accountId',acc.id), dbGet('accounts', acc.id)]);
  const stmtDate = RECON_UI.stmtDate || '';
  const txns = txnsAll.filter(t=>!stmtDate || t.date<=stmtDate);
  const matchedIds = new Set(lines.filter(l=>l.matchedTxnId).map(l=>l.matchedTxnId));
  const txnById = Object.fromEntries(txnsAll.map(t=>[t.id,t]));
  const unBook = txns.filter(t=>!matchedIds.has(t.id)).sort((a,b)=>a.date.localeCompare(b.date));
  const unStmt = lines.filter(l=>!l.matchedTxnId && (!stmtDate || l.date<=stmtDate));
  const sum = (arr,dir)=>arr.filter(x=>x.direction===dir).reduce((s,x)=>s+(Number(x.amount)||0),0);
  const bookBal = await getAccountBalance(acc.id, stmtDate||undefined);
  const stmtBal = RECON_UI.stmtBalance===''? null : Number(RECON_UI.stmtBalance);
  const adjBank = stmtBal===null ? null : stmtBal + sum(unBook,'in') - sum(unBook,'out');
  const adjBook = bookBal + sum(unStmt,'in') - sum(unStmt,'out');
  const diff = adjBank===null ? null : adjBank - adjBook;
  const ok = diff!==null && Math.abs(diff)<0.005;
  const M = v=>fmtMoney(v, acc.currency);

  const sortedLines = lines.slice().sort((a,b)=>a.date.localeCompare(b.date) || (a.createdAt||'').localeCompare(b.createdAt||''));
  container.innerHTML = `
    <div class="card">
      <div class="card-header"><div class="card-title">Bank Reconciliation</div>
        <div class="flex gap-8" style="flex-wrap:wrap;">
          <button class="btn" id="br-import">&#11014; Import Statement (CSV)</button>
          <button class="btn" id="br-paste">Paste Statement</button>
          <button class="btn" id="br-add">+ Add Line</button>
          <button class="btn btn-primary" id="br-auto">&#9889; Auto-Reconcile</button>
          <input type="file" id="br-file" accept=".csv,.txt,text/csv,text/plain" style="display:none;">
        </div>
      </div>
      <div class="form-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="field"><label>Bank / Cash Account</label><select id="br-acc">${accounts.map(a=>`<option value="${a.id}" ${a.id===acc.id?'selected':''}>${esc(a.name)} (${a.currency})</option>`).join('')}</select></div>
        <div class="field"><label>Statement Date</label><input type="date" id="br-date" value="${esc(stmtDate)}"></div>
        <div class="field"><label>Statement Ending Balance (${acc.currency})</label><input type="number" step="0.01" id="br-bal" value="${esc(RECON_UI.stmtBalance)}"></div>
        <div class="field"><label>Date Tolerance (± days)</label><input type="number" min="0" max="30" id="br-tol" value="${RECON_UI.tolerance}"></div>
      </div>
    </div>

    <div class="grid grid-4" style="margin:16px 0;">
      <div class="stat-card"><div class="stat-label">Book Balance</div><div class="stat-value" style="font-size:19px;">${M(bookBal)}</div><div class="stat-foot">${stmtDate?'as of '+fmtDate(stmtDate):'all entries'}</div></div>
      <div class="stat-card"><div class="stat-label">Statement Balance</div><div class="stat-value" style="font-size:19px;">${stmtBal===null?'—':M(stmtBal)}</div><div class="stat-foot">adjusted: ${adjBank===null?'—':M(adjBank)}</div></div>
      <div class="stat-card"><div class="stat-label">Matched</div><div class="stat-value" style="font-size:19px;">${lines.filter(l=>l.matchedTxnId).length} / ${lines.length}</div><div class="stat-foot">${unStmt.length} statement · ${unBook.length} book unmatched</div></div>
      <div class="stat-card"><div class="stat-label">Difference</div><div class="stat-value" style="font-size:19px;color:${diff===null?'inherit':ok?'var(--green)':'var(--red)'};">${diff===null?'—':M(diff)}</div><div class="stat-foot">${diff===null?'enter statement balance':ok?'Reconciled ✔':'adjusted bank − adjusted book'}</div></div>
    </div>

    <div class="grid grid-2" style="align-items:start;">
      <div class="card">
        <div class="card-header"><div class="card-title">Bank Statement Lines</div>
          <button class="btn btn-sm btn-danger" id="br-clear">Clear unmatched</button></div>
        <div class="table-wrap" style="max-height:480px;overflow-y:auto;"><table>
          <thead><tr><th>Date</th><th>Description</th><th class="num">In</th><th class="num">Out</th><th>Status</th><th></th></tr></thead>
          <tbody>${sortedLines.map(l=>`<tr>
            <td>${fmtDate(l.date)}</td><td>${esc(l.description)}${l.reference?`<div class="faint" style="font-size:11px;">${esc(l.reference)}</div>`:''}</td>
            <td class="num">${l.direction==='in'?M(l.amount):''}</td><td class="num">${l.direction==='out'?M(l.amount):''}</td>
            <td>${l.matchedTxnId?`<span class="badge badge-green">${l.matchType==='auto'?'Auto':l.matchType==='created'?'Created':'Manual'}</span>`:'<span class="badge badge-amber">Unmatched</span>'}</td>
            <td><div class="row-actions">${l.matchedTxnId
              ? `<button class="btn btn-sm" data-unmatch="${l.id}">Unmatch</button>`
              : `<button class="btn btn-sm" data-match="${l.id}">Match</button><button class="btn btn-sm" data-create="${l.id}">Record</button><button class="btn btn-sm btn-danger" data-del="${l.id}">&times;</button>`}</div></td></tr>`).join('')
            || '<tr class="empty-row"><td colspan="6">No statement lines yet — import a CSV, paste, or add a line.</td></tr>'}</tbody>
        </table></div>
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title">Unreconciled Book Entries <span class="muted">— in the ERP, not on the statement</span></div></div>
        <div class="table-wrap" style="max-height:480px;overflow-y:auto;"><table>
          <thead><tr><th>Date</th><th>Description</th><th class="num">In</th><th class="num">Out</th></tr></thead>
          <tbody>${unBook.map(t=>`<tr><td>${fmtDate(t.date)}</td><td>${esc(t.description||t.type)}</td>
            <td class="num">${t.direction==='in'?M(t.amount):''}</td><td class="num">${t.direction==='out'?M(t.amount):''}</td></tr>`).join('')
            || '<tr class="empty-row"><td colspan="4">Every book entry is matched.</td></tr>'}</tbody>
        </table></div>
      </div>
    </div>

    <div class="card mt-14">
      <div class="card-header"><div class="card-title">Reconciliation Summary</div>
        <button class="btn btn-navy" id="br-final" ${ok?'':'disabled'} title="${ok?'':'Difference must be zero to finalize'}">Finalize &amp; Save Reconciliation</button></div>
      <div class="table-wrap"><table><tbody>
        <tr><td>Statement ending balance</td><td class="num">${stmtBal===null?'—':M(stmtBal)}</td></tr>
        <tr><td>+ Book deposits not yet on statement</td><td class="num">${M(sum(unBook,'in'))}</td></tr>
        <tr><td>− Book payments not yet on statement</td><td class="num">${M(sum(unBook,'out'))}</td></tr>
        <tr><td><b>Adjusted bank balance</b></td><td class="num"><b>${adjBank===null?'—':M(adjBank)}</b></td></tr>
        <tr><td>Book balance</td><td class="num">${M(bookBal)}</td></tr>
        <tr><td>+ Statement credits not in books</td><td class="num">${M(sum(unStmt,'in'))}</td></tr>
        <tr><td>− Statement debits not in books</td><td class="num">${M(sum(unStmt,'out'))}</td></tr>
        <tr><td><b>Adjusted book balance</b></td><td class="num"><b>${M(adjBook)}</b></td></tr>
      </tbody></table></div>
      ${recs.length?`<div class="divider"></div><div class="card-title" style="font-size:13px;">Past reconciliations</div>
        <div class="table-wrap mt-8"><table><thead><tr><th>Statement date</th><th class="num">Statement balance</th><th class="num">Book balance</th><th>Matched lines</th><th>By</th><th>Saved</th></tr></thead><tbody>
        ${recs.sort((a,b)=>b.finalizedAt.localeCompare(a.finalizedAt)).map(r=>`<tr><td>${fmtDate(r.statementDate)}</td><td class="num">${M(r.statementBalance)}</td><td class="num">${M(r.bookBalance)}</td><td>${r.matchedCount}</td><td>${esc(r.by||'')}</td><td>${fmtDate(r.finalizedAt)}</td></tr>`).join('')}
        </tbody></table></div>`:''}
    </div>`;

  const $ = id=>document.getElementById(id);
  const keep = ()=>{ RECON_UI.stmtDate=$('br-date').value; RECON_UI.stmtBalance=$('br-bal').value; RECON_UI.tolerance=Math.max(0,Number($('br-tol').value)||0); };
  $('br-acc').onchange = e=>{ RECON_UI.accountId=e.target.value; RECON_UI.stmtBalance=''; renderRoute(); };
  ['br-date','br-bal','br-tol'].forEach(id=>$(id).onchange=()=>{ keep(); renderRoute(); });

  async function addLines(parsed){
    const existing = new Set(lines.map(l=>[l.date,l.direction,l.amount,l.description].join('|')));
    let added = 0;
    for(const p of parsed){
      const key = [p.date,p.direction,p.amount,p.description].join('|');
      if(existing.has(key)) continue;           // skip lines already imported
      existing.add(key);
      await dbPut('bankLines', Object.assign({id:uid('bl'), accountId:acc.id, matchedTxnId:null, createdAt:new Date().toISOString()}, p));
      added++;
    }
    keep();
    const matched = await autoMatchLines(acc.id, RECON_UI.tolerance, RECON_UI.stmtDate);
    toast(`${added} line(s) imported · ${matched} matched automatically`, 'success');
    renderRoute();
  }
  $('br-import').onclick = ()=>$('br-file').click();
  $('br-file').onchange = e=>{
    const f = e.target.files[0]; if(!f) return;
    const r = new FileReader();
    r.onload = ()=>{ const p = parseStatement(String(r.result)); if(!p.length){ toast('No valid rows found. Expected columns: Date, Description, Debit, Credit (or Amount).','error'); return; } addLines(p); };
    r.readAsText(f);
  };
  $('br-paste').onclick = ()=>{
    const {overlay, close} = openModal('Paste Bank Statement', `
      <p class="muted mt-0">Paste rows copied from Excel or your bank's CSV. Columns: <b>Date, Description, Debit, Credit</b> — or <b>Date, Description, Amount</b> (negative = money out). Header row optional.</p>
      <textarea id="bp-text" style="min-height:200px;font-family:var(--mono);font-size:12px;" placeholder="2026-10-01, Transfer from customer, , 5000000"></textarea>
      <div class="form-actions"><button class="btn" id="bp-cancel">Cancel</button><button class="btn btn-primary" id="bp-go">Import &amp; Auto-Reconcile</button></div>`, {wide:true});
    overlay.querySelector('#bp-cancel').onclick = close;
    overlay.querySelector('#bp-go').onclick = ()=>{ const p = parseStatement(overlay.querySelector('#bp-text').value); if(!p.length){ toast('No valid rows found','error'); return; } close(); addLines(p); };
  };
  $('br-add').onclick = ()=>{
    const {overlay, close} = openModal('Add Statement Line', `
      <div class="form-grid">
        <div class="field"><label>Date</label><input type="date" id="bl_date" value="${todayISO()}"></div>
        <div class="field"><label>Type</label><select id="bl_dir"><option value="in">Deposit / Credit (money in)</option><option value="out">Withdrawal / Debit (money out)</option></select></div>
        <div class="field"><label>Amount (${acc.currency})</label><input type="number" step="0.01" id="bl_amt"></div>
        <div class="field"><label>Reference</label><input id="bl_ref"></div>
        <div class="field span-2"><label>Description</label><input id="bl_desc"></div>
      </div>
      <div class="form-actions"><button class="btn" id="bl-cancel">Cancel</button><button class="btn btn-primary" id="bl-save">Add</button></div>`);
    overlay.querySelector('#bl-cancel').onclick = close;
    overlay.querySelector('#bl-save').onclick = ()=>{
      const amount = Math.abs(Number(overlay.querySelector('#bl_amt').value)||0);
      if(!amount){ toast('Enter an amount','error'); return; }
      close();
      addLines([{date:overlay.querySelector('#bl_date').value||todayISO(), direction:overlay.querySelector('#bl_dir').value, amount, description:overlay.querySelector('#bl_desc').value.trim(), reference:overlay.querySelector('#bl_ref').value.trim()}]);
    };
  };
  $('br-auto').onclick = async ()=>{ keep(); const n = await autoMatchLines(acc.id, RECON_UI.tolerance, RECON_UI.stmtDate); toast(n?`${n} line(s) matched automatically`:'No new matches found — try a wider date tolerance','success'); renderRoute(); };
  $('br-clear').onclick = async ()=>{
    if(!unStmt.length) return;
    if(!await confirmModal(`Delete ${unStmt.length} unmatched statement line(s)?`)) return;
    for(const l of unStmt) await dbDelete('bankLines', l.id);
    renderRoute();
  };
  container.querySelectorAll('[data-unmatch]').forEach(b=>b.onclick=async ()=>{ const l=lines.find(x=>x.id===b.dataset.unmatch); l.matchedTxnId=null; l.matchType=null; await dbPut('bankLines',l); renderRoute(); });
  container.querySelectorAll('[data-del]').forEach(b=>b.onclick=async ()=>{ await dbDelete('bankLines', b.dataset.del); renderRoute(); });
  container.querySelectorAll('[data-match]').forEach(b=>b.onclick=()=>{
    const l = lines.find(x=>x.id===b.dataset.match);
    const cands = txnsAll.filter(t=>!matchedIds.has(t.id) && t.direction===l.direction)
      .sort((a,b2)=>Math.abs(a.amount-l.amount)-Math.abs(b2.amount-l.amount) || Math.abs(daysBetween(a.date,l.date))-Math.abs(daysBetween(b2.date,l.date))).slice(0,40);
    const {overlay, close} = openModal('Match to Book Entry', `
      <p class="muted mt-0">Statement: <b>${fmtDate(l.date)}</b> · ${esc(l.description)} · <b>${M(l.amount)}</b> (${l.direction==='in'?'in':'out'})</p>
      <div class="table-wrap"><table><thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th><th></th></tr></thead><tbody>
      ${cands.map(t=>`<tr><td>${fmtDate(t.date)}</td><td>${esc(t.description||t.type)}</td><td class="num">${M(t.amount)}${amtEq(t.amount,l.amount)?'':' <span class="badge badge-amber">differs</span>'}</td><td><button class="btn btn-sm btn-primary" data-pick="${t.id}">Match</button></td></tr>`).join('') || '<tr class="empty-row"><td colspan="4">No open book entries in this direction.</td></tr>'}
      </tbody></table></div>`, {wide:true});
    overlay.querySelectorAll('[data-pick]').forEach(p=>p.onclick=async ()=>{
      l.matchedTxnId = p.dataset.pick; l.matchType='manual'; await dbPut('bankLines', l); close(); renderRoute();
    });
  });
  container.querySelectorAll('[data-create]').forEach(b=>b.onclick=()=>{
    const l = lines.find(x=>x.id===b.dataset.create);
    const cats = ['Bank Charges','Interest','General','Office','Rent','Salaries','Travel','Utilities','Other'];
    const {overlay, close} = openModal('Record Missing Book Entry', `
      <p class="muted mt-0">Creates the entry in your books for this statement line and matches it.</p>
      <div class="form-grid">
        <div class="field"><label>Description</label><input id="rc_desc" value="${esc(l.description)}"></div>
        <div class="field"><label>${l.direction==='out'?'Expense Category':'Receipt Type'}</label>
          ${l.direction==='out'?`<select id="rc_cat">${cats.map(c=>`<option>${c}</option>`).join('')}</select>`:`<input id="rc_cat" value="Bank Interest / Other Receipt">`}</div>
      </div>
      <div class="callout callout-amber mt-14">${l.direction==='out'?'Posts an expense':'Posts a general receipt'} of ${M(l.amount)} on ${fmtDate(l.date)} to ${esc(acc.name)}.</div>
      <div class="form-actions"><button class="btn" id="rc-cancel">Cancel</button><button class="btn btn-primary" id="rc-save">Record &amp; Match</button></div>`);
    overlay.querySelector('#rc-cancel').onclick = close;
    overlay.querySelector('#rc-save').onclick = async ()=>{
      const desc = overlay.querySelector('#rc_desc').value.trim() || 'Bank statement entry';
      const cat = overlay.querySelector('#rc_cat').value;
      let t;
      if(l.direction==='out'){
        const rec = {id:uid('exp'), date:l.date, category:cat, description:desc, currency:acc.currency, amount:l.amount, paidBy:'company', accountId:acc.id, createdAt:new Date().toISOString()};
        await dbPut('expenses', rec);
        t = await postTransaction({date:l.date, type:'expense', refType:'expense', refId:rec.id, accountId:acc.id, currency:acc.currency, amount:l.amount, rate:getRate(acc.currency), direction:'out', description:`Expense: ${desc}`});
      } else {
        t = await postTransaction({date:l.date, type:'general', accountId:acc.id, currency:acc.currency, amount:l.amount, rate:getRate(acc.currency), direction:'in', description:`${cat}: ${desc}`});
      }
      l.matchedTxnId = t.id; l.matchType='created'; await dbPut('bankLines', l);
      toast('Entry recorded and matched','success'); close(); renderRoute();
    };
  });
  $('br-final').onclick = async ()=>{
    if(!ok) return;
    await dbPut('reconciliations', {id:uid('rec'), accountId:acc.id, statementDate:stmtDate||todayISO(), statementBalance:stmtBal, bookBalance:bookBal, matchedCount:lines.filter(l=>l.matchedTxnId).length, by:(STATE.currentUser&&STATE.currentUser.name)||'', finalizedAt:new Date().toISOString()});
    toast('Reconciliation saved','success'); renderRoute();
  };
};

/* =========================================================
   24. LOGINS (users, roles, login screen)
========================================================= */
async function hashPassword(username, password){
  const s = 'obc|' + String(username).toLowerCase() + '|' + password;
  try{
    if(window.crypto && crypto.subtle){
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
      return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
    }
  }catch(e){}
  let h = 5381; for(let i=0;i<s.length;i++) h = ((h<<5)+h) ^ s.charCodeAt(i);
  return 'x' + (h>>>0).toString(16);
}
async function ensureUsers(){
  const users = await dbGetAll('users');
  if(users.length) return;
  await dbPutRaw('users', {id:uid('usr'), username:'admin', name:'Main Admin', role:'admin', active:true, isDefault:true, passHash: await hashPassword('admin','admin123'), createdAt:todayISO()});
  await dbPutRaw('users', {id:uid('usr'), username:'user', name:'Staff User', role:'user', active:true, isDefault:true, passHash: await hashPassword('user','user123'), createdAt:todayISO()});
}
function isAdmin(){ return !!(STATE.currentUser && STATE.currentUser.role==='admin'); }
function sessionGet(){ try{ return sessionStorage.getItem('obc_session_user'); }catch(e){ return null; } }
function sessionSet(v){ try{ v ? sessionStorage.setItem('obc_session_user', v) : sessionStorage.removeItem('obc_session_user'); }catch(e){} }

function renderLoginScreen(onLogin){
  dbGetAll('users').then(users=>{
    const defaults = users.filter(u=>u.isDefault && u.active!==false);
    const app = document.getElementById('app');
    app.innerHTML = `
      <div class="boot-screen"><div class="boot-card" style="max-width:360px;">
        ${logoMarkSVG(56)}
        <h2 class="mt-14" style="font-size:18px;">OBC Indonesia ERP</h2>
        <p class="muted" style="font-size:12.5px;">Sign in to continue</p>
        <div class="field" style="text-align:left;"><label>Username</label><input id="lg-user" autocomplete="username" autofocus></div>
        <div class="field mt-8" style="text-align:left;"><label>Password</label><input id="lg-pass" type="password" autocomplete="current-password"></div>
        <div id="lg-err" class="callout callout-red mt-14" style="display:none;">Incorrect username or password.</div>
        <button class="btn btn-primary w-full mt-14" id="lg-go">Sign In</button>
        ${defaults.length?`<p class="faint mt-14" style="font-size:11.5px;">First-time logins: ${defaults.map(u=>`<b>${esc(u.username)}</b> / ${u.username==='admin'?'admin123':u.username==='user'?'user123':'…'}`).join(' &nbsp;·&nbsp; ')}<br>Change these in Settings after signing in.</p>`:''}
      </div></div>`;
    const go = async ()=>{
      const name = document.getElementById('lg-user').value.trim().toLowerCase();
      const pass = document.getElementById('lg-pass').value;
      const u = users.find(x=>x.username.toLowerCase()===name && x.active!==false);
      if(u && u.passHash === await hashPassword(u.username, pass)){ STATE.currentUser = u; sessionSet(u.id); onLogin(); }
      else { document.getElementById('lg-err').style.display='flex'; document.getElementById('lg-pass').value=''; }
    };
    document.getElementById('lg-go').onclick = go;
    ['lg-user','lg-pass'].forEach(id=>document.getElementById(id).addEventListener('keydown',e=>{ if(e.key==='Enter') go(); }));
    document.getElementById('lg-user').focus();
  });
}
function logout(){ sessionSet(null); STATE.currentUser = null; window.location.hash=''; window.location.reload(); }

/* Settings → Users & Logins (admin) and My Password (everyone) */
async function renderUsersTab(body){
  const users = (await dbGetAll('users')).sort((a,b)=>a.username.localeCompare(b.username));
  body.innerHTML = `
    <div class="card">
      <div class="card-header"><div class="card-title">Users &amp; Logins <span class="muted">— ${users.length} users</span></div>
        <button class="btn btn-primary" id="us-add">+ Add Login</button></div>
      <div class="table-wrap"><table>
        <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Status</th><th></th></tr></thead>
        <tbody>${users.map(u=>`<tr><td>${esc(u.name)}</td><td style="font-family:var(--mono);">${esc(u.username)}</td>
          <td><span class="badge ${u.role==='admin'?'badge-navy':'badge-gray'}">${u.role==='admin'?'Admin':'Staff'}</span></td>
          <td>${u.active!==false?'<span class="badge badge-green">Active</span>':'<span class="badge badge-red">Disabled</span>'}</td>
          <td><div class="row-actions"><button class="btn btn-sm" data-pw="${u.id}">Reset Password</button>
            <button class="btn btn-sm" data-role="${u.id}">${u.role==='admin'?'Make Staff':'Make Admin'}</button>
            <button class="btn btn-sm" data-act="${u.id}">${u.active!==false?'Disable':'Enable'}</button>
            <button class="btn btn-sm btn-danger" data-del="${u.id}">Delete</button></div></td></tr>`).join('')}</tbody>
      </table></div>
      <p class="muted" style="font-size:12px;margin-bottom:0;">Admins can add logins, reset passwords and see Settings danger-zone tools. Staff can use every accounting screen but cannot manage users, restore backups or erase data. Turn on Automatic Saving so added logins are kept inside this file.</p>
    </div>`;
  const activeAdmins = ()=>users.filter(u=>u.role==='admin' && u.active!==false);
  const guard = (u)=>{ if(u.role==='admin' && u.active!==false && activeAdmins().length<=1){ toast('At least one active admin is required','error'); return false; } return true; };
  document.getElementById('us-add').onclick = ()=>{
    const {overlay, close} = openModal('Add Login', `
      <div class="form-grid">
        <div class="field"><label>Full Name</label><input id="nu_name"></div>
        <div class="field"><label>Username</label><input id="nu_user" autocomplete="off"></div>
        <div class="field"><label>Password (min 6 chars)</label><input id="nu_pass" type="text" autocomplete="off"></div>
        <div class="field"><label>Role</label><select id="nu_role"><option value="user">Staff</option><option value="admin">Admin</option></select></div>
      </div>
      <div class="form-actions"><button class="btn" id="nu-cancel">Cancel</button><button class="btn btn-primary" id="nu-save">Create Login</button></div>`);
    overlay.querySelector('#nu-cancel').onclick = close;
    overlay.querySelector('#nu-save').onclick = async ()=>{
      const name = overlay.querySelector('#nu_name').value.trim(), username = overlay.querySelector('#nu_user').value.trim(), pass = overlay.querySelector('#nu_pass').value;
      if(!name || !/^[A-Za-z0-9._-]{3,}$/.test(username)){ toast('Enter a name and a username (3+ letters/digits)','error'); return; }
      if(pass.length<6){ toast('Password must be at least 6 characters','error'); return; }
      if(users.some(u=>u.username.toLowerCase()===username.toLowerCase())){ toast('Username already exists','error'); return; }
      await dbPut('users', {id:uid('usr'), username, name, role:overlay.querySelector('#nu_role').value, active:true, passHash: await hashPassword(username, pass), createdAt:todayISO()});
      toast('Login created','success'); close(); renderUsersTab(body);
    };
  };
  body.querySelectorAll('[data-pw]').forEach(b=>b.onclick=()=>{
    const u = users.find(x=>x.id===b.dataset.pw);
    const {overlay, close} = openModal('Reset Password — '+u.username, `
      <div class="field"><label>New Password (min 6 chars)</label><input id="rp_new" type="text" autocomplete="off"></div>
      <div class="form-actions"><button class="btn" id="rp-cancel">Cancel</button><button class="btn btn-primary" id="rp-save">Save</button></div>`);
    overlay.querySelector('#rp-cancel').onclick = close;
    overlay.querySelector('#rp-save').onclick = async ()=>{
      const p = overlay.querySelector('#rp_new').value;
      if(p.length<6){ toast('Password must be at least 6 characters','error'); return; }
      u.passHash = await hashPassword(u.username, p); u.isDefault = false; await dbPut('users', u);
      toast('Password updated','success'); close();
    };
  });
  body.querySelectorAll('[data-role]').forEach(b=>b.onclick=async ()=>{
    const u = users.find(x=>x.id===b.dataset.role);
    if(u.role==='admin' && !guard(u)) return;
    u.role = u.role==='admin'?'user':'admin'; await dbPut('users', u); renderUsersTab(body);
  });
  body.querySelectorAll('[data-act]').forEach(b=>b.onclick=async ()=>{
    const u = users.find(x=>x.id===b.dataset.act);
    if(u.active!==false && !guard(u)) return;
    if(u.id===STATE.currentUser.id && u.active!==false){ toast('You cannot disable your own login','error'); return; }
    u.active = u.active===false; await dbPut('users', u); renderUsersTab(body);
  });
  body.querySelectorAll('[data-del]').forEach(b=>b.onclick=async ()=>{
    const u = users.find(x=>x.id===b.dataset.del);
    if(u.id===STATE.currentUser.id){ toast('You cannot delete your own login','error'); return; }
    if(!guard(u)) return;
    if(!await confirmModal(`Delete login "${u.username}"?`)) return;
    await dbDelete('users', u.id); renderUsersTab(body);
  });
}
function renderMyPasswordTab(body){
  body.innerHTML = `
    <div class="card"><div class="card-title">Change My Password <span class="muted">— signed in as ${esc(STATE.currentUser.username)}</span></div>
      <div class="form-grid mt-14">
        <div class="field"><label>Current Password</label><input type="password" id="mp_old" autocomplete="current-password"></div>
        <div class="field"></div>
        <div class="field"><label>New Password (min 6)</label><input type="password" id="mp_new" autocomplete="new-password"></div>
        <div class="field"><label>Confirm New Password</label><input type="password" id="mp_new2" autocomplete="new-password"></div>
      </div>
      <div class="form-actions"><button class="btn btn-primary" id="mp-save">Update Password</button></div></div>`;
  document.getElementById('mp-save').onclick = async ()=>{
    const u = await dbGet('users', STATE.currentUser.id);
    const n1 = document.getElementById('mp_new').value;
    if(u.passHash !== await hashPassword(u.username, document.getElementById('mp_old').value)){ toast('Current password is wrong','error'); return; }
    if(n1.length<6 || n1!==document.getElementById('mp_new2').value){ toast('New passwords must match and be 6+ characters','error'); return; }
    u.passHash = await hashPassword(u.username, n1); u.isDefault = false; await dbPut('users', u);
    STATE.currentUser = u; toast('Password updated','success');
    ['mp_old','mp_new','mp_new2'].forEach(i=>document.getElementById(i).value='');
  };
}

