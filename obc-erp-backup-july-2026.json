/* ---------------------------------------------------------
   19. SVG CHART HELPERS (no external chart library — fully offline)
--------------------------------------------------------- */
const CHART_COLORS = ['#E07A2C','#152A4E','#2E7A4F','#B9790A','#C13E2E','#6E5138','#8B5FBF','#2C8FA0','#D4986B','#4A3524'];

/* Shared period-range helper used by every report/ledger screen that offers
   Daily / Weekly / Monthly / Yearly quick filters alongside a custom range. */
function periodPillsHTML(id, active){
  active = active || 'all';
  const opts = [['all','All Time'],['daily','Daily (Today)'],['weekly','Weekly (This Week)'],['monthly','Monthly (This Month)'],['yearly','Yearly (This Year)']];
  return `<div class="pill-tabs" id="${id}">${opts.map(([k,l])=>`<button class="pill ${k===active?'active':''}" data-p="${k}">${l}</button>`).join('')}</div>`;
}
function computePeriodRange(period){
  const now = new Date(); const y=now.getFullYear(), m=now.getMonth(), d=now.getDate();
  if(period==='daily') return [todayISO(), todayISO()];
  if(period==='weekly'){ const start = new Date(now); start.setDate(d-now.getDay()); return [localISO(start), todayISO()]; }
  if(period==='monthly') return [localISO(new Date(y,m,1)), todayISO()];
  if(period==='yearly') return [localISO(new Date(y,0,1)), todayISO()];
  return [null,null];
}
/* Wires up a periodPillsHTML() block + optional from/to date inputs so that
   clicking a pill or editing a date re-runs `onChange(fromISO, toISO)`. */
function wirePeriodControls(container, pillsId, fromId, toId, onChange){
  let period = 'all';
  function fire(){
    const [pf,pt] = computePeriodRange(period);
    const from = (fromId && document.getElementById(fromId).value) || pf;
    const to = (toId && document.getElementById(toId).value) || pt;
    onChange(from, to);
  }
  container.querySelectorAll(`#${pillsId} .pill`).forEach(p=>p.onclick=()=>{
    container.querySelectorAll(`#${pillsId} .pill`).forEach(x=>x.classList.remove('active'));
    p.classList.add('active'); period=p.dataset.p;
    if(fromId) document.getElementById(fromId).value='';
    if(toId) document.getElementById(toId).value='';
    fire();
  });
  if(fromId) document.getElementById(fromId).addEventListener('change', fire);
  if(toId) document.getElementById(toId).addEventListener('change', fire);
  fire();
}


function svgPieChart(data, opts){
  // data: [{label, value}]
  opts = opts||{}; const size = opts.size||220; const r = size/2 - 6; const cx=size/2, cy=size/2;
  const total = data.reduce((s,d)=>s+d.value,0);
  if(total<=0) return `<div class="muted" style="padding:30px;text-align:center;">No data yet</div>`;
  let angle = -Math.PI/2;
  const paths = data.map((d,i)=>{
    const frac = d.value/total;
    const a0 = angle, a1 = angle + frac*Math.PI*2;
    angle = a1;
    const x0 = cx + r*Math.cos(a0), y0 = cy + r*Math.sin(a0);
    const x1 = cx + r*Math.cos(a1), y1 = cy + r*Math.sin(a1);
    const largeArc = (a1-a0) > Math.PI ? 1 : 0;
    const col = CHART_COLORS[i % CHART_COLORS.length];
    if(frac>=0.9999) return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${col}"/>`;
    return `<path d="M${cx},${cy} L${x0.toFixed(2)},${y0.toFixed(2)} A${r},${r} 0 ${largeArc} 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z" fill="${col}" stroke="#fff" stroke-width="1.5"/>`;
  }).join('');
  const legend = data.map((d,i)=>`<div class="legend-item"><span class="legend-dot" style="background:${CHART_COLORS[i%CHART_COLORS.length]}"></span>${esc(d.label)} <span class="faint">(${(Math.round(d.value*100)/100).toLocaleString('en-US')})</span></div>`).join('');
  return `<div class="flex" style="gap:20px;flex-wrap:wrap;align-items:center;">
    <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">${paths}</svg>
    <div class="chart-legend" style="flex-direction:column;margin-top:0;">${legend}</div>
  </div>`;
}

function svgBarChart(data, opts){
  // data: [{label, value}]
  opts = opts||{}; const w = opts.width||560, h = opts.height||220, pad=36;
  const max = Math.max(1, ...data.map(d=>d.value));
  const bw = (w - pad*2) / data.length;
  const bars = data.map((d,i)=>{
    const bh = Math.max(2, (d.value/max) * (h - pad*2));
    const x = pad + i*bw + bw*0.15;
    const y = h - pad - bh;
    const col = CHART_COLORS[i % CHART_COLORS.length];
    return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${(bw*0.7).toFixed(1)}" height="${bh.toFixed(1)}" fill="${col}" rx="3"/>
      <text x="${(x+bw*0.35).toFixed(1)}" y="${h-pad+16}" font-size="10" fill="#7C6B54" text-anchor="middle">${esc(d.label)}</text>`;
  }).join('');
  return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid meet">
    <line x1="${pad}" y1="${h-pad}" x2="${w-pad/2}" y2="${h-pad}" stroke="#E6DAC6"/>
    ${bars}
  </svg>`;
}

function svgLineChart(data, opts){
  // data: [{label, value}]
  opts = opts||{}; const w = opts.width||560, h = opts.height||200, pad=36;
  if(data.length===0) return `<div class="muted" style="padding:30px;text-align:center;">No data yet</div>`;
  const max = Math.max(1, ...data.map(d=>d.value));
  const min = Math.min(0, ...data.map(d=>d.value));
  const range = (max-min)||1;
  const stepX = (w - pad*2) / Math.max(1,(data.length-1));
  const pts = data.map((d,i)=>{
    const x = pad + i*stepX;
    const y = h - pad - ((d.value-min)/range)*(h-pad*2);
    return [x,y];
  });
  const path = pts.map((p,i)=> (i===0?'M':'L')+p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
  const area = path + ` L${pts[pts.length-1][0].toFixed(1)},${h-pad} L${pts[0][0].toFixed(1)},${h-pad} Z`;
  const dots = pts.map((p,i)=>`<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="3" fill="#E07A2C"/>`).join('');
  const labels = data.map((d,i)=>`<text x="${pts[i][0].toFixed(1)}" y="${h-pad+16}" font-size="10" fill="#7C6B54" text-anchor="middle">${esc(d.label)}</text>`).join('');
  return `<svg width="100%" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid meet">
    <line x1="${pad}" y1="${h-pad}" x2="${w-pad/2}" y2="${h-pad}" stroke="#E6DAC6"/>
    <path d="${area}" fill="rgba(224,122,44,0.12)" stroke="none"/>
    <path d="${path}" fill="none" stroke="#E07A2C" stroke-width="2.2"/>
    ${dots}${labels}
  </svg>`;
}

