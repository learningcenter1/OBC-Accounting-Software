function receiptPaymentFieldsHTML(entry, legend){
  entry = entry || {};
  const rp = entry.receipt || {direction:'receipt', amount:'', currency:BASE_CURRENCY, accountId:'', rate:1, paymentMethod:'Cash'};
  return `
  <fieldset>
    <legend>${esc(legend||'Receipt & Payment')}</legend>
    <div class="form-grid">
      <div class="field">
        <label>Direction</label>
        <select id="rp_direction">
          <option value="receipt" ${rp.direction==='receipt'?'selected':''}>Receipt (money IN from client)</option>
          <option value="payment" ${rp.direction==='payment'?'selected':''}>Payment (money OUT / refund)</option>
          <option value="none" ${rp.direction==='none'?'selected':''}>No payment this entry</option>
        </select>
      </div>
      <div class="field">
        <label>Account Used</label>
        <select id="rp_account">${accountOptionsHTML(rp.accountId)}</select>
      </div>
      <div class="field">
        <label>Currency</label>
        <select id="rp_currency">${currencyOptionsHTML(rp.currency)}</select>
      </div>
      <div class="field">
        <label>Amount</label>
        <input type="number" step="any" id="rp_amount" value="${esc(rp.amount)}">
      </div>
      <div class="field">
        <label>Exchange Rate (→ USD)</label>
        <input type="number" step="any" id="rp_rate" value="${esc(rp.rate||getRate(rp.currency)||1)}">
        <span class="hint">Auto-filled from Currencies master; editable per transaction.</span>
      </div>
      <div class="field">
        <label>Payment Method</label>
        <select id="rp_paymethod">${PAYMENT_METHODS.map(m=>`<option value="${m}" ${m===(rp.paymentMethod||'Cash')?'selected':''}>${m}</option>`).join('')}</select>
      </div>
      <div class="field">
        <label>USD Equivalent</label>
        <input type="text" id="rp_idr_preview" value="${fmtMoney((rp.amount||0)*(rp.rate||getRate(rp.currency)||1),'USD')}" disabled>
      </div>
    </div>
  </fieldset>`;
}
function wireReceiptPaymentPreview(){
  const cur = document.getElementById('rp_currency');
  const rate = document.getElementById('rp_rate');
  const amt = document.getElementById('rp_amount');
  const prev = document.getElementById('rp_idr_preview');
  function sync(){ prev.value = fmtMoney((Number(amt.value)||0)*(Number(rate.value)||0), 'USD'); }
  cur.addEventListener('change', ()=>{ rate.value = getRate(cur.value)||1; sync(); });
  rate.addEventListener('input', sync);
  amt.addEventListener('input', sync);
}
function readReceiptPayment(){
  return {
    direction: document.getElementById('rp_direction').value,
    accountId: document.getElementById('rp_account').value,
    currency: document.getElementById('rp_currency').value,
    amount: Number(document.getElementById('rp_amount').value)||0,
    rate: Number(document.getElementById('rp_rate').value)||0,
    paymentMethod: document.getElementById('rp_paymethod').value,
  };
}

/* ---- Shared "Financial & Payment" block used by the 10 standard services ----
   Mirrors the client's own spreadsheet columns: Total Amount, Paid Amount,
   Balance, Payment Method, plus the account/currency/rate needed to post the
   Paid Amount into the real ledgers. Total Amount (less what's been paid)
   flows into the customer's outstanding balance automatically. */
function financeFieldsHTML(finance){
  const f = finance || {totalAmount:'', paidAmount:'', currency:BASE_CURRENCY, accountId:'', rate:1, paymentMethod:'Cash'};
  const balance = (Number(f.totalAmount)||0) - (Number(f.paidAmount)||0);
  return `
  <fieldset>
    <legend>Financial &amp; Payment</legend>
    <div class="form-grid">
      <div class="field">
        <label>Total Amount</label>
        <input type="number" step="any" id="fin_total" value="${esc(f.totalAmount)}">
      </div>
      <div class="field">
        <label>Currency</label>
        <select id="fin_currency">${currencyOptionsHTML(f.currency)}</select>
      </div>
      <div class="field">
        <label>Paid Amount</label>
        <input type="number" step="any" id="fin_paid" value="${esc(f.paidAmount)}">
        <span class="hint">Posted to the account below as a receipt from this client.</span>
      </div>
      <div class="field">
        <label>Balance</label>
        <input type="text" id="fin_balance" value="${fmtMoney(balance, f.currency)}" disabled>
      </div>
      <div class="field">
        <label>Account Used (for Paid Amount)</label>
        <select id="fin_account">${accountOptionsHTML(f.accountId)}</select>
      </div>
      <div class="field">
        <label>Exchange Rate (→ USD)</label>
        <input type="number" step="any" id="fin_rate" value="${esc(f.rate||getRate(f.currency)||1)}">
      </div>
      <div class="field">
        <label>Payment Method</label>
        <select id="fin_paymethod">${PAYMENT_METHODS.map(m=>`<option value="${m}" ${m===(f.paymentMethod||'Cash')?'selected':''}>${m}</option>`).join('')}</select>
      </div>
      <div class="field">
        <label>USD Equivalent (Paid)</label>
        <input type="text" id="fin_idr_preview" value="${fmtMoney((f.paidAmount||0)*(f.rate||getRate(f.currency)||1),'USD')}" disabled>
      </div>
    </div>
  </fieldset>`;
}
function wireFinancePreview(){
  const cur = document.getElementById('fin_currency');
  const rate = document.getElementById('fin_rate');
  const total = document.getElementById('fin_total');
  const paid = document.getElementById('fin_paid');
  const bal = document.getElementById('fin_balance');
  const idrPrev = document.getElementById('fin_idr_preview');
  function sync(){
    bal.value = fmtMoney((Number(total.value)||0)-(Number(paid.value)||0), cur.value);
    idrPrev.value = fmtMoney((Number(paid.value)||0)*(Number(rate.value)||0), 'USD');
  }
  cur.addEventListener('change', ()=>{ rate.value = getRate(cur.value)||1; sync(); });
  rate.addEventListener('input', sync);
  total.addEventListener('input', sync);
  paid.addEventListener('input', sync);
}
function readFinance(){
  return {
    totalAmount: Number(document.getElementById('fin_total').value)||0,
    currency: document.getElementById('fin_currency').value,
    paidAmount: Number(document.getElementById('fin_paid').value)||0,
    accountId: document.getElementById('fin_account').value,
    rate: Number(document.getElementById('fin_rate').value)||0,
    paymentMethod: document.getElementById('fin_paymethod').value,
  };
}

async function syncServiceEntryTransaction(entry, cfg){
  await deleteTransactionsByRef(entry.id);
  const rp = entry.receipt;
  if(rp && rp.direction!=='none' && rp.amount>0 && rp.accountId){
    const customer = STATE.customers.find(c=>c.id===entry.customerId);
    await postTransaction({
      date: entry.date, type:'service', serviceType: cfg.key, refType:'serviceEntry', refId: entry.id,
      accountId: rp.accountId, currency: rp.currency, amount: rp.amount, rate: rp.rate,
      direction: rp.direction==='receipt' ? 'in' : 'out',
      partyType:'customer', partyId: entry.customerId,
      description: `${cfg.label} ${entry.refNo}${customer?(' — '+customer.name):''}`,
    });
  }
}

/* Posting for the 10 standard (financeMode:'common') services: only the
   Paid Amount is a real cash movement (posted to the chosen account as a
   receipt from the client). Total Amount is not a cash movement — it is
   picked up directly from serviceEntries by getPartyLedger() as a debit,
   so the customer's outstanding balance reflects Total − Paid automatically. */
async function syncServiceEntryFinance(entry, cfg){
  await deleteTransactionsByRef(entry.id);
  const fin = entry.finance;
  if(fin && fin.paidAmount>0 && fin.accountId){
    const customer = STATE.customers.find(c=>c.id===entry.customerId);
    await postTransaction({
      date: entry.date, type:'service', serviceType: cfg.key, refType:'serviceEntry', refId: entry.id,
      accountId: fin.accountId, currency: fin.currency, amount: fin.paidAmount, rate: fin.rate,
      direction: 'in', partyType:'customer', partyId: entry.customerId,
      description: `${cfg.label} ${entry.refNo}${customer?(' — '+customer.name):''} (Paid Amount)`,
    });
  }
}

function serviceEntryRoute(container, key){
  const cfg = getServiceCfg(key);
  if(!cfg){ container.innerHTML = `<div class="callout callout-red">Unknown service.</div>`; return; }
  return renderServiceEntries(container, cfg);
}
ROUTE_RENDERERS['service'] = serviceEntryRoute;

/* ---------------------------------------------------------
   11b. DATA ENTRY HUB — single sidebar entry point that fans out
   to all 12 service forms (plus Money Exchange) as clickable tiles.
--------------------------------------------------------- */
ROUTE_RENDERERS['data-entry'] = async function(container){
  const allEntries = await dbGetAll('serviceEntries');
  const tiles = SERVICE_CONFIG.map(s=>({
    key:s.key, label:s.label, icon:s.icon, count: allEntries.filter(e=>e.type===s.key).length, route:'service/'+s.key,
  }));
  tiles.push({key:'money_exchange', label:'Money Exchange', icon:'💰', count: allEntries.filter(e=>e.type==='money_exchange').length, route:'money-exchange'});

  container.innerHTML = `
    <div class="card">
      <div class="card-header">
        <span class="card-title">Data Entry <span class="muted" style="font-weight:500;font-size:12px;">— choose a service to open its entry form</span></span>
        <input class="search-input" id="de-search" placeholder="Search services...">
      </div>
      <div class="grid grid-4" id="de-grid" style="margin-top:6px;"></div>
    </div>`;

  function tileHTML(t){
    return `<div class="stat-card de-tile" data-route="${t.route}" style="--accent:var(--orange);cursor:pointer;">
      <div style="font-size:26px;line-height:1;">${t.icon}</div>
      <div class="stat-value" style="font-size:15px;margin-top:10px;">${esc(t.label)}</div>
      <div class="stat-foot">${t.count} ${t.count===1?'entry':'entries'} on file</div>
    </div>`;
  }
  function refresh(filter){
    const ft = (filter||'').toLowerCase();
    const list = ft ? tiles.filter(t=>t.label.toLowerCase().includes(ft)) : tiles;
    const grid = document.getElementById('de-grid');
    grid.innerHTML = list.length ? list.map(tileHTML).join('') : `<div class="muted" style="padding:20px;">No services match "${esc(filter)}".</div>`;
    grid.querySelectorAll('.de-tile').forEach(el=>el.onclick=()=>navigate(el.dataset.route));
  }
  document.getElementById('de-search').addEventListener('input', e=>refresh(e.target.value));
  refresh('');
};

async function renderServiceEntries(container, cfg){
  const isLoan = cfg.financeMode==='loan';
  const entries = (await dbGetByIndex('serviceEntries','type', cfg.key)).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  container.innerHTML = `
    <div class="breadcrumb"><a id="de-back">&larr; Data Entry</a> / ${esc(cfg.label)}</div>
    <div class="card">
      <div class="toolbar">
        <div class="toolbar-left">
          <h2 class="card-title" style="font-size:16px;">${cfg.icon} ${esc(cfg.label)} <span class="muted" style="font-weight:500;font-size:12px;">(${entries.length} entries)</span></h2>
          <input class="search-input" id="se-search" placeholder="Search by client, ref no...">
        </div>
        <button class="btn btn-primary" id="se-add">+ New ${esc(cfg.label)} Entry</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Ref No.</th><th>Date</th><th>${cfg.optionalCustomer?'Client / Employee':'Client'}</th>
            ${cfg.trackExpiry?'<th>Expiry</th>':''}
            ${isLoan? '<th class="num">Amount</th><th>Status</th>' : '<th class="num">Total</th><th class="num">Paid</th><th class="num">Balance</th>'}
            <th></th>
          </tr></thead>
          <tbody id="se-tbody"></tbody>
        </table>
      </div>
    </div>`;
  const backLink = container.querySelector('#de-back');
  if(backLink) backLink.onclick = ()=>navigate('data-entry');

  function rowsHTML(filter){
    let rows = entries;
    if(filter){ const ft=filter.toLowerCase(); rows = rows.filter(e=>{
      const cust = STATE.customers.find(c=>c.id===e.customerId);
      return (e.refNo||'').toLowerCase().includes(ft) || (cust&&cust.name.toLowerCase().includes(ft));
    });}
    const colCount = 4 + (cfg.trackExpiry?1:0) + (isLoan?2:3);
    if(rows.length===0) return `<tr class="empty-row"><td colspan="${colCount}">No entries yet.</td></tr>`;
    return rows.map(e=>{
      const cust = STATE.customers.find(c=>c.id===e.customerId);
      const emp = cfg.optionalCustomer && e.data && e.data.employeeId ? STATE.employees.find(x=>x.id===e.data.employeeId) : null;
      const whoLabel = cust ? esc(cust.name) : (emp ? esc(emp.name)+' <span class="faint">(employee)</span>' : '<span class="faint">—</span>');
      let expCell = '';
      if(cfg.trackExpiry){
        const exp = e.data && e.data.expiryDate;
        if(exp){
          const days = daysBetween(todayISO(), exp);
          const alertDays = Number(STATE.settings.visaAlertDays)||90;
          let cls = 'badge-green', txt = fmtDate(exp);
          if(days<0){ cls='badge-red'; txt = `Expired ${fmtDate(exp)}`; }
          else if(days<=alertDays){ cls='badge-amber'; txt = `${fmtDate(exp)} (${days}d)`; }
          expCell = `<td><span class="badge ${cls}">${txt}</span></td>`;
        } else expCell = '<td>—</td>';
      }
      let financeCells;
      if(isLoan){
        financeCells = `<td class="num">${e.receipt?fmtMoney(e.receipt.amount, e.receipt.currency):'—'}</td>
          <td><span class="badge badge-navy">${esc(e.data.loanStatus||'—')}</span></td>`;
      } else {
        const fin = e.finance || {};
        const bal = (Number(fin.totalAmount)||0)-(Number(fin.paidAmount)||0);
        financeCells = `<td class="num">${fin.totalAmount?fmtMoney(fin.totalAmount, fin.currency):'—'}</td>
          <td class="num">${fin.paidAmount?fmtMoney(fin.paidAmount, fin.currency):'—'}</td>
          <td class="num"><span class="badge ${bal>0?'badge-amber':'badge-green'}">${fmtMoney(bal, fin.currency||BASE_CURRENCY)}</span></td>`;
      }
      return `<tr>
        <td class="mono">${esc(e.refNo)}</td>
        <td>${fmtDate(e.date)}</td>
        <td>${whoLabel}</td>
        ${expCell}
        ${financeCells}
        <td class="row-actions">
          <button class="icon-btn se-print" data-id="${e.id}" title="Print voucher">&#128424;</button>
          <button class="icon-btn se-edit" data-id="${e.id}" title="Edit">&#9998;</button>
          <button class="icon-btn se-del" data-id="${e.id}" title="Delete">&#128465;</button>
        </td>
      </tr>`;
    }).join('');
  }
  function refreshRows(f){ container.querySelector('#se-tbody').innerHTML = rowsHTML(f||''); wireRowButtons(); }
  function wireRowButtons(){
    container.querySelectorAll('.se-edit').forEach(b=>b.onclick=()=>openForm(entries.find(e=>e.id===b.dataset.id)));
    container.querySelectorAll('.se-print').forEach(b=>b.onclick=()=>printServiceVoucher(entries.find(e=>e.id===b.dataset.id), cfg));
    container.querySelectorAll('.se-del').forEach(b=>b.onclick=async()=>{
      const ok = await confirmModal('Delete this entry and its linked ledger transaction?');
      if(!ok) return;
      const id = b.dataset.id;
      await deleteTransactionsByRef(id);
      await dbDelete('serviceEntries', id);
      toast('Entry deleted','success');
      renderRoute();
    });
  }

  function openForm(entry){
    const isNew = !entry;
    const data = (entry && entry.data) || {};
    const modalBody = `
      <div class="form-grid">
        <div class="field">
          <label>Reference No.</label>
          <input type="text" id="se_refno" value="${entry?esc(entry.refNo):'(auto on save)'}" disabled>
        </div>
        <div class="field">
          <label>Date *</label>
          <input type="date" id="se_date" value="${entry?entry.date:todayISO()}">
        </div>
        <div class="field span-2">
          <label>Client${cfg.optionalCustomer?' (optional — select the Employee below instead if this is internal)':' *'}</label>
          <select id="se_customer">${customerOptionsHTML(entry?entry.customerId:'')}</select>
          <span class="hint">Don't see the client? <a class="link" id="se-add-customer">+ Add new customer</a></span>
        </div>
      </div>
      <fieldset>
        <legend>${esc(cfg.label)} Details</legend>
        ${fieldsFormHTML(cfg.fields.map(f=>({...f,key:'sd_'+f.key})), Object.fromEntries(Object.entries(data).map(([k,v])=>['sd_'+k,v])))}
      </fieldset>
      ${isLoan ? receiptPaymentFieldsHTML(entry, 'Loan Amount & Disbursement Account') : financeFieldsHTML(entry&&entry.finance)}
      <div class="field">
        <label>Remarks</label>
        <textarea id="se_notes">${entry?esc(entry.notes||''):''}</textarea>
      </div>
      <div class="form-actions">
        <button class="btn" id="se-cancel">Cancel</button>
        <button class="btn btn-primary" id="se-save">Save Entry</button>
      </div>`;
    const {close} = openModal((isNew?'New: ':'Edit: ')+cfg.label, modalBody, {wide:true});
    if(isLoan) wireReceiptPaymentPreview(); else wireFinancePreview();
    // Loans: auto-suggest the disbursement direction from the Loan Type selector.
    if(isLoan){
      const loanTypeSel = document.getElementById('f_sd_loanDirection');
      const dirSel = document.getElementById('rp_direction');
      if(loanTypeSel && dirSel && isNew){
        loanTypeSel.addEventListener('change', ()=>{ dirSel.value = loanTypeSel.value==='Loan Given' ? 'payment' : 'receipt'; });
      }
    }
    document.getElementById('se-cancel').onclick = close;
    document.getElementById('se-add-customer').onclick = (e)=>{ e.preventDefault(); quickAddCustomer(); };
    document.getElementById('se-save').onclick = async ()=>{
      const customerId = document.getElementById('se_customer').value;
      if(!customerId && !cfg.optionalCustomer){ toast('Please select a client','error'); return; }
      const newData = {};
      cfg.fields.forEach(f=>{ const el = document.getElementById('f_sd_'+f.key); newData[f.key] = f.type==='number' ? (Number(el.value)||0) : el.value; });
      const rec = entry ? Object.assign({}, entry) : { id: uid('svc'), type: cfg.key, createdAt: new Date().toISOString() };
      rec.date = document.getElementById('se_date').value || todayISO();
      rec.customerId = customerId || null;
      rec.data = newData;
      rec.notes = document.getElementById('se_notes').value;
      if(isNew) rec.refNo = await nextRefNo(cfg.key, cfg.prefix);
      await dbPut('serviceEntries', rec);
      if(isLoan){
        rec.receipt = readReceiptPayment();
        await dbPut('serviceEntries', rec);
        await syncServiceEntryTransaction(rec, cfg);
      } else {
        rec.finance = readFinance();
        await dbPut('serviceEntries', rec);
        await syncServiceEntryFinance(rec, cfg);
      }
      toast(`${cfg.label} entry saved (${rec.refNo})`, 'success');
      close();
      renderRoute();
    };
  }

  container.querySelector('#se-add').onclick = ()=>openForm(null);
  container.querySelector('#se-search').addEventListener('input', e=>refreshRows(e.target.value));
  refreshRows('');
}

function quickAddCustomer(){
  const {close} = openModal('Add New Customer', `
    <div class="form-grid">
      <div class="field"><label>Name *</label><input id="qc_name"></div>
      <div class="field"><label>Phone</label><input id="qc_phone"></div>
      <div class="field"><label>WhatsApp Number</label><input id="qc_whatsapp" placeholder="+62 8xx-xxxx-xxxx"></div>
      <div class="field"><label>Currency</label><select id="qc_currency">${currencyOptionsHTML(BASE_CURRENCY)}</select></div>
      <div class="field"><label>Opening Balance</label><input type="number" id="qc_ob" value="0"></div>
    </div>
    <div class="form-actions">
      <button class="btn" id="qc-cancel">Cancel</button>
      <button class="btn btn-primary" id="qc-save">Save Customer</button>
    </div>`);
  document.getElementById('qc-cancel').onclick = close;
  document.getElementById('qc-save').onclick = async ()=>{
    const name = document.getElementById('qc_name').value.trim();
    if(!name){ toast('Name is required','error'); return; }
    const rec = {id: uid('cus'), name, phone: document.getElementById('qc_phone').value, whatsapp: document.getElementById('qc_whatsapp').value,
      currency: document.getElementById('qc_currency').value, openingBalance: Number(document.getElementById('qc_ob').value)||0, createdAt: todayISO()};
    await dbPut('customers', rec);
    STATE.customers.push(rec);
    toast('Customer added','success');
    close();
    const sel = document.getElementById('se_customer');
    if(sel){ sel.innerHTML = customerOptionsHTML(rec.id); }
  };
}

function printServiceVoucher(entry, cfg){
  const isLoan = cfg.financeMode==='loan';
  const cust = STATE.customers.find(c=>c.id===entry.customerId);
  const emp = cfg.optionalCustomer && entry.data && entry.data.employeeId ? STATE.employees.find(x=>x.id===entry.data.employeeId) : null;
  const rows = cfg.fields.map(f=>`<tr><td style="font-weight:700;width:40%;">${esc(f.label)}</td><td>${esc(f.type==='employee-select' ? (emp?emp.name:'—') : (entry.data[f.key]||'—'))}</td></tr>`).join('');
  let financeBlock = '';
  if(isLoan){
    const acc = STATE.accounts.find(a=>a.id===(entry.receipt&&entry.receipt.accountId));
    if(entry.receipt && entry.receipt.direction!=='none'){
      financeBlock = `<div class="totals">
        <div><span>${entry.receipt.direction==='receipt'?'Amount Received':'Amount Disbursed'}</span><span>${fmtMoney(entry.receipt.amount, entry.receipt.currency)}</span></div>
        <div><span>Account</span><span>${acc?esc(acc.name):'—'}</span></div>
        <div><span>Payment Method</span><span>${esc(entry.receipt.paymentMethod||'—')}</span></div>
        <div class="grand"><span>USD Equivalent</span><span>${fmtMoney(entry.receipt.amount*entry.receipt.rate,'USD')}</span></div>
      </div>`;
    }
  } else if(entry.finance){
    const acc = STATE.accounts.find(a=>a.id===entry.finance.accountId);
    const bal = (Number(entry.finance.totalAmount)||0)-(Number(entry.finance.paidAmount)||0);
    financeBlock = `<div class="totals">
      <div><span>Total Amount</span><span>${fmtMoney(entry.finance.totalAmount, entry.finance.currency)}</span></div>
      <div><span>Paid Amount</span><span>${fmtMoney(entry.finance.paidAmount, entry.finance.currency)}</span></div>
      <div><span>Payment Method</span><span>${esc(entry.finance.paymentMethod||'—')}</span></div>
      <div><span>Account</span><span>${acc?esc(acc.name):'—'}</span></div>
      <div class="grand"><span>Balance Due</span><span>${fmtMoney(bal, entry.finance.currency)}</span></div>
    </div>`;
  }
  const html = `
    <div class="print-doc">
      ${printHeaderHTML(cfg.label+' Voucher', entry.refNo, entry.date)}
      <table>
        <tr><td style="font-weight:700;width:40%;">${cfg.optionalCustomer?'Client / Employee':'Client'}</td><td>${cust?esc(cust.name):(emp?esc(emp.name):'—')}</td></tr>
        ${rows}
      </table>
      ${financeBlock}
      ${entry.notes?`<p style="margin-top:16px;"><b>Remarks:</b> ${esc(entry.notes)}</p>`:''}
      <div class="ph-footer">${esc(COMPANY.name)} · WhatsApp: ${esc(COMPANY.whatsapp)} · Generated ${fmtDate(todayISO())}</div>
    </div>`;
  doPrint(html);
}

function printHeaderHTML(docTitle, refNo, date, opts){
  opts = opts || {};
  const contactLine = opts.hideWhatsapp
    ? `Tel: ${esc(COMPANY.phone)}`
    : `Tel: ${esc(COMPANY.phone)}${COMPANY.whatsapp?(' &middot; WhatsApp: '+esc(COMPANY.whatsapp)):''}`;
  return `
    <div class="ph-header">
      <div class="ph-brand">
        <div class="ph-logo">${logoSvgRaw()}</div>
        <div>
          <div class="ph-company">${esc(COMPANY.name)}</div>
          <div class="ph-tag">${esc(COMPANY.tagline)}</div>
          <div class="ph-addr">${esc(COMPANY.address)}<br>${contactLine}</div>
        </div>
      </div>
      <div class="ph-meta">
        <div class="doc-title">${esc(docTitle)}</div>
        <div><b>No:</b> ${esc(refNo)}</div>
        <div><b>Date:</b> ${fmtDate(date)}</div>
      </div>
    </div>`;
}
function logoSvgRaw(){
  return `<img src="${LOGO_ICON_DATA_URI}" alt="OBC Indonesia" style="width:100%;height:100%;object-fit:cover;display:block;border-radius:8px;">`;
}
function doPrint(innerHtml){
  document.getElementById('print-area').innerHTML = innerHtml;
  setTimeout(()=>window.print(), 60);
}

/* ---------------------------------------------------------
   12. MONEY EXCHANGE (standalone module)
--------------------------------------------------------- */
ROUTE_RENDERERS['money-exchange'] = async function(container){
  const entries = (await dbGetByIndex('serviceEntries','type','money_exchange')).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  container.innerHTML = `
    <div class="breadcrumb"><a id="de-back-mex">&larr; Data Entry</a> / Money Exchange</div>
    <div class="callout callout-navy">Record currency bought/sold. The system captures both legs plus the realized gain or loss, and posts everything to the ledgers automatically.</div>
    <div class="card mt-14">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Money Exchange <span class="muted" style="font-weight:500;font-size:12px;">(${entries.length} entries)</span></h2>
        <button class="btn btn-primary" id="me-add">+ New Exchange</button>
      </div>
      <div class="table-wrap"><table>
        <thead><tr><th>Ref No.</th><th>Date</th><th>Client</th><th class="num">Received</th><th class="num">Paid Out</th><th class="num">Gain/Loss (USD)</th><th></th></tr></thead>
        <tbody id="me-tbody">${rows(entries)}</tbody>
      </table></div>
    </div>`;

  function rows(list){
    if(list.length===0) return `<tr class="empty-row"><td colspan="7">No exchanges recorded yet.</td></tr>`;
    return list.map(e=>{
      const cust = STATE.customers.find(c=>c.id===e.customerId);
      const gl = e.data.gainLoss||0;
      return `<tr>
        <td class="mono">${esc(e.refNo)}</td><td>${fmtDate(e.date)}</td>
        <td>${cust?esc(cust.name):'<span class="faint">Walk-in</span>'}</td>
        <td class="num">${fmtMoney(e.data.amountReceived, e.data.currencyReceived)}</td>
        <td class="num">${fmtMoney(e.data.amountPaid, e.data.currencyPaid)}</td>
        <td class="num"><span class="badge ${gl>=0?'badge-green':'badge-red'}">${fmtMoney(gl,'USD')}</span></td>
        <td class="row-actions">
          <button class="icon-btn me-edit" data-id="${e.id}">&#9998;</button>
          <button class="icon-btn me-del" data-id="${e.id}">&#128465;</button>
        </td></tr>`;
    }).join('');
  }
  function wire(){
    container.querySelectorAll('.me-edit').forEach(b=>b.onclick=()=>openForm(entries.find(e=>e.id===b.dataset.id)));
    container.querySelectorAll('.me-del').forEach(b=>b.onclick=async()=>{
      if(!await confirmModal('Delete this exchange entry?')) return;
      await deleteTransactionsByRef(b.dataset.id);
      await dbDelete('serviceEntries', b.dataset.id);
      toast('Exchange deleted','success'); renderRoute();
    });
  }
  function openForm(entry){
    const d = (entry && entry.data) || {};
    const body = `
      <div class="form-grid">
        <div class="field"><label>Date *</label><input type="date" id="me_date" value="${entry?entry.date:todayISO()}"></div>
        <div class="field"><label>Client (optional)</label><select id="me_customer">${customerOptionsHTML(entry?entry.customerId:'')}</select></div>
      </div>
      <fieldset><legend>Currency Received (from client)</legend>
        <div class="form-grid">
          <div class="field"><label>Currency</label><select id="me_cur_r">${currencyOptionsHTML(d.currencyReceived||'USD')}</select></div>
          <div class="field"><label>Amount</label><input type="number" step="any" id="me_amt_r" value="${esc(d.amountReceived||'')}"></div>
          <div class="field"><label>Rate → USD</label><input type="number" step="any" id="me_rate_r" value="${esc(d.rateReceived||getRate(d.currencyReceived||'USD'))}"></div>
          <div class="field"><label>Deposit Into Account</label><select id="me_acc_r">${accountOptionsHTML(d.accountReceivedId)}</select></div>
        </div>
      </fieldset>
      <fieldset><legend>Currency Paid Out (to client)</legend>
        <div class="form-grid">
          <div class="field"><label>Currency</label><select id="me_cur_p">${currencyOptionsHTML(d.currencyPaid||'IDR')}</select></div>
          <div class="field"><label>Amount</label><input type="number" step="any" id="me_amt_p" value="${esc(d.amountPaid||'')}"></div>
          <div class="field"><label>Rate → USD</label><input type="number" step="any" id="me_rate_p" value="${esc(d.ratePaid||getRate(d.currencyPaid||'IDR'))}"></div>
          <div class="field"><label>Pay Out Of Account</label><select id="me_acc_p">${accountOptionsHTML(d.accountPaidId)}</select></div>
        </div>
      </fieldset>
      <div class="callout callout-amber" id="me_gl_preview">Realized Gain/Loss: —</div>
      <div class="form-actions">
        <button class="btn" id="me-cancel">Cancel</button>
        <button class="btn btn-primary" id="me-save">Save Exchange</button>
      </div>`;
    const {close} = openModal(entry?'Edit Money Exchange':'New Money Exchange', body, {wide:true});
    function updatePreview(){
      const recBase = (Number(document.getElementById('me_amt_r').value)||0) * (Number(document.getElementById('me_rate_r').value)||0);
      const payBase = (Number(document.getElementById('me_amt_p').value)||0) * (Number(document.getElementById('me_rate_p').value)||0);
      const gl = recBase - payBase;
      document.getElementById('me_gl_preview').textContent = `Realized Gain/Loss: ${fmtMoney(gl,'USD')} (Received ${fmtMoney(recBase,'USD')} − Paid ${fmtMoney(payBase,'USD')})`;
    }
    ['me_cur_r','me_amt_r','me_rate_r','me_cur_p','me_amt_p','me_rate_p'].forEach(id=>{
      document.getElementById(id).addEventListener('input', updatePreview);
      document.getElementById(id).addEventListener('change', updatePreview);
    });
    document.getElementById('me_cur_r').addEventListener('change', e=>{ document.getElementById('me_rate_r').value = getRate(e.target.value)||1; updatePreview(); });
    document.getElementById('me_cur_p').addEventListener('change', e=>{ document.getElementById('me_rate_p').value = getRate(e.target.value)||1; updatePreview(); });
    updatePreview();
    document.getElementById('me-cancel').onclick = close;
    document.getElementById('me-save').onclick = async ()=>{
      const accR = document.getElementById('me_acc_r').value, accP = document.getElementById('me_acc_p').value;
      if(!accR||!accP){ toast('Please select both accounts','error'); return; }
      const amountReceived = Number(document.getElementById('me_amt_r').value)||0;
      const rateReceived = Number(document.getElementById('me_rate_r').value)||0;
      const amountPaid = Number(document.getElementById('me_amt_p').value)||0;
      const ratePaid = Number(document.getElementById('me_rate_p').value)||0;
      const gainLoss = (amountReceived*rateReceived) - (amountPaid*ratePaid);
      const rec = entry ? Object.assign({}, entry) : {id: uid('mex'), type:'money_exchange', createdAt:new Date().toISOString()};
      rec.date = document.getElementById('me_date').value || todayISO();
      rec.customerId = document.getElementById('me_customer').value || null;
      rec.data = {
        currencyReceived: document.getElementById('me_cur_r').value, amountReceived, rateReceived, accountReceivedId: accR,
        currencyPaid: document.getElementById('me_cur_p').value, amountPaid, ratePaid, accountPaidId: accP,
        gainLoss,
      };
      if(!rec.refNo) rec.refNo = await nextRefNo('money_exchange', MONEY_EXCHANGE_PREFIX);
      await dbPut('serviceEntries', rec);
      await deleteTransactionsByRef(rec.id);
      const custName = rec.customerId ? (STATE.customers.find(c=>c.id===rec.customerId)||{}).name : 'Walk-in';
      await postTransaction({date:rec.date, type:'exchange', refType:'serviceEntry', refId:rec.id, accountId:accR, currency:rec.data.currencyReceived, amount:amountReceived, rate:rateReceived, direction:'in', partyType:'customer', partyId:rec.customerId, description:`Money Exchange ${rec.refNo} — received from ${custName}`});
      await postTransaction({date:rec.date, type:'exchange', refType:'serviceEntry', refId:rec.id, accountId:accP, currency:rec.data.currencyPaid, amount:amountPaid, rate:ratePaid, direction:'out', partyType:'customer', partyId:rec.customerId, description:`Money Exchange ${rec.refNo} — paid to ${custName}`});
      const glAcc = STATE.accounts.find(a=>a.name==='Exchange Gain / Loss');
      if(glAcc && gainLoss!==0){
        await postTransaction({date:rec.date, type:'exchange', refType:'serviceEntry', refId:rec.id, accountId:glAcc.id, currency:BASE_CURRENCY, amount:Math.abs(gainLoss), rate:1, direction: gainLoss>=0?'in':'out', description:`Realized ${gainLoss>=0?'gain':'loss'} on ${rec.refNo}`});
      }
      toast(`Exchange saved (${rec.refNo})`,'success');
      close(); renderRoute();
    };
  }
  container.querySelector('#me-add').onclick = ()=>openForm(null);
  const backLink = container.querySelector('#de-back-mex');
  if(backLink) backLink.onclick = ()=>navigate('data-entry');
  wire();
};

