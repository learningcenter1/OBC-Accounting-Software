        <div class="field"><label>Type</label><select id="coa_hdr"><option value="no" ${!c.isHeader?'selected':''}>Posting account</option><option value="yes" ${c.isHeader?'selected':''}>Header (summary only)</option></select></div>
        <div class="field"><label>Status</label><select id="coa_active"><option value="yes" ${c.active!==false?'selected':''}>Active</option><option value="no" ${c.active===false?'selected':''}>Inactive</option></select></div>
