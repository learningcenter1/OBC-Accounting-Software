function currencyOptionsHTML(selected){
  const codes = Object.keys(STATE.currencyMap);
  if(codes.length===0) return `<option value="${BASE_CURRENCY}">${BASE_CURRENCY}</option>`;
  return codes.map(c=>`<option value="${c}" ${c===selected?'selected':''}>${c} — ${esc(STATE.currencyMap[c].name)}</option>`).join('');
}
function accountOptionsHTML(selected, filterFn){
  let accs = STATE.accounts.filter(a=>!a.system);
  if(filterFn) accs = accs.filter(filterFn);
  return accs.map(a=>`<option value="${a.id}" ${a.id===selected?'selected':''}>${esc(a.name)} (${a.currency})</option>`).join('');
}
function customerOptionsHTML(selected){
  return `<option value="">— Select customer —</option>` + STATE.customers.map(c=>`<option value="${c.id}" ${c.id===selected?'selected':''}>${esc(c.name)}</option>`).join('');
}
function vendorOptionsHTML(selected){
  return `<option value="">— Select vendor —</option>` + STATE.vendors.map(c=>`<option value="${c.id}" ${c.id===selected?'selected':''}>${esc(c.name)}</option>`).join('');
}
function partnerOptionsHTML(selected){
  return STATE.partners.map(p=>`<option value="${p.id}" ${p.id===selected?'selected':''}>${esc(p.name)}</option>`).join('');
}
function employeeOptionsHTML(selected){
  return `<option value="">— Select employee —</option>` + STATE.employees.map(e=>`<option value="${e.id}" ${e.id===selected?'selected':''}>${esc(e.name)}</option>`).join('');
}

function renderFieldHTML(f, val){
  val = val===undefined||val===null ? '' : val;
  const req = f.required ? 'required' : '';
  if(f.type==='select'){
    const opts = (f.options||[]).map(o=>`<option value="${esc(o)}" ${o===val?'selected':''}>${esc(o)}</option>`).join('');
    return `<select id="f_${f.key}" ${req}>${f.optional?'<option value="">—</option>':''}${opts}</select>`;
  }
  if(f.type==='currency-select') return `<select id="f_${f.key}" ${req}>${currencyOptionsHTML(val)}</select>`;
  if(f.type==='employee-select') return `<select id="f_${f.key}" ${req}>${employeeOptionsHTML(val)}</select>`;
  if(f.type==='textarea') return `<textarea id="f_${f.key}" ${req}>${esc(val)}</textarea>`;
  if(f.type==='number') return `<input type="number" step="any" id="f_${f.key}" value="${esc(val)}" ${req}>`;
  if(f.type==='date') return `<input type="date" id="f_${f.key}" value="${esc(val)}" ${req}>`;
  if(f.type==='month') return `<input type="month" id="f_${f.key}" value="${esc(val)}" ${req}>`;
  return `<input type="text" id="f_${f.key}" value="${esc(val)}" ${req}>`;
}

function readFieldVal(f){
  const el = document.getElementById('f_'+f.key);
  if(!el) return null;
  if(f.type==='number') return el.value===''? 0 : Number(el.value);
  return el.value;
}

function fieldsFormHTML(fields, record){
  record = record || {};
  return `<div class="form-grid">
    ${fields.map(f=>`
      <div class="field ${f.span2?'span-2':''}">
        <label>${esc(f.label)}${f.required?' *':''}</label>
        ${renderFieldHTML(f, record[f.key])}
        ${f.hint?`<span class="hint">${esc(f.hint)}</span>`:''}
      </div>`).join('')}
  </div>`;
}

/* Generic master-data CRUD screen */
function masterCrud(cfg){
  // cfg: {store, idField, title, singular, fields:[{key,label,type,required,span2}], columns:[{key,label,render(r)}], canDelete}
  return async function(container){
    const records = await dbGetAll(cfg.store);
    records.sort((a,b)=> (a.name||a.code||'').localeCompare(b.name||b.code||''));
    container.innerHTML = `
      <div class="card">
        <div class="toolbar">
          <div class="toolbar-left">
            <h2 class="card-title" style="font-size:16px;">${esc(cfg.title)} <span class="muted" style="font-weight:500;font-size:12px;">(${records.length})</span></h2>
            <input class="search-input" id="mc-search" placeholder="Search ${esc(cfg.title.toLowerCase())}...">
          </div>
          <button class="btn btn-primary" id="mc-add">+ Add ${esc(cfg.singular)}</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr>${cfg.columns.map(c=>`<th class="${c.num?'num':''}">${esc(c.label)}</th>`).join('')}<th></th></tr></thead>
            <tbody id="mc-tbody"></tbody>
          </table>
        </div>
      </div>`;

    async function renderRows(filterText){
      const tbody = container.querySelector('#mc-tbody');
      let rows = records;
      if(filterText){
        const ft = filterText.toLowerCase();
        rows = rows.filter(r=> JSON.stringify(r).toLowerCase().includes(ft));
      }
      if(rows.length===0){ tbody.innerHTML = `<tr class="empty-row"><td colspan="${cfg.columns.length+1}">No ${esc(cfg.title.toLowerCase())} yet. Click "Add ${esc(cfg.singular)}" to create one.</td></tr>`; return; }
      const htmlRows = await Promise.all(rows.map(async r=>{
        const cells = await Promise.all(cfg.columns.map(async c=> c.render ? await c.render(r) : esc(r[c.key])));
        return `<tr>${cells.map((c,i)=>`<td class="${cfg.columns[i].num?'num':''}">${c}</td>`).join('')}
          <td class="row-actions">
            <button class="icon-btn mc-edit" data-id="${r[cfg.idField]}" title="Edit">&#9998;</button>
            ${cfg.canDelete!==false?`<button class="icon-btn mc-del" data-id="${r[cfg.idField]}" title="Delete">&#128465;</button>`:''}
          </td></tr>`;
      }));
      tbody.innerHTML = htmlRows.join('');
      tbody.querySelectorAll('.mc-edit').forEach(b=>b.onclick=()=>openForm(records.find(r=>String(r[cfg.idField])===b.dataset.id)));
      tbody.querySelectorAll('.mc-del').forEach(b=>b.onclick=async ()=>{
        const ok = await confirmModal(`Delete this ${cfg.singular.toLowerCase()}? This cannot be undone.`);
        if(!ok) return;
        await dbDelete(cfg.store, isNaN(b.dataset.id) ? b.dataset.id : b.dataset.id);
        toast(`${cfg.singular} deleted`, 'success');
        renderRoute();
      });
    }
    function openForm(record){
      const {close} = openModal(record? `Edit ${cfg.singular}` : `Add ${cfg.singular}`, `
        ${fieldsFormHTML(cfg.fields, record)}
        <div class="form-actions">
          <button class="btn" id="mc-cancel">Cancel</button>
          <button class="btn btn-primary" id="mc-save">Save</button>
        </div>`);
      document.getElementById('mc-cancel').onclick = close;
      document.getElementById('mc-save').onclick = async ()=>{
        const data = record ? Object.assign({}, record) : {};
        cfg.fields.forEach(f=> data[f.key] = readFieldVal(f));
        if(!data[cfg.idField]) data[cfg.idField] = cfg.idField==='id' ? uid(cfg.store.slice(0,3)) : data[cfg.idField];
        if(!data.createdAt) data.createdAt = todayISO();
        if(cfg.beforeSave) cfg.beforeSave(data);
        await dbPut(cfg.store, data);
        if(cfg.afterSave) await cfg.afterSave(data, !record);
        toast(`${cfg.singular} saved`, 'success');
        close();
        renderRoute();
      };
    }
    container.querySelector('#mc-add').onclick = ()=>openForm(null);
    container.querySelector('#mc-search').addEventListener('input', (e)=>renderRows(e.target.value));
    renderRows('');
  };
}

