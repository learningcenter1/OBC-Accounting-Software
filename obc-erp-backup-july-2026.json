    if(t.partyType==='vendor') partyName = (STATE.vendors.find(c=>c.id===t.partyId)||{}).name || '—';
    return `<tr>
      <td>${fmtDate(t.date)}</td><td>${esc(t.description)}</td><td>${esc(partyName)}</td>
      <td>${acc?esc(acc.name):'—'}</td><td class="num">${fmtMoney(t.amount,t.currency)}</td>
      <td>${t.direction==='in'?'<span class="badge badge-green">Receipt (In)</span>':'<span class="badge badge-red">Payment (Out)</span>'}</td>
    </tr>`;
