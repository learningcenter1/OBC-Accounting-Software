      <div class="tab" data-t="mypw">My Password</div>
      <div class="tab" data-t="autosave">Automatic Saving</div>
      <div class="tab" data-t="backup">Backup &amp; Restore</div>
    </div>
    <div id="settings-body"></div>`;

  async function showTab(t){
