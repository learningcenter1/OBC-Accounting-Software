  container.querySelector('#rp2-add').onclick = ()=>{
    const body = `
      <div class="form-grid">
        <div class="field"><label>Date *</label><input type="date" id="g_date" value="${todayISO()}"></div>
        <div class="field"><label>Direction *</label>
          <select id="g_dir"><option value="in">Receipt (money IN)</option><option value="out">Payment (money OUT)</option></select>
        </div>
        <div class="field"><label>Party Type</label>
          <select id="g_ptype"><option value="customer">Customer</option><option value="vendor">Vendor</option><option value="">Other / N/A</option></select>
        </div>
        <div class="field"><label>Party</label><select id="g_party">${customerOptionsHTML('')}</select></div>
        <div class="field"><label>Account *</label><select id="g_acc">${accountOptionsHTML('')}</select></div>
        <div class="field"><label>Currency</label><select id="g_cur">${currencyOptionsHTML(BASE_CURRENCY)}</select></div>
        <div class="field"><label>Amount *</label><input type="number" step="any" id="g_amt"></div>
        <div class="field"><label>Rate → USD</label><input type="number" step="any" id="g_rate" value="1"></div>
        <div class="field span-2"><label>Description *</label><input type="text" id="g_desc" placeholder="e.g. Advance received for visa processing"></div>
      </div>
      <div class="form-actions"><button class="btn" id="g-cancel">Cancel</button><button class="btn btn-primary" id="g-save">Save</button></div>`;
    const {close} = openModal('New Receipt / Payment', body, {wide:true});
    document.getElementById('g_cur').value = BASE_CURRENCY;
    document.getElementById('g_cur').addEventListener('change', e=>{ document.getElementById('g_rate').value = getRate(e.target.value)||1; });
    document.getElementById('g_ptype').addEventListener('change', e=>{
      const sel = document.getElementById('g_party');
      sel.innerHTML = e.target.value==='vendor' ? vendorOptionsHTML('') : (e.target.value==='customer'? customerOptionsHTML('') : '<option value="">—</option>');
    });
