async function ensureCOA(){
  const existing = await dbGetAll('coa');
  if(existing.length === 0){
    for(const [code,name,cls,group,isHeader] of COA_DEFAULTS){
      await dbPutRaw('coa', {id:uid('coa'), code, name, class:cls, group, isHeader:!!isHeader, openingBalance:0, active:true, system:true, createdAt:todayISO()});
    }
  }
  await syncCOAWithAccounts();
}

/* Every cash / bank / partner account gets its own COA line under the right
   header, so adding an account on "Banks, Cash & Accounts" extends the chart
   automatically. */
async function syncCOAWithAccounts(){
  const [coa, accounts] = await Promise.all([dbGetAll('coa'), dbGetAll('accounts')]);
  const linked = new Set(coa.map(c=>c.linkedAccountId).filter(Boolean));
  const rules = {cash:{base:1100, cls:'asset', group:'Cash & Bank'}, bank:{base:1200, cls:'asset', group:'Cash & Bank'}, partner:{base:2200, cls:'liability', group:'Partner Accounts'}};
  for(const a of accounts){
    const r = rules[a.type];
    if(!r || linked.has(a.id)) continue;
    const used = new Set(coa.map(c=>Number(c.code)));
    let code = r.base + 1;
    while(used.has(code)) code++;
    const entry = {id:uid('coa'), code:String(code), name:a.name, class:r.cls, group:r.group, isHeader:false, linkedAccountId:a.id, openingBalance:0, active:true, createdAt:todayISO()};
    await dbPutRaw('coa', entry);
    coa.push(entry);
  }
  // keep names of linked lines in step with the account name
  for(const c of coa){
    if(!c.linkedAccountId) continue;
    const a = accounts.find(x=>x.id===c.linkedAccountId);
    if(a && a.name !== c.name){ c.name = a.name; await dbPutRaw('coa', c); }
  }
}

function coaSort(a,b){ return String(a.code).localeCompare(String(b.code), undefined, {numeric:true}); }

ROUTE_RENDERERS['coa'] = async function(container){
  await syncCOAWithAccounts();
  const [coa, expenses] = await Promise.all([dbGetAll('coa'), dbGetAll('expenses')]);
  coa.sort(coaSort);
  const balNative = {};
  for(const c of coa){
    if(c.linkedAccountId){ balNative[c.id] = await getAccountBalance(c.linkedAccountId); }
  }
  const expByCat = {};
  expenses.forEach(e=>{
    const k = (e.category||'General').toLowerCase();
