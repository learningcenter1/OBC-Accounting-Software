          <div class="card-title">Company Profile</div>
          <p class="muted mt-0">Shown in the sidebar, on printed vouchers, ledgers, and invoices.</p>
          <div class="form-grid mt-14">
            <div class="field"><label>Company Name</label><input id="cp_name" value="${esc(COMPANY.name)}"></div>
            <div class="field"><label>Tagline</label><input id="cp_tagline" value="${esc(COMPANY.tagline)}"></div>
            <div class="field span-2"><label>Address</label><textarea id="cp_address">${esc(COMPANY.address)}</textarea></div>
            <div class="field"><label>Phone / Contact No.</label><input id="cp_phone" value="${esc(COMPANY.phone)}"></div>
            <div class="field"><label>WhatsApp Number</label><input id="cp_whatsapp" value="${esc(COMPANY.whatsapp||'')}" placeholder="+62 8xx-xxxx-xxxx"></div>
          </div>
          <div class="form-actions"><button class="btn btn-primary" id="cp-save">Save Company Profile</button></div>
        </div>`;
      document.getElementById('cp-save').onclick = async ()=>{
        COMPANY.name = document.getElementById('cp_name').value.trim() || DEFAULT_COMPANY.name;
        COMPANY.tagline = document.getElementById('cp_tagline').value;
        COMPANY.address = document.getElementById('cp_address').value;
        COMPANY.phone = document.getElementById('cp_phone').value;
        COMPANY.whatsapp = document.getElementById('cp_whatsapp').value;
        await dbPut('settings', {key:'companyProfile', value: Object.assign({}, COMPANY)});
        toast('Company profile saved','success');
        renderShell();
      };
    }
    if(t==='visa'){
      body.innerHTML = `
        <div class="card">
          <div class="card-title">Visa Expiry Alert Threshold</div>
          <p class="muted mt-0">Business, Investor, and Dependent visas will surface on the Dashboard once their expiry date falls within this many days.</p>
          <div class="form-grid mt-14">
            <div class="field"><label>Alert Window (days)</label><input type="number" id="va_days" value="${Number(STATE.settings.visaAlertDays)||90}"></div>
          </div>
          <div class="form-actions"><button class="btn btn-primary" id="va-save">Save Threshold</button></div>
        </div>`;
      document.getElementById('va-save').onclick = async ()=>{
