/* ---------------------------------------------------------
   0b. PRISTINE SHELL CAPTURE (for Automatic Saving to file)
   Captured synchronously as the very first thing this script does, before
   any DOM mutation, so it always reflects the clean template + whatever
   data blob was embedded in the file when it was opened.
--------------------------------------------------------- */
const PRISTINE_HTML_SHELL = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
const EMBEDDED_DATA_RAW = (function(){
  const el = document.getElementById('obc-data-blob');
  return el ? el.textContent : '';
})();

/* ---------------------------------------------------------
   1. INDEXEDDB LAYER
--------------------------------------------------------- */
function openDB(){
  return new Promise((resolve,reject)=>{
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = (e)=>{
      const d = e.target.result;
      const mk = (name,key,indexes)=>{
        if(!d.objectStoreNames.contains(name)){
          const os = d.createObjectStore(name,{keyPath:key});
          (indexes||[]).forEach(ix=>os.createIndex(ix,ix));
        }
      };
      mk('customers','id');
      mk('vendors','id');
      mk('currencies','code');
      mk('accounts','id');
      mk('employees','id');
      mk('partners','id');
      mk('serviceEntries','id',['type','customerId']);
      mk('transactions','id',['accountId','partyId','date','type']);
      mk('invoices','id',['customerId','invoiceNo']);
      mk('expenses','id',['date']);
      mk('transfers','id',['date']);
      mk('partnerTxns','id',['partnerId','accountId']);
      mk('counters','key');
      mk('settings','key');
      mk('fileHandles','key');
      mk('coa','id',['code']);
      mk('users','id',['username']);
      mk('bankLines','id',['accountId']);
      mk('reconciliations','id',['accountId']);
    };
    req.onsuccess = (e)=>{ DB = e.target.result; resolve(DB); };
    req.onerror = (e)=>{ reject(e.target.error); };
  });
}

function _store(name, mode){ return DB.transaction(name, mode||'readonly').objectStore(name); }

function dbGetAll(name){
  return new Promise((res,rej)=>{
    const r = _store(name).getAll();
    r.onsuccess=()=>res(r.result||[]);
    r.onerror=()=>rej(r.error);
  });
}
function dbGet(name, key){
  return new Promise((res,rej)=>{
    const r = _store(name).get(key);
    r.onsuccess=()=>res(r.result||null);
    r.onerror=()=>rej(r.error);
  });
}
function dbPut(name, val){
  return new Promise((res,rej)=>{
    const tx = DB.transaction(name,'readwrite');
    const r = tx.objectStore(name).put(val);
    r.onsuccess=()=>{ res(val); if(name!=='fileHandles') triggerAutosaveIfEnabled(); };
    r.onerror=()=>rej(r.error);
  });
}
function dbDelete(name, key){
  return new Promise((res,rej)=>{
    const tx = DB.transaction(name,'readwrite');
    const r = tx.objectStore(name).delete(key);
    r.onsuccess=()=>{ res(true); if(name!=='fileHandles') triggerAutosaveIfEnabled(); };
    r.onerror=()=>rej(r.error);
  });
}
function dbGetByIndex(name, indexName, value){
  return new Promise((res,rej)=>{
    const r = _store(name).index(indexName).getAll(value);
    r.onsuccess=()=>res(r.result||[]);
    r.onerror=()=>rej(r.error);
  });
}
function dbClearAll(){
  const names = ['customers','vendors','currencies','accounts','employees','partners','serviceEntries','transactions','invoices','expenses','transfers','partnerTxns','counters','settings','coa','users','bankLines','reconciliations'];
  return Promise.all(names.map(n=>new Promise((res,rej)=>{
    const tx = DB.transaction(n,'readwrite');
    const r = tx.objectStore(n).clear();
    r.onsuccess=()=>res(); r.onerror=()=>rej(r.error);
  })));
}

/* ---------------------------------------------------------
   2. UTILITIES
--------------------------------------------------------- */
function uid(prefix){ return (prefix?prefix+'_':'') + Date.now().toString(36) + Math.random().toString(36).slice(2,8); }
// Local-calendar date (YYYY-MM-DD). toISOString() converts to UTC, which shifts the date by a day for
// users ahead of UTC (Indonesia/Pakistan) — wrong 'today', month and year boundaries on every report.
function localISO(d){ d = d||new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function todayISO(){ return localISO(new Date()); }
function esc(s){ if(s===undefined||s===null) return ''; return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmtDate(d){ if(!d) return '—'; const dt = new Date(d); if(isNaN(dt)) return d; return dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); }
function daysBetween(a,b){ return Math.round((new Date(b)-new Date(a))/86400000); }

function fmtMoney(amount, currency){
  amount = Number(amount)||0;
  currency = currency || BASE_CURRENCY;
  const sym = (STATE.currencyMap[currency] && STATE.currencyMap[currency].symbol) || currency;
  const decimals = currency === 'IDR' ? 0 : 2;
  const n = amount.toLocaleString('en-US',{minimumFractionDigits:decimals, maximumFractionDigits:decimals});
  return `${sym} ${n}`;
}
function toBase(amount, rate){ return (Number(amount)||0) * (Number(rate)||0); }

function getRate(currencyCode){
  if(currencyCode === BASE_CURRENCY) return 1;
  const c = STATE.currencyMap[currencyCode];
  return c ? Number(c.rateToUSD)||0 : 0;
}

function toast(msg, type){
  const wrap = document.getElementById('toast-wrap');
  const el = document.createElement('div');
  el.className = 'toast' + (type?(' '+type):'');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 2600);
}

function confirmModal(message){
  return new Promise((resolve)=>{
    const overlay = document.createElement('div');
    overlay.className = 'modal-overlay';
    overlay.innerHTML = `
      <div class="modal" style="max-width:400px;">
        <div class="modal-header"><h3>Please confirm</h3></div>
        <div class="modal-body">
          <p style="margin:0 0 18px 0;">${esc(message)}</p>
          <div class="form-actions">
            <button class="btn" id="cm-cancel">Cancel</button>
            <button class="btn btn-danger" id="cm-ok">Yes, proceed</button>
          </div>
        </div>
      </div>`;
    document.body.appendChild(overlay);
    overlay.querySelector('#cm-cancel').onclick=()=>{overlay.remove(); resolve(false);};
    overlay.querySelector('#cm-ok').onclick=()=>{overlay.remove(); resolve(true);};
    overlay.onclick=(e)=>{ if(e.target===overlay){overlay.remove(); resolve(false);} };
  });
}

function openModal(title, bodyHtml, opts){
  opts = opts || {};
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML = `
    <div class="modal ${opts.wide?'wide':''}">
      <div class="modal-header">
        <h3>${esc(title)}</h3>
        <button class="modal-close" id="modal-x">&times;</button>
      </div>
      <div class="modal-body">${bodyHtml}</div>
    </div>`;
  document.body.appendChild(overlay);
  const close = ()=>overlay.remove();
  overlay.querySelector('#modal-x').onclick = close;
  overlay.onclick = (e)=>{ if(e.target===overlay) close(); };
  return {overlay, close};
}

/* Sequence / reference numbers */
async function nextRefNo(counterKey, prefix){
  const year = new Date().getFullYear();
  const ck = counterKey + '_' + year;
  let c = await dbGet('counters', ck);
  if(!c){ c = {key:ck, value:0}; }
  c.value += 1;
  await dbPut('counters', c);
  return `${prefix}-${year}-${String(c.value).padStart(4,'0')}`;
}
async function peekNextRefNo(counterKey, prefix){
  const year = new Date().getFullYear();
  const ck = counterKey + '_' + year;
  let c = await dbGet('counters', ck);
  const val = c ? c.value+1 : 1;
  return `${prefix}-${year}-${String(val).padStart(4,'0')}`;
}

/* ---------------------------------------------------------
   3. GLOBAL STATE (in-memory cache, mirrors IndexedDB)
--------------------------------------------------------- */
const STATE = {
  route: 'dashboard',
  routeParam: null,
  currencyMap: {},   // code -> currency record
  accounts: [],
  customers: [],
  vendors: [],
  employees: [],
  partners: [],
  settings: { visaAlertDays: 90 },
  sidebarOpen: false,
  currentUser: null,
  navOpen: (function(){ try{ return JSON.parse(localStorage.getItem('obc_nav_open')||'{}')||{}; }catch(e){ return {}; } })(),
};

async function reloadCoreCaches(){
  const [currencies, accounts, customers, vendors, employees, partners, settingsRows] = await Promise.all([
    dbGetAll('currencies'), dbGetAll('accounts'), dbGetAll('customers'),
    dbGetAll('vendors'), dbGetAll('employees'), dbGetAll('partners'), dbGetAll('settings')
  ]);
  STATE.currencyMap = {};
  currencies.forEach(c=>STATE.currencyMap[c.code]=c);
  STATE.accounts = accounts;
  STATE.customers = customers;
  STATE.vendors = vendors;
  STATE.employees = employees;
  STATE.partners = partners;
  settingsRows.forEach(s=>{ STATE.settings[s.key] = s.value; });
}

/* ---------------------------------------------------------
   4. SEED DATA (first run only)
--------------------------------------------------------- */
async function seedIfEmpty(){
  const existingCurrencies = await dbGetAll('currencies');
  if(existingCurrencies.length > 0) return; // already seeded

  // Currencies
  const currencies = [
    {code:'USD', name:'US Dollar', symbol:'$', rateToUSD:1, updatedAt: todayISO()},
    {code:'IDR', name:'Indonesian Rupiah', symbol:'Rp', rateToUSD:0.0000633, updatedAt: todayISO()},
    {code:'PKR', name:'Pakistani Rupee', symbol:'₨', rateToUSD:0.003544, updatedAt: todayISO()},
    {code:'EUR', name:'Euro', symbol:'€', rateToUSD:1.082278, updatedAt: todayISO()},
    {code:'AED', name:'UAE Dirham', symbol:'د.إ', rateToUSD:0.272152, updatedAt: todayISO()},
    {code:'SGD', name:'Singapore Dollar', symbol:'S$', rateToUSD:0.740506, updatedAt: todayISO()},
  ];
  for(const c of currencies) await dbPut('currencies', c);

  // Accounts (Section 4.1)
  const accounts = [
    {id: uid('acc'), name:'Cash', type:'cash', currency:'IDR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Company BCA', type:'bank', currency:'IDR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Aqib BCA', type:'bank', currency:'IDR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Aqib Wise', type:'bank', currency:'USD', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'TSC - BA Habib', type:'bank', currency:'IDR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Rizwan BCA', type:'bank', currency:'IDR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Rizwan Meezan', type:'bank', currency:'PKR', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Aqib Wise -> MBS-BCA (Dollar Conversion)', type:'bank', currency:'USD', openingBalance:0, createdAt: todayISO()},
    {id: uid('acc'), name:'Exchange Gain / Loss', type:'other', currency:BASE_CURRENCY, openingBalance:0, createdAt: todayISO(), system:true},
  ];
  for(const a of accounts) await dbPut('accounts', a);

  // Partners (Section 4.2) — also create a payable/capital tracking account for each
  const partners = [
    {id: uid('ptn'), name:'Rizwan Malik', openingCapital:0, currency:BASE_CURRENCY, createdAt: todayISO()},
    {id: uid('ptn'), name:'Aqib Mehmood', openingCapital:0, currency:BASE_CURRENCY, createdAt: todayISO()},
  ];
  for(const p of partners) await dbPut('partners', p);
  for(const p of partners){
    await dbPut('accounts', {id: uid('acc'), name:`Partner Payable — ${p.name}`, type:'partner', currency:BASE_CURRENCY, openingBalance:0, createdAt: todayISO(), partnerId:p.id, system:true});
  }

  // Settings
  await dbPut('settings', {key:'visaAlertDays', value:90});
  await dbPut('settings', {key:'setupComplete', value:true});
}

/* Every partner needs a linked "Partner Payable" account (type:'partner') —
   it's what actually carries the running "company owes partner" balance and
   what Drawing/Deposit entries post their partner-side leg against. Seeding
   creates this for the two starter partners; this keeps it true for any
   partner added or renamed later from the Partners screen too. Reads/writes
   straight from IndexedDB (not STATE) so it's correct even right after a
   partner was just saved, before STATE has been refreshed. */
async function ensurePartnerAccount(partner){
  const accounts = await dbGetAll('accounts');
  let acc = accounts.find(a=>a.type==='partner' && a.partnerId===partner.id);
  const wantName = `Partner Payable — ${partner.name}`;
  if(!acc){
    const rate = partner.currency===BASE_CURRENCY ? 1 : getRate(partner.currency);
    acc = {
      id: uid('acc'), name: wantName, type:'partner', currency: BASE_CURRENCY,
      openingBalance: toBase(partner.openingCapital||0, rate),
      createdAt: todayISO(), partnerId: partner.id, system:true,
    };
    await dbPut('accounts', acc);
  } else if(acc.name !== wantName){
    acc.name = wantName;
    await dbPut('accounts', acc);
  }
  return acc;
}

/* ---------------------------------------------------------
   5. LEDGER / TRANSACTION POSTING (core accounting logic)
   direction: 'in' = money received into accountId
              'out' = money paid out of accountId
--------------------------------------------------------- */
async function postTransaction(tdata){
  const t = Object.assign({
    id: uid('txn'),
    date: todayISO(),
    createdAt: new Date().toISOString(),
  }, tdata);
  t.rate = t.currency === BASE_CURRENCY ? 1 : (t.rate || getRate(t.currency));
  t.amountBase = toBase(t.amount, t.rate);
  await dbPut('transactions', t);
  return t;
}

async function deleteTransactionsByRef(refId){
  const all = await dbGetByIndex('transactions','partyId', undefined).catch(()=>[]);
  // fallback: scan all (dataset expected to stay modest for a consultancy)
  const txns = await dbGetAll('transactions');
  const toDelete = txns.filter(t=>t.refId===refId);
  for(const t of toDelete) await dbDelete('transactions', t.id);
}

/* Account running balance as of (optional) end date, in account's native currency */
async function getAccountBalance(accountId, endDate){
  const acc = STATE.accounts.find(a=>a.id===accountId) || await dbGet('accounts', accountId);
  if(!acc) return 0;
  const txns = await dbGetByIndex('transactions','accountId', accountId);
  let bal = Number(acc.openingBalance)||0;
  txns.forEach(t=>{
    if(endDate && t.date > endDate) return;
    bal += (t.direction==='in' ? 1 : -1) * (Number(t.amount)||0);
  });
  return bal;
}

async function getAllAccountBalances(){
  const out = {};
  for(const acc of STATE.accounts){
    out[acc.id] = await getAccountBalance(acc.id);
  }
  return out;
}

/* Party (customer/vendor) outstanding balance in IDR.
   Convention: 'in' = they paid us (reduces receivable); 'out'/service charge = increases receivable.
   We track it simply as net of amountBase where direction 'out' from OUR perspective... 
   To keep this intuitive: for a customer, a service transaction where money comes IN from them reduces
   what they owe; an invoice/charge increases what they owe. We model charges as invoices separately,
   and receipts as transactions with partyType='customer'. */
async function getPartyLedger(partyType, partyId){
  const txns = await dbGetAll('transactions');
  const rows = [];
  txns.filter(t=>t.partyType===partyType && t.partyId===partyId).forEach(t=>{
    rows.push({
      date:t.date, type:t.type, refType:t.refType, refId:t.refId, description:t.description,
      currency:t.currency, amount:t.amount, amountBase:t.amountBase,
      debit: t.direction==='out' ? t.amountBase : 0,   // they owe more (we paid out / gave service)
      credit: t.direction==='in' ? t.amountBase : 0,   // they paid us
    });
  });
  if(partyType==='customer'){
    // Service charges (Total Amount) for the 10 standard services are the client's
    // debit even though only the Paid Amount moved through a real account.
    // (Invoices are generated FROM this ledger as a printable snapshot — they are
    // not a separate charge, so they are intentionally not added here.)
    const serviceEntries = await dbGetAll('serviceEntries');
    serviceEntries.filter(e=>e.customerId===partyId && e.finance && Number(e.finance.totalAmount)>0).forEach(e=>{
      const cfg = getServiceCfg(e.type);
      const rate = e.finance.currency===BASE_CURRENCY ? 1 : (e.finance.rate || getRate(e.finance.currency));
      rows.push({
        date: e.date, type:'service_charge', refType:'serviceEntry', refId:e.id,
        description:`${cfg?cfg.label:e.type} ${e.refNo} — Total Amount`,
        currency: e.finance.currency, amount: e.finance.totalAmount,
        amountBase: toBase(e.finance.totalAmount, rate),
        debit: toBase(e.finance.totalAmount, rate), credit:0,
      });
    });
  }
  rows.sort((a,b)=> (a.date||'').localeCompare(b.date||''));
  let running = 0;
  rows.forEach(r=>{ running += r.debit - r.credit; r.balance = running; });
  return rows;
}

/* Partner Drawing / Deposit — always a two-sided posting so it genuinely
   moves real money:
     1) a leg on the chosen bank/cash account, in that account's own
        currency — this is what actually changes the bank/cash balance.
     2) a mirrored leg (in USD) on the partner's own Partner Payable
        account, so "what the company owes the partner" moves too.
   Direction convention on the partner leg matches the one Fund Transfer
   already uses when sending money to a partner account: 'in' = the company
   owes the partner more (Deposit — partner put money into the business),
   'out' = the company owes the partner less (Drawing — partner took money
   out). Both legs share a refId so they can be displayed/deleted together. */
async function postPartnerCapitalTxn({date, partnerId, kind, accountId, currency, amount, rate, description}){
  const partner = STATE.partners.find(p=>p.id===partnerId) || await dbGet('partners', partnerId);
  const bankAcc = STATE.accounts.find(a=>a.id===accountId) || await dbGet('accounts', accountId);
  if(!partner) throw new Error('Select a partner');
  if(!bankAcc) throw new Error('Select a bank/cash account');
  if(!(Number(amount)>0)) throw new Error('Enter an amount');
  const partnerAcc = await ensurePartnerAccount(partner);
  rate = currency===BASE_CURRENCY ? 1 : (Number(rate) || getRate(currency));
  const amountBase = toBase(amount, rate);
  const rec = {
    id: uid('ptx'), date: date||todayISO(), partnerId, kind,
    accountId, currency, amount:Number(amount), rate, amountBase,
    description: description||'', createdAt: new Date().toISOString(),
  };
  await dbPut('partnerTxns', rec);
  const label = kind==='deposit' ? 'Partner Deposit' : 'Partner Drawing';
  // Leg 1: the real bank/cash account.
  await postTransaction({
    date: rec.date, type:'partner_capital', refType:'partnerTxn', refId:rec.id,
    accountId: bankAcc.id, currency, amount:Number(amount), rate,
    direction: kind==='deposit' ? 'in' : 'out',
    partyType:'partner', partyId: partnerId,
    description: `${label} — ${partner.name}${description?': '+description:''}`,
  });
  // Leg 2: the partner's own Partner Payable account (always USD/base).
  await postTransaction({
    date: rec.date, type:'partner_capital', refType:'partnerTxn', refId:rec.id,
    accountId: partnerAcc.id, currency: BASE_CURRENCY, amount:amountBase, rate:1,
    direction: kind==='deposit' ? 'in' : 'out',
    partyType:'partner', partyId: partnerId,
    description: `${label} via ${bankAcc.name}${description?': '+description:''}`,
  });
  return rec;
}

async function deletePartnerCapitalTxn(id){
  await deleteTransactionsByRef(id);
  await dbDelete('partnerTxns', id);
}

/* Partner Ledger rows — sourced straight from the partner's real Partner
   Payable account (like Cash & Bank Book does for any account), so it
   automatically includes Drawing/Deposit entries AND any other posting ever
   made against that account (e.g. a Fund Transfer settlement to the
   partner). Debit = Drawing (reduces what the company owes the partner),
   Credit = Deposit (increases it) — mirrors the 'out'/'in' convention
   getAccountBalance already uses for this account. */
async function getPartnerLedgerRows(partnerId){
  const accounts = await dbGetAll('accounts');
  const account = accounts.find(a=>a.type==='partner' && a.partnerId===partnerId);
  if(!account) return {rows:[], account:null};
  const txns = await dbGetByIndex('transactions','accountId', account.id);
  txns.sort((a,b)=> (a.date||'').localeCompare(b.date||'') || (a.createdAt||'').localeCompare(b.createdAt||''));
  const rows = [];
  let running = Number(account.openingBalance)||0;
  if(running){
    rows.push({date: account.createdAt||todayISO(), type:'opening', description:'Opening Balance', debit: running<0?-running:0, credit: running>0?running:0, balance: running});
  }
  txns.forEach(t=>{
    const debit = t.direction==='out' ? (Number(t.amount)||0) : 0;
    const credit = t.direction==='in' ? (Number(t.amount)||0) : 0;
    running += credit - debit;
    rows.push({date:t.date, type:t.type, refType:t.refType, refId:t.refId, description:t.description, debit, credit, balance: running});
  });
  return {rows, account};
}

