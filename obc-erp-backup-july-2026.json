          <div class="callout ${enabled?'callout-navy':'callout-amber'} mt-14">
            <div>
              <b>Status: ${enabled ? 'On' : 'Off'}</b>${enabled && handleRec ? ` — saving to <b>${esc(handleRec.fileName||'this file')}</b>` : ''}
              ${enabled ? `<div id="autosave-status-pill" class="faint mt-8" style="font-size:11.5px;">Saved</div>` : ''}
            </div>
          </div>
          <div class="flex gap-10 mt-14" style="flex-wrap:wrap;">
            ${enabled ? `
              <button class="btn" id="as-savenow">Save Now</button>
              <button class="btn btn-danger" id="as-off2">Turn Off</button>
            ` : `
              <button class="btn btn-primary" id="as-on2">Enable Automatic Saving</button>
            `}
          </div>
          `}
        </div>`;
      if(supported){
