      <div class="card"><div class="card-title mb-0" style="font-size:13.5px;">Top Payables (Vendors)</div><div class="mt-14">${topPayable.length?svgBarChart(topPayable):'<div class="muted" style="padding:20px;text-align:center;">All clear</div>'}</div></div>
    </div>
    <div class="grid grid-2 mt-14">
      <div class="card">
        <div class="card-header"><span class="card-title">Receivable — Customers</span><button class="btn btn-sm" id="rp_print_c">&#128424; Print</button></div>
        <div class="table-wrap"><table><thead><tr><th>Customer</th><th class="num">Balance (USD)</th></tr></thead>
          <tbody>${custRows.length? custRows.sort((a,b)=>b.balance-a.balance).map(r=>`<tr><td>${esc(r.name)}</td><td class="num"><span class="badge ${r.balance>0?'badge-amber':'badge-green'}">${fmtMoney(r.balance,'USD')}</span></td></tr>`).join('') : `<tr class="empty-row"><td colspan="2">All clear — no outstanding balances.</td></tr>`}</tbody>
        </table></div>
      </div>
      <div class="card">
        <div class="card-header"><span class="card-title">Payable — Vendors</span><button class="btn btn-sm" id="rp_print_v">&#128424; Print</button></div>
        <div class="table-wrap"><table><thead><tr><th>Vendor</th><th class="num">Balance (USD)</th></tr></thead>
          <tbody>${vendRows.length? vendRows.sort((a,b)=>b.balance-a.balance).map(r=>`<tr><td>${esc(r.name)}</td><td class="num"><span class="badge ${r.balance>0?'badge-red':'badge-green'}">${fmtMoney(r.balance,'USD')}</span></td></tr>`).join('') : `<tr class="empty-row"><td colspan="2">All clear — no outstanding balances.</td></tr>`}</tbody>
        </table></div>
