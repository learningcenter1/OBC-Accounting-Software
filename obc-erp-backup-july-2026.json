    paidBySel.addEventListener('change', ()=>{
      if(paidBySel.value==='company'){
        sourceWrap.innerHTML = `<label>Company Account</label><select id="ex_acc">${accountOptionsHTML('')}</select>`;
      } else {
        sourceWrap.innerHTML = `<label>Which Partner Paid?</label><select id="ex_acc">${partnerOptionsHTML('')}</select>`;
      }
    });
    document.getElementById('ex_cur').addEventListener('change', ()=>{});
    document.getElementById('ex-cancel').onclick = close;
    document.getElementById('ex-save').onclick = async ()=>{
      const amount = Number(document.getElementById('ex_amt').value)||0;
      const desc = document.getElementById('ex_desc').value.trim();
      const currency = document.getElementById('ex_cur').value;
      const paidBy = paidBySel.value;
      const srcVal = document.getElementById('ex_acc').value;
      if(!amount || !desc || !srcVal){ toast('Please fill amount, description, and payer','error'); return; }
      const rec = {id: uid('exp'), date: document.getElementById('ex_date').value||todayISO(), category: document.getElementById('ex_cat').value,
        description: desc, currency, amount, paidBy, createdAt: new Date().toISOString()};
      if(paidBy==='company'){
        rec.accountId = srcVal;
        await dbPut('expenses', rec);
        await postTransaction({date:rec.date, type:'expense', refType:'expense', refId:rec.id, accountId:srcVal, currency, amount, rate:getRate(currency), direction:'out', description:`Expense: ${desc}`});
      } else {
        rec.partnerId = srcVal;
        await dbPut('expenses', rec);
        const partnerAcc = STATE.accounts.find(a=>a.partnerId===srcVal);
        if(partnerAcc){
          await postTransaction({date:rec.date, type:'expense', refType:'expense', refId:rec.id, accountId:partnerAcc.id, currency, amount, rate:getRate(currency), direction:'in', description:`Expense paid by partner: ${desc}`});
        }
      }
      toast('Expense recorded','success'); close(); renderRoute();
    };
  };
};

/* ---------------------------------------------------------
   16. INVOICING — auto-built from the customer's own ledger.
   No manual line items: pick a customer + invoice number and the
   system pulls every charge and payment on file for them (service
   Total Amounts, receipts, loan movements, general receipts/payments)
   into a numbered, printable statement that ends with the running
   balance — effectively invoice + receipt in one document.
--------------------------------------------------------- */
ROUTE_RENDERERS['invoicing'] = async function(container){
  const invoices = (await dbGetAll('invoices')).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <div class="toolbar-left">
          <h2 class="card-title" style="font-size:16px;">Invoices <span class="muted" style="font-weight:500;font-size:12px;">(${invoices.length})</span></h2>
        </div>
        <button class="btn btn-primary" id="inv-add">+ New Invoice</button>
      </div>
      <p class="muted mt-0">Pick a customer and an invoice number — the invoice is built automatically from their service charges and payments on file, ending with their balance due.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Invoice No.</th><th>Date</th><th>Customer</th><th class="num">Total Charged</th><th class="num">Total Paid</th><th class="num">Balance</th><th></th></tr></thead>
        <tbody>${invoices.length? invoices.map(i=>{
          const cust = STATE.customers.find(c=>c.id===i.customerId);
          return `<tr><td class="mono">${esc(i.invoiceNo)}</td><td>${fmtDate(i.date)}</td><td>${cust?esc(cust.name):'—'}</td>
          <td class="num">${fmtMoney(i.totalDebit,'USD')}</td>
          <td class="num">${fmtMoney(i.totalCredit,'USD')}</td>
          <td class="num"><span class="badge ${i.closingBalance>0?'badge-amber':'badge-green'}">${fmtMoney(i.closingBalance,'USD')}</span></td>
          <td class="row-actions"><button class="icon-btn inv-print" data-id="${i.id}" title="Print">&#128424;</button></td></tr>`;
        }).join('') : `<tr class="empty-row"><td colspan="7">No invoices yet.</td></tr>`}</tbody>
      </table></div>
    </div>`;
  container.querySelectorAll('.inv-print').forEach(b=>b.onclick=async()=>{
    const inv = await dbGet('invoices', b.dataset.id);
    printInvoice(inv);
  });

  container.querySelector('#inv-add').onclick = async ()=>{
    const nextNo = await peekNextRefNo('invoice','INV');
    const body = `
      <div class="form-grid">
        <div class="field"><label>Invoice No. *</label><input type="text" id="iv_no" value="${nextNo}">
          <span class="hint">Next available — you may override (duplicates are blocked).</span></div>
        <div class="field"><label>Invoice Date *</label><input type="date" id="iv_date" value="${todayISO()}"></div>
        <div class="field span-2"><label>Customer *</label><select id="iv_cust">${customerOptionsHTML('')}</select></div>
        <div class="field"><label>Include From (optional)</label><input type="date" id="iv_from"></div>
        <div class="field"><label>Include Up To</label><input type="date" id="iv_to" value="${todayISO()}"></div>
      </div>
      <div class="callout callout-navy">The invoice will automatically list every service charge and payment on file for this customer in the date range above (leave "Include From" blank to include everything since day one), and end with their balance due.</div>
      <div class="form-actions"><button class="btn" id="iv-cancel">Cancel</button><button class="btn btn-primary" id="iv-save">Generate Invoice</button></div>`;
    const {close} = openModal('New Invoice', body);
    document.getElementById('iv-cancel').onclick = close;
    document.getElementById('iv-save').onclick = async ()=>{
      const invoiceNo = document.getElementById('iv_no').value.trim();
      const customerId = document.getElementById('iv_cust').value;
      if(!invoiceNo || !customerId){ toast('Invoice number and customer are required','error'); return; }
      const existing = await dbGetByIndex('invoices','invoiceNo', invoiceNo);
      if(existing.length>0){ toast('That invoice number already exists — choose another.','error'); return; }
      const date = document.getElementById('iv_date').value || todayISO();
      const from = document.getElementById('iv_from').value || null;
      const to = document.getElementById('iv_to').value || todayISO();
      let rows = await getPartyLedger('customer', customerId);
      if(from) rows = rows.filter(r=>r.date>=from);
      rows = rows.filter(r=>r.date<=to);
      // re-baseline running balance to this statement's own opening point
      let running = 0;
      rows = rows.map(r=>{ running += r.debit - r.credit; return {...r, balance: running}; });
      const totalDebit = rows.reduce((s,r)=>s+r.debit,0), totalCredit = rows.reduce((s,r)=>s+r.credit,0);
      const rec = {
        id: uid('inv'), invoiceNo, date, customerId, fromDate: from, toDate: to,
        rows, totalDebit, totalCredit, closingBalance: totalDebit-totalCredit,
        createdAt: new Date().toISOString(),
      };
      await dbPut('invoices', rec);
      // bump the yearly invoice counter so the next suggestion advances even if this number was overridden lower
      const year = new Date(date).getFullYear();
      const ck = 'invoice_'+year;
      const c = await dbGet('counters', ck);
      const currentMax = c ? c.value : 0;
      const numPart = parseInt((invoiceNo.match(/(\d+)$/)||[0,currentMax])[1], 10);
      if(numPart > currentMax) await dbPut('counters', {key:ck, value:numPart});
      toast(`Invoice ${invoiceNo} generated`,'success');
      close();
      printInvoice(rec);
      renderRoute();
    };
  };
};

function printInvoice(inv){
  const cust = STATE.customers.find(c=>c.id===inv.customerId);
  const rows = inv.rows||[];
  const charges = rows.filter(r=>r.debit>0);
  const payments = rows.filter(r=>r.credit>0);
  const chargeRowsHtml = charges.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td><td class="num">${fmtMoney(r.debit,'USD')}</td></tr>`).join('');
  const paymentRowsHtml = payments.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td><td class="num">${fmtMoney(r.credit,'USD')}</td></tr>`).join('');
  const html = `
    <div class="print-doc">
      ${printHeaderHTML('INVOICE / STATEMENT', inv.invoiceNo, inv.date, {hideWhatsapp:true})}
      <p><b>Bill To:</b> ${cust?esc(cust.name):'—'}${cust&&cust.address?('<br>'+esc(cust.address)):''}${cust&&cust.phone?('<br>Tel: '+esc(cust.phone)):''}${cust&&cust.whatsapp?('<br>WhatsApp: '+esc(cust.whatsapp)):''}</p>
      <p class="muted" style="font-size:11px;">Period: ${inv.fromDate?fmtDate(inv.fromDate):'Inception'} — ${fmtDate(inv.toDate||inv.date)}</p>

      <p style="margin:16px 0 4px;font-weight:800;color:var(--navy);text-transform:uppercase;font-size:11.5px;letter-spacing:0.04em;">Services / Charges</p>
      <table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th></tr></thead>
        <tbody>${chargeRowsHtml || `<tr><td colspan="3" style="text-align:center;color:#999;">No charges in this period.</td></tr>`}</tbody>
      </table>
      <div class="totals"><div class="grand"><span>Subtotal</span><span>${fmtMoney(inv.totalDebit,'USD')}</span></div></div>

      <p style="margin:22px 0 4px;font-weight:800;color:var(--navy);text-transform:uppercase;font-size:11.5px;letter-spacing:0.04em;">Amount Received (Receipt)</p>
      <table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">Amount</th></tr></thead>
        <tbody>${paymentRowsHtml || `<tr><td colspan="3" style="text-align:center;color:#999;">No payments received in this period.</td></tr>`}</tbody>
      </table>
      <div class="totals">
        <div><span>Total Received</span><span>${fmtMoney(inv.totalCredit,'USD')}</span></div>
        <div class="grand"><span>${inv.closingBalance>0?'Balance Due':'Credit Balance'}</span><span>${fmtMoney(Math.abs(inv.closingBalance),'USD')}</span></div>
      </div>
      <div class="ph-footer">Thank you for choosing ${esc(COMPANY.name)}. Tel: ${esc(COMPANY.phone)}</div>
    </div>`;
  doPrint(html);
}

/* ---------------------------------------------------------
   17. LEDGERS
--------------------------------------------------------- */
ROUTE_RENDERERS['ledger'] = async function(container, kind){
  if(kind==='customer') return renderPartyLedger(container,'customer');
  if(kind==='vendor') return renderPartyLedger(container,'vendor');
  if(kind==='loan') return renderLoanLedger(container);
  if(kind==='account') return renderAccountBook(container);
  container.innerHTML = `<div class="callout callout-amber">Unknown ledger.</div>`;
};

async function renderPartyLedger(container, partyType){
  const list = partyType==='customer' ? STATE.customers : STATE.vendors;
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">${partyType==='customer'?'Customer':'Vendor'} Ledger</h2>
        <div class="toolbar-left">
          <select id="pl_party" style="min-width:220px;">
            <option value="">— Select ${partyType} —</option>
            ${list.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('')}
          </select>
          <input type="date" id="pl_from"><span class="muted">to</span><input type="date" id="pl_to">
          <button class="btn btn-sm" id="pl_print">&#128424; Print</button>
        </div>
      </div>
      <div id="pl_body"><div class="muted" style="padding:30px;text-align:center;">Select a ${partyType} to view their ledger.</div></div>
    </div>`;
  async function refresh(){
    const pid = document.getElementById('pl_party').value;
    const body = document.getElementById('pl_body');
    if(!pid){ body.innerHTML = `<div class="muted" style="padding:30px;text-align:center;">Select a ${partyType} to view their ledger.</div>`; return; }
    let rows = await getPartyLedger(partyType, pid);
    const from = document.getElementById('pl_from').value, to = document.getElementById('pl_to').value;
    if(from) rows = rows.filter(r=>r.date>=from);
    if(to) rows = rows.filter(r=>r.date<=to);
    const party = list.find(p=>p.id===pid);
    const totalDebit = rows.reduce((s,r)=>s+r.debit,0), totalCredit = rows.reduce((s,r)=>s+r.credit,0);
    body.innerHTML = `
      <div class="grid grid-3 mt-0">
        <div class="stat-card" style="--accent:var(--amber);"><div class="stat-label">Total ${partyType==='customer'?'Charged':'Billed'}</div><div class="stat-value">${fmtMoney(totalDebit,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Total ${partyType==='customer'?'Received':'Paid'}</div><div class="stat-value">${fmtMoney(totalCredit,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">Closing Balance</div><div class="stat-value">${fmtMoney(rows.length?rows[rows.length-1].balance:0,'USD')}</div></div>
      </div>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">Debit (USD)</th><th class="num">Credit (USD)</th><th class="num">Balance (USD)</th></tr></thead>
        <tbody>${rows.length? rows.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td>
          <td class="num">${r.debit?fmtMoney(r.debit,'USD'):'—'}</td><td class="num">${r.credit?fmtMoney(r.credit,'USD'):'—'}</td>
          <td class="num"><b>${fmtMoney(r.balance,'USD')}</b></td></tr>`).join('') : `<tr class="empty-row"><td colspan="5">No transactions in this period.</td></tr>`}</tbody>
      </table></div>`;
    document.getElementById('pl_print').onclick = ()=>printLedger(`${partyType==='customer'?'Customer':'Vendor'} Ledger — ${party.name}`, rows, totalDebit, totalCredit);
  }
  document.getElementById('pl_party').addEventListener('change', refresh);
  document.getElementById('pl_from').addEventListener('change', refresh);
  document.getElementById('pl_to').addEventListener('change', refresh);
}

function printLedger(title, rows, totalDebit, totalCredit){
  const body = `
    <div class="print-doc">
      ${printHeaderHTML(title, '', todayISO())}
      <table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th></tr></thead>
        <tbody>${rows.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td>
          <td class="num">${r.debit?fmtMoney(r.debit,'USD'):''}</td><td class="num">${r.credit?fmtMoney(r.credit,'USD'):''}</td>
          <td class="num">${fmtMoney(r.balance,'USD')}</td></tr>`).join('')}</tbody>
      </table>
      <div class="totals">
        <div><span>Total Debit</span><span>${fmtMoney(totalDebit,'USD')}</span></div>
        <div><span>Total Credit</span><span>${fmtMoney(totalCredit,'USD')}</span></div>
        <div class="grand"><span>Closing Balance</span><span>${fmtMoney(rows.length?rows[rows.length-1].balance:0,'USD')}</span></div>
      </div>
    </div>`;
  doPrint(body);
}

async function renderLoanLedger(container){
  const loans = (await dbGetByIndex('serviceEntries','type','loan')).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  const allTxns = await dbGetAll('transactions');
  container.innerHTML = `
    <div class="card">
      <h2 class="card-title" style="font-size:16px;">Loan Given / Loan Taken — Ledger</h2>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Ref No.</th><th>Date</th><th>Party</th><th>Direction</th><th class="num">Principal</th><th class="num">Repaid (USD)</th><th class="num">Outstanding (USD)</th><th>Status</th><th></th></tr></thead>
        <tbody id="loan-tbody"></tbody>
      </table></div>
    </div>`;
  function computeLoan(entry){
    const txns = allTxns.filter(t=>t.refId===entry.id);
    let netFlow = 0;
    txns.forEach(t=> netFlow += (t.direction==='out' ? 1 : -1) * (t.amountBase||0));
    const given = entry.data.loanDirection==='Loan Given';
    const outstanding = given ? netFlow : -netFlow;
    const principalBase = entry.receipt ? toBase(entry.receipt.amount, entry.receipt.rate) : 0;
    const repaid = Math.max(0, principalBase - outstanding);
    return {outstanding, repaid};
  }
  function rows(){
    if(loans.length===0) return `<tr class="empty-row"><td colspan="9">No loans recorded yet. Add one from Services → Loan Given / Loan Taken.</td></tr>`;
    return loans.map(l=>{
      const cust = STATE.customers.find(c=>c.id===l.customerId);
      const {outstanding, repaid} = computeLoan(l);
      return `<tr>
        <td class="mono">${esc(l.refNo)}</td><td>${fmtDate(l.date)}</td>
        <td>${cust?esc(cust.name):esc(l.data.cnicPassportNo||'—')}</td>
        <td><span class="badge ${l.data.loanDirection==='Loan Given'?'badge-amber':'badge-navy'}">${esc(l.data.loanDirection||'—')}</span></td>
        <td class="num">${l.receipt?fmtMoney(l.receipt.amount,l.receipt.currency):'—'}</td>
        <td class="num">${fmtMoney(repaid,'USD')}</td>
        <td class="num"><b>${fmtMoney(outstanding,'USD')}</b></td>
        <td><span class="badge ${outstanding<=0?'badge-green':'badge-amber'}">${outstanding<=0?'Settled':esc(l.data.loanStatus||'Open')}</span></td>
        <td><button class="btn btn-sm loan-repay" data-id="${l.id}">+ Repayment</button></td>
      </tr>`;
    }).join('');
  }
  container.querySelector('#loan-tbody').innerHTML = rows();
  container.querySelectorAll('.loan-repay').forEach(b=>b.onclick=()=>openRepaymentForm(loans.find(l=>l.id===b.dataset.id)));

  function openRepaymentForm(loan){
    const given = loan.data.loanDirection==='Loan Given';
    const body = `
      <div class="form-grid">
        <div class="field"><label>Date *</label><input type="date" id="rp2_date" value="${todayISO()}"></div>
        <div class="field"><label>Account *</label><select id="rp2_acc">${accountOptionsHTML('')}</select></div>
        <div class="field"><label>Currency</label><select id="rp2_cur">${currencyOptionsHTML(loan.receipt?loan.receipt.currency:BASE_CURRENCY)}</select></div>
        <div class="field"><label>Amount *</label><input type="number" step="any" id="rp2_amt"></div>
        <div class="field"><label>Rate → USD</label><input type="number" step="any" id="rp2_rate" value="${loan.receipt?loan.receipt.rate:1}"></div>
      </div>
      <div class="callout callout-navy">${given?'Recording money received back from the borrower.':'Recording money paid back to the lender.'}</div>
      <div class="form-actions"><button class="btn" id="rp2-cancel">Cancel</button><button class="btn btn-primary" id="rp2-save">Save Repayment</button></div>`;
    const {close} = openModal(`Repayment — ${loan.refNo}`, body);
    document.getElementById('rp2_cur').addEventListener('change', e=>{ document.getElementById('rp2_rate').value = getRate(e.target.value)||1; });
    document.getElementById('rp2-cancel').onclick = close;
    document.getElementById('rp2-save').onclick = async ()=>{
      const amount = Number(document.getElementById('rp2_amt').value)||0;
      const accountId = document.getElementById('rp2_acc').value;
      if(!amount||!accountId){ toast('Amount and account are required','error'); return; }
      await postTransaction({
        date: document.getElementById('rp2_date').value||todayISO(), type:'loan_repayment', refType:'serviceEntry', refId:loan.id,
        accountId, currency: document.getElementById('rp2_cur').value, amount, rate: Number(document.getElementById('rp2_rate').value)||1,
        direction: given ? 'in' : 'out', partyType:'customer', partyId: loan.customerId,
        description: `Loan repayment — ${loan.refNo}`,
      });
      toast('Repayment recorded','success'); close(); renderRoute();
    };
  }
}

async function renderAccountBook(container){
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Cash &amp; Bank Book</h2>
        <div class="toolbar-left">
          <select id="ab_acc" style="min-width:220px;">
            <option value="">— Select account —</option>
            ${STATE.accounts.map(a=>`<option value="${a.id}">${esc(a.name)} (${a.currency})</option>`).join('')}
          </select>
          <div class="pill-tabs" id="ab_period">
            <button class="pill active" data-p="all">All</button>
            <button class="pill" data-p="daily">Today</button>
            <button class="pill" data-p="weekly">This Week</button>
            <button class="pill" data-p="monthly">This Month</button>
            <button class="pill" data-p="yearly">This Year</button>
          </div>
          <input type="date" id="ab_from"><span class="muted">to</span><input type="date" id="ab_to">
          <button class="btn btn-sm" id="ab_print">&#128424; Print</button>
        </div>
      </div>
      <div id="ab_body"><div class="muted" style="padding:30px;text-align:center;">Select an account to view its book.</div></div>
    </div>`;
  let period = 'all';
  function periodRange(){
    const now = new Date(); const y=now.getFullYear(), m=now.getMonth(), d=now.getDate();
    if(period==='daily') return [todayISO(), todayISO()];
    if(period==='weekly'){ const start = new Date(now); start.setDate(d-now.getDay()); return [localISO(start), todayISO()]; }
    if(period==='monthly') return [localISO(new Date(y,m,1)), todayISO()];
    if(period==='yearly') return [localISO(new Date(y,0,1)), todayISO()];
    return [null,null];
  }
  async function refresh(){
    const accId = document.getElementById('ab_acc').value;
    const body = document.getElementById('ab_body');
    if(!accId){ body.innerHTML = `<div class="muted" style="padding:30px;text-align:center;">Select an account to view its book.</div>`; return; }
    const acc = STATE.accounts.find(a=>a.id===accId);
    let txns = (await dbGetByIndex('transactions','accountId', accId)).sort((a,b)=>(a.date||'').localeCompare(b.date||''));
    const [pFrom,pTo] = periodRange();
    const from = document.getElementById('ab_from').value || pFrom;
    const to = document.getElementById('ab_to').value || pTo;
    let openingBal = Number(acc.openingBalance)||0;
    if(from){
      txns.filter(t=>t.date<from).forEach(t=> openingBal += (t.direction==='in'?1:-1)*t.amount );
    }
    let filtered = txns;
    if(from) filtered = filtered.filter(t=>t.date>=from);
    if(to) filtered = filtered.filter(t=>t.date<=to);
    let running = openingBal;
    const rows = filtered.map(t=>{
      running += (t.direction==='in'?1:-1)*t.amount;
      return {...t, balance: running};
    });
    const totalIn = filtered.filter(t=>t.direction==='in').reduce((s,t)=>s+t.amount,0);
    const totalOut = filtered.filter(t=>t.direction==='out').reduce((s,t)=>s+t.amount,0);
    body.innerHTML = `
      <div class="grid grid-4 mt-0">
        <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">Opening Balance</div><div class="stat-value">${fmtMoney(openingBal, acc.currency)}</div></div>
        <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Total In</div><div class="stat-value">${fmtMoney(totalIn, acc.currency)}</div></div>
        <div class="stat-card" style="--accent:var(--red);"><div class="stat-label">Total Out</div><div class="stat-value">${fmtMoney(totalOut, acc.currency)}</div></div>
        <div class="stat-card" style="--accent:var(--orange);"><div class="stat-label">Closing Balance</div><div class="stat-value">${fmtMoney(running, acc.currency)}</div></div>
      </div>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">In</th><th class="num">Out</th><th class="num">Balance</th></tr></thead>
        <tbody>${rows.length? rows.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td>
          <td class="num">${r.direction==='in'?fmtMoney(r.amount, acc.currency):'—'}</td>
          <td class="num">${r.direction==='out'?fmtMoney(r.amount, acc.currency):'—'}</td>
          <td class="num"><b>${fmtMoney(r.balance, acc.currency)}</b></td></tr>`).join('') : `<tr class="empty-row"><td colspan="5">No transactions in this period.</td></tr>`}</tbody>
      </table></div>`;
    document.getElementById('ab_print').onclick = ()=>{
      const html = `<div class="print-doc">${printHeaderHTML('Account Book — '+acc.name,'',todayISO())}
        <table><thead><tr><th>Date</th><th>Description</th><th class="num">In</th><th class="num">Out</th><th class="num">Balance</th></tr></thead>
        <tbody>${rows.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td><td class="num">${r.direction==='in'?fmtMoney(r.amount,acc.currency):''}</td><td class="num">${r.direction==='out'?fmtMoney(r.amount,acc.currency):''}</td><td class="num">${fmtMoney(r.balance,acc.currency)}</td></tr>`).join('')}</tbody></table>
        <div class="totals"><div><span>Opening</span><span>${fmtMoney(openingBal,acc.currency)}</span></div><div><span>Total In</span><span>${fmtMoney(totalIn,acc.currency)}</span></div><div><span>Total Out</span><span>${fmtMoney(totalOut,acc.currency)}</span></div><div class="grand"><span>Closing</span><span>${fmtMoney(running,acc.currency)}</span></div></div></div>`;
      doPrint(html);
    };
  }
  document.getElementById('ab_acc').addEventListener('change', refresh);
  document.getElementById('ab_from').addEventListener('change', refresh);
  document.getElementById('ab_to').addEventListener('change', refresh);
  container.querySelectorAll('#ab_period .pill').forEach(p=>p.onclick=()=>{
    container.querySelectorAll('#ab_period .pill').forEach(x=>x.classList.remove('active'));
    p.classList.add('active'); period = p.dataset.p;
    document.getElementById('ab_from').value=''; document.getElementById('ab_to').value='';
    refresh();
  });
}

/* ---------------------------------------------------------
   18. REPORTS
--------------------------------------------------------- */
ROUTE_RENDERERS['reports'] = async function(container, kind){
  if(kind==='services') return renderServiceReports(container);
  if(kind==='profit-loss') return renderProfitLossReport(container);
  if(kind==='day-book') return renderDayBookReport(container);
  if(kind==='receivable-payable') return renderReceivablePayableReport(container);
  if(kind==='partner-ledger') return renderPartnerLedger(container);
  container.innerHTML = `<div class="callout callout-amber">Unknown report.</div>`;
};

/* ---------------------------------------------------------
   18f. PARTNER LEDGER REPORT
   Per-partner running ledger of every Drawing/Deposit (and anything else
   ever posted to that partner's Partner Payable account, e.g. a Fund
   Transfer settlement) with a closing "company owes partner" balance.
--------------------------------------------------------- */
async function renderPartnerLedger(container){
  const partners = await dbGetAll('partners');
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Partner Ledger</h2>
        <div class="toolbar-left">
          <select id="pnl_partner" style="min-width:220px;">
            <option value="">— Select partner —</option>
            ${partners.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join('')}
          </select>
          <input type="date" id="pnl_from"><span class="muted">to</span><input type="date" id="pnl_to">
          <button class="btn btn-sm" id="pnl_print">&#128424; Print</button>
          <button class="btn btn-sm btn-primary" id="pnl_new">+ Drawing / Deposit</button>
        </div>
      </div>
      <p class="muted mt-0">Every Drawing and Deposit posts here automatically, straight from that partner's own Partner Payable account.</p>
      <div id="pnl_body"><div class="muted" style="padding:30px;text-align:center;">Select a partner to view their ledger.</div></div>
    </div>`;

  container.querySelector('#pnl_new').onclick = ()=>navigate('partner-capital');

  async function refresh(){
    const pid = document.getElementById('pnl_partner').value;
    const body = document.getElementById('pnl_body');
    if(!pid){ body.innerHTML = `<div class="muted" style="padding:30px;text-align:center;">Select a partner to view their ledger.</div>`; return; }
    const partner = partners.find(p=>p.id===pid);
    const {rows: allRows, account} = await getPartnerLedgerRows(pid);
    if(!account){
      body.innerHTML = `<div class="callout callout-amber">No Partner Payable account is linked yet for ${esc(partner.name)} — open them in Master Data → Partners and click Save once to create one.</div>`;
      return;
    }
    let rows = allRows;
    const from = document.getElementById('pnl_from').value, to = document.getElementById('pnl_to').value;
    if(from) rows = rows.filter(r=>r.date>=from);
    if(to) rows = rows.filter(r=>r.date<=to);
    const totalDeposit = rows.reduce((s,r)=>s+r.credit,0), totalDrawing = rows.reduce((s,r)=>s+r.debit,0);
    const closing = rows.length ? rows[rows.length-1].balance : (Number(account.openingBalance)||0);
    body.innerHTML = `
      <div class="grid grid-3 mt-0">
        <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Total Deposits</div><div class="stat-value">${fmtMoney(totalDeposit,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--red);"><div class="stat-label">Total Drawings</div><div class="stat-value">${fmtMoney(totalDrawing,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">${closing>=0?'Company Owes Partner':'Partner Owes Company'}</div><div class="stat-value">${fmtMoney(Math.abs(closing),'USD')}</div></div>
      </div>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Date</th><th>Description</th><th class="num">Drawing (Debit)</th><th class="num">Deposit (Credit)</th><th class="num">Balance (USD)</th></tr></thead>
        <tbody>${rows.length? rows.map(r=>`<tr><td>${fmtDate(r.date)}</td><td>${esc(r.description)}</td>
          <td class="num">${r.debit?fmtMoney(r.debit,'USD'):'—'}</td><td class="num">${r.credit?fmtMoney(r.credit,'USD'):'—'}</td>
          <td class="num"><b>${fmtMoney(r.balance,'USD')}</b></td></tr>`).join('') : `<tr class="empty-row"><td colspan="5">No transactions in this period.</td></tr>`}</tbody>
      </table></div>`;
    document.getElementById('pnl_print').onclick = ()=>printLedger(`Partner Ledger — ${partner.name}`, rows, totalDrawing, totalDeposit);
  }
  document.getElementById('pnl_partner').addEventListener('change', refresh);
  document.getElementById('pnl_from').addEventListener('change', refresh);
  document.getElementById('pnl_to').addEventListener('change', refresh);
}

/* ---------------------------------------------------------
   18b. PROFIT & LOSS REPORT
   Revenue = service "Paid Amount" receipts (excluding loans, which are
   balance-sheet movements) + realized Money Exchange gains + general
   receipts. Expenses = the Expenses register + realized Money Exchange
   losses + general payments. Loan disbursement/repayment and internal
   Fund Transfers are intentionally excluded — they don't affect P&L.
--------------------------------------------------------- */
async function renderProfitLossReport(container){
  container.innerHTML = `
    <div class="card">
      <div class="toolbar"><h2 class="card-title" style="font-size:16px;">Profit &amp; Loss</h2></div>
      <div class="toolbar-left mt-0" style="margin-bottom:14px;">
        ${periodPillsHTML('pl_period')}
        <input type="date" id="pl_from"><span class="muted">to</span><input type="date" id="pl_to">
        <button class="btn btn-sm" id="pl_print">&#128424; Print</button>
      </div>
      <div id="pl_body"></div>
    </div>`;

  async function refresh(from, to){
    const [txns, expenses, accounts] = await Promise.all([dbGetAll('transactions'), dbGetAll('expenses'), dbGetAll('accounts')]);
    const glAcc = accounts.find(a=>a.name==='Exchange Gain / Loss');
    const inRange = (d)=> (!from || d>=from) && (!to || d<=to);

    const serviceRevenueTxns = txns.filter(t=> t.type==='service' && t.serviceType!=='loan' && t.direction==='in' && inRange(t.date));
    const generalIncomeTxns = txns.filter(t=> t.type==='general' && t.direction==='in' && inRange(t.date));
    const generalExpenseTxns = txns.filter(t=> t.type==='general' && t.direction==='out' && inRange(t.date));
    const exchangeGainTxns = glAcc ? txns.filter(t=> t.accountId===glAcc.id && t.direction==='in' && inRange(t.date)) : [];
    const exchangeLossTxns = glAcc ? txns.filter(t=> t.accountId===glAcc.id && t.direction==='out' && inRange(t.date)) : [];
    const expensesInRange = expenses.filter(e=> inRange(e.date));

    const serviceRevenue = serviceRevenueTxns.reduce((s,t)=>s+(t.amountBase||0),0);
    const otherIncome = generalIncomeTxns.reduce((s,t)=>s+(t.amountBase||0),0);
    const exchangeGain = exchangeGainTxns.reduce((s,t)=>s+(t.amountBase||0),0);
    const totalIncome = serviceRevenue + otherIncome + exchangeGain;

    const operatingExpenses = expensesInRange.reduce((s,e)=>s+toBase(e.amount, e.currency===BASE_CURRENCY?1:getRate(e.currency)),0);
    const otherExpense = generalExpenseTxns.reduce((s,t)=>s+(t.amountBase||0),0);
    const exchangeLoss = exchangeLossTxns.reduce((s,t)=>s+(t.amountBase||0),0);
    const totalExpense = operatingExpenses + otherExpense + exchangeLoss;

    const netProfit = totalIncome - totalExpense;

    // Chart 1: Income vs Expense bar
    const barData = [{label:'Income', value:totalIncome},{label:'Expense', value:totalExpense}];
    // Chart 2: Expense breakdown by category
    const byCat = {};
    expensesInRange.forEach(e=>{ const c = e.category || 'General'; byCat[c] = (byCat[c]||0) + toBase(e.amount, e.currency===BASE_CURRENCY?1:getRate(e.currency)); });
    const pieData = Object.entries(byCat).map(([label,value])=>({label,value}));
    // Chart 3: Net profit trend by month across the range (or all-time if no range)
    const trendFrom = from || (serviceRevenueTxns.concat(expensesInRange.map(e=>({date:e.date}))).map(x=>x.date).sort()[0]) || todayISO();
    const trendTo = to || todayISO();
    const months = [];
    { let cy = +trendFrom.slice(0,4), cm = +trendFrom.slice(5,7); const ey = +trendTo.slice(0,4), em = +trendTo.slice(5,7);
      while((cy<ey || (cy===ey && cm<=em)) && months.length<24){ months.push(cy+'-'+String(cm).padStart(2,'0')); cm++; if(cm>12){ cm=1; cy++; } } }
    const lineData = months.map(mk=>{
      const mFrom = mk+'-01', mTo = localISO(new Date(+mk.slice(0,4), +mk.slice(5,7), 0));
      const inc = txns.filter(t=>((t.type==='service'&&t.serviceType!=='loan'&&t.direction==='in')||(t.type==='general'&&t.direction==='in')||(glAcc&&t.accountId===glAcc.id&&t.direction==='in')) && t.date>=mFrom && t.date<=mTo).reduce((s,t)=>s+(t.amountBase||0),0);
      const exp = expenses.filter(e=>e.date>=mFrom && e.date<=mTo).reduce((s,e)=>s+toBase(e.amount, e.currency===BASE_CURRENCY?1:getRate(e.currency)),0)
        + txns.filter(t=>((t.type==='general'&&t.direction==='out')||(glAcc&&t.accountId===glAcc.id&&t.direction==='out')) && t.date>=mFrom && t.date<=mTo).reduce((s,t)=>s+(t.amountBase||0),0);
      return {label: new Date(+mk.slice(0,4), +mk.slice(5,7)-1, 1).toLocaleDateString('en-GB',{month:'short',year:'2-digit'}), value: inc-exp};
    });

    document.getElementById('pl_body').innerHTML = `
      <div class="grid grid-3 mt-0">
        <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Total Income</div><div class="stat-value">${fmtMoney(totalIncome,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--red);"><div class="stat-label">Total Expense</div><div class="stat-value">${fmtMoney(totalExpense,'USD')}</div></div>
        <div class="stat-card" style="--accent:${netProfit>=0?'var(--green)':'var(--red)'};"><div class="stat-label">Net ${netProfit>=0?'Profit':'Loss'}</div><div class="stat-value">${fmtMoney(Math.abs(netProfit),'USD')}</div></div>
      </div>
      <div class="grid grid-2 mt-14">
        <div class="card"><div class="card-title mb-0" style="font-size:13.5px;">Income vs Expense</div><div class="mt-14">${svgBarChart(barData)}</div></div>
        <div class="card"><div class="card-title mb-0" style="font-size:13.5px;">Expense Breakdown</div><div class="mt-14">${pieData.length?svgPieChart(pieData,{size:180}):'<div class="muted" style="padding:20px;text-align:center;">No expenses yet</div>'}</div></div>
      </div>
      <div class="card mt-14"><div class="card-title mb-0" style="font-size:13.5px;">Net Profit Trend</div><div class="mt-14">${svgLineChart(lineData)}</div></div>
      <div class="card mt-14">
        <table>
          <tbody>
            <tr><td style="font-weight:700;">Service Revenue</td><td class="num">${fmtMoney(serviceRevenue,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Money Exchange Gains</td><td class="num">${fmtMoney(exchangeGain,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Other Income (General Receipts)</td><td class="num">${fmtMoney(otherIncome,'USD')}</td></tr>
            <tr style="border-top:2px solid var(--border-strong);"><td style="font-weight:800;">Total Income</td><td class="num" style="font-weight:800;">${fmtMoney(totalIncome,'USD')}</td></tr>
            <tr><td style="font-weight:700;padding-top:14px;">Operating Expenses</td><td class="num" style="padding-top:14px;">${fmtMoney(operatingExpenses,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Money Exchange Losses</td><td class="num">${fmtMoney(exchangeLoss,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Other Expense (General Payments)</td><td class="num">${fmtMoney(otherExpense,'USD')}</td></tr>
            <tr style="border-top:2px solid var(--border-strong);"><td style="font-weight:800;">Total Expense</td><td class="num" style="font-weight:800;">${fmtMoney(totalExpense,'USD')}</td></tr>
            <tr style="border-top:2px solid var(--brown-900);"><td style="font-weight:800;font-size:15px;">Net ${netProfit>=0?'Profit':'Loss'}</td><td class="num" style="font-weight:800;font-size:15px;color:${netProfit>=0?'var(--green)':'var(--red)'};">${fmtMoney(Math.abs(netProfit),'USD')}</td></tr>
          </tbody>
        </table>
      </div>`;

    document.getElementById('pl_print').onclick = ()=>{
      const html = `<div class="print-doc">${printHeaderHTML('Profit & Loss Statement','',todayISO())}
        <p><b>Period:</b> ${from?fmtDate(from):'Inception'} — ${to?fmtDate(to):'Today'}</p>
        <table>
          <tbody>
            <tr><td style="font-weight:700;">Service Revenue</td><td class="num">${fmtMoney(serviceRevenue,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Money Exchange Gains</td><td class="num">${fmtMoney(exchangeGain,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Other Income</td><td class="num">${fmtMoney(otherIncome,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Operating Expenses</td><td class="num">${fmtMoney(operatingExpenses,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Money Exchange Losses</td><td class="num">${fmtMoney(exchangeLoss,'USD')}</td></tr>
            <tr><td style="font-weight:700;">Other Expense</td><td class="num">${fmtMoney(otherExpense,'USD')}</td></tr>
          </tbody>
        </table>
        <div class="totals">
          <div><span>Total Income</span><span>${fmtMoney(totalIncome,'USD')}</span></div>
          <div><span>Total Expense</span><span>${fmtMoney(totalExpense,'USD')}</span></div>
          <div class="grand"><span>Net ${netProfit>=0?'Profit':'Loss'}</span><span>${fmtMoney(Math.abs(netProfit),'USD')}</span></div>
        </div></div>`;
      doPrint(html);
    };
  }
  wirePeriodControls(container, 'pl_period', 'pl_from', 'pl_to', refresh);
}

/* ---------------------------------------------------------
   18c. DAY BOOK REGISTER
   A full chronological register of every ledger-affecting transaction
   (services, receipts/payments, transfers, expenses, exchanges) across
   every account — the classic daily "day book" reconciliation view.
--------------------------------------------------------- */
async function renderDayBookReport(container){
  container.innerHTML = `
    <div class="card">
      <div class="toolbar"><h2 class="card-title" style="font-size:16px;">Day Book Register</h2></div>
      <div class="toolbar-left mt-0" style="margin-bottom:14px;">
        ${periodPillsHTML('db_period')}
        <input type="date" id="db_from"><span class="muted">to</span><input type="date" id="db_to">
        <button class="btn btn-sm" id="db_print">&#128424; Print</button>
      </div>
      <div id="db_body"></div>
    </div>`;

  const TYPE_LABELS = {service:'Service', general:'Receipt/Payment', transfer:'Fund Transfer', expense:'Expense', exchange:'Money Exchange', loan_repayment:'Loan Repayment', partner_capital:'Partner Drawing / Deposit'};

  async function refresh(from, to){
    let txns = await dbGetAll('transactions');
    if(from) txns = txns.filter(t=>t.date>=from);
    if(to) txns = txns.filter(t=>t.date<=to);
    txns.sort((a,b)=> (a.date||'').localeCompare(b.date) || (a.createdAt||'').localeCompare(b.createdAt||''));

    // Totals & charts count real cash/bank movement only. Every transfer / partner posting is stored as two
    // legs; counting both double-counted money (and the partner-payable leg isn't cash at all). So: skip
    // system (partner/suspense/gain-loss) accounts, and skip transfers whose legs both sit on cash/bank accounts.
    const sysIds = new Set(STATE.accounts.filter(a=>a.system).map(a=>a.id));
    const legsByRef = {};
    txns.forEach(t=>{ if(t.type==='transfer' && t.refId){ (legsByRef[t.refId] = legsByRef[t.refId]||[]).push(t); } });
    const isInternal = (t)=> t.type==='transfer' && t.refId && legsByRef[t.refId].every(x=>!sysIds.has(x.accountId));
    const cashTxns = txns.filter(t=> !sysIds.has(t.accountId) && !isInternal(t));
    const totalIn = cashTxns.filter(t=>t.direction==='in').reduce((s,t)=>s+(t.amountBase||0),0);
    const totalOut = cashTxns.filter(t=>t.direction==='out').reduce((s,t)=>s+(t.amountBase||0),0);

    // Chart 1: daily In vs Out totals across the period
    const byDay = {};
    cashTxns.forEach(t=>{ if(!byDay[t.date]) byDay[t.date]={in:0,out:0}; byDay[t.date][t.direction] += (t.amountBase||0); });
    const days = Object.keys(byDay).sort();
    const inBar = days.map(d=>({label:d.slice(5), value:byDay[d].in}));
    const outBar = days.map(d=>({label:d.slice(5), value:byDay[d].out}));
    // Chart 2: breakdown by transaction type
    const byType = {};
    cashTxns.forEach(t=>{ const l = TYPE_LABELS[t.type]||t.type; byType[l]=(byType[l]||0)+1; });
    const pieData = Object.entries(byType).map(([label,value])=>({label,value}));

    document.getElementById('db_body').innerHTML = `
      <div class="grid grid-3 mt-0">
        <div class="stat-card" style="--accent:var(--green);"><div class="stat-label">Total In</div><div class="stat-value">${fmtMoney(totalIn,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--red);"><div class="stat-label">Total Out</div><div class="stat-value">${fmtMoney(totalOut,'USD')}</div></div>
        <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">Net Movement</div><div class="stat-value">${fmtMoney(totalIn-totalOut,'USD')}</div></div>
      </div>
      <div class="grid grid-2 mt-14">
        <div class="card"><div class="card-title mb-0" style="font-size:13.5px;">Daily In vs Out</div>
          <div class="mt-14">
            ${days.length? `<div class="faint" style="font-size:11px;margin-bottom:2px;">Money In</div>${svgBarChart(inBar)}
            <div class="faint" style="font-size:11px;margin:10px 0 2px;">Money Out</div>${svgBarChart(outBar)}` : '<div class="muted" style="padding:20px;text-align:center;">No data yet</div>'}
          </div>
        </div>
        <div class="card"><div class="card-title mb-0" style="font-size:13.5px;">By Transaction Type</div><div class="mt-14">${pieData.length?svgPieChart(pieData,{size:180}):'<div class="muted" style="padding:20px;text-align:center;">No data yet</div>'}</div></div>
      </div>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Description</th><th class="num">In</th><th class="num">Out</th></tr></thead>
        <tbody>${txns.length? txns.map(t=>{
          const acc = STATE.accounts.find(a=>a.id===t.accountId);
          return `<tr><td>${fmtDate(t.date)}</td><td><span class="badge badge-gray">${esc(TYPE_LABELS[t.type]||t.type)}</span></td><td>${acc?esc(acc.name):'—'}</td><td>${esc(t.description)}</td>
          <td class="num">${t.direction==='in'?fmtMoney(t.amountBase,'USD'):''}</td>
          <td class="num">${t.direction==='out'?fmtMoney(t.amountBase,'USD'):''}</td></tr>`;
        }).join('') : `<tr class="empty-row"><td colspan="6">No transactions in this period.</td></tr>`}</tbody>
      </table></div>`;

    document.getElementById('db_print').onclick = ()=>{
      const html = `<div class="print-doc">${printHeaderHTML('Day Book Register','',todayISO())}
        <p><b>Period:</b> ${from?fmtDate(from):'Inception'} — ${to?fmtDate(to):'Today'}</p>
        <table><thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Description</th><th class="num">In</th><th class="num">Out</th></tr></thead>
        <tbody>${txns.map(t=>{ const acc = STATE.accounts.find(a=>a.id===t.accountId);
          return `<tr><td>${fmtDate(t.date)}</td><td>${esc(TYPE_LABELS[t.type]||t.type)}</td><td>${acc?esc(acc.name):'—'}</td><td>${esc(t.description)}</td>
          <td class="num">${t.direction==='in'?fmtMoney(t.amountBase,'USD'):''}</td><td class="num">${t.direction==='out'?fmtMoney(t.amountBase,'USD'):''}</td></tr>`; }).join('')}</tbody></table>
        <div class="totals"><div><span>Total In</span><span>${fmtMoney(totalIn,'USD')}</span></div><div><span>Total Out</span><span>${fmtMoney(totalOut,'USD')}</span></div>
        <div class="grand"><span>Net Movement</span><span>${fmtMoney(totalIn-totalOut,'USD')}</span></div></div></div>`;
      doPrint(html);
    };
  }
  wirePeriodControls(container, 'db_period', 'db_from', 'db_to', refresh);
}

async function renderServiceReports(container){
  const allServiceOptions = SERVICE_CONFIG.map(s=>`<option value="${s.key}">${s.icon} ${esc(s.label)}</option>`).join('')
    + `<option value="money_exchange">💰 Money Exchange</option>`;
  container.innerHTML = `
    <div class="card">
      <div class="toolbar">
        <h2 class="card-title" style="font-size:16px;">Per-Service Reports</h2>
      </div>
      <div class="toolbar-left mt-0" style="margin-bottom:14px;">
        <select id="sr_service" style="min-width:220px;">${allServiceOptions}</select>
        ${periodPillsHTML('sr_period')}
        <input type="date" id="sr_from"><span class="muted">to</span><input type="date" id="sr_to">
        <button class="btn btn-sm" id="sr_print">&#128424; Print</button>
      </div>
      <div id="sr_body"></div>
    </div>`;
  function entryValueBase(e, mode){
    if(mode==='exchange') return e.data.gainLoss||0;
    if(mode==='loan') return e.receipt ? toBase(e.receipt.amount, e.receipt.rate) : 0;
    return e.finance ? toBase(e.finance.totalAmount, e.finance.currency===BASE_CURRENCY?1:(e.finance.rate||getRate(e.finance.currency))) : 0;
  }
  function entryValueDisplay(e, mode){
    if(mode==='exchange') return fmtMoney(e.data.gainLoss||0,'USD');
    if(mode==='loan') return e.receipt ? fmtMoney(e.receipt.amount, e.receipt.currency) : '—';
    return e.finance ? fmtMoney(e.finance.totalAmount, e.finance.currency) : '—';
  }
  function whoName(e, cfg){
    const cust = STATE.customers.find(c=>c.id===e.customerId);
    if(cust) return cust.name;
    if(cfg && cfg.optionalCustomer && e.data.employeeId){ const emp = STATE.employees.find(x=>x.id===e.data.employeeId); if(emp) return emp.name+' (employee)'; }
    return '—';
  }
  let lastFrom=null, lastTo=null;
  async function refresh(from, to){
    lastFrom = from; lastTo = to;
    const key = document.getElementById('sr_service').value;
    const cfg = getServiceCfg(key);
    const mode = key==='money_exchange' ? 'exchange' : (cfg && cfg.financeMode==='loan' ? 'loan' : 'common');
    let entries = (await dbGetByIndex('serviceEntries','type', key)).sort((a,b)=>(a.date||'').localeCompare(b.date||''));
    if(from) entries = entries.filter(e=>e.date>=from);
    if(to) entries = entries.filter(e=>e.date<=to);
    let totalBase = 0;
    entries.forEach(e=>{ totalBase += entryValueBase(e, mode); });
    const label = mode==='exchange' ? 'Money Exchange' : cfg.label;
    const valHeader = mode==='exchange' ? 'Gain/Loss' : (mode==='loan' ? 'Loan Amount' : 'Total Amount');

    // Chart 1: value by month across the selected entries
    const byMonth = {};
    entries.forEach(e=>{ const mk = (e.date||'').slice(0,7); if(!mk) return; byMonth[mk] = (byMonth[mk]||0) + entryValueBase(e,mode); });
    const monthKeys = Object.keys(byMonth).sort();
    const barData = monthKeys.map(mk=>({label: new Date(+mk.slice(0,4), +mk.slice(5,7)-1, 1).toLocaleDateString('en-GB',{month:'short',year:'2-digit'}), value: byMonth[mk]}));

    // Chart 2: breakdown by status field (the last field in each service's schema is always its status field)
    let pieData = [];
    if(mode!=='exchange'){
      const statusField = cfg.fields[cfg.fields.length-1];
      const byStatus = {};
      entries.forEach(e=>{ const v = (e.data && e.data[statusField.key]) || 'Not set'; byStatus[v] = (byStatus[v]||0)+1; });
      pieData = Object.entries(byStatus).map(([label,value])=>({label,value}));
    } else {
      const gains = entries.filter(e=>(e.data.gainLoss||0)>=0).length;
      const losses = entries.length - gains;
      pieData = [{label:'Gain', value:gains},{label:'Loss', value:losses}].filter(d=>d.value>0);
    }

    document.getElementById('sr_body').innerHTML = `
      <div class="grid grid-2 mt-0">
        <div class="stat-card" style="--accent:var(--navy);"><div class="stat-label">Entries</div><div class="stat-value">${entries.length}</div></div>
        <div class="stat-card" style="--accent:var(--orange);"><div class="stat-label">${mode==='exchange'?'Net Gain / Loss':'Total Value'} (USD)</div><div class="stat-value">${fmtMoney(totalBase,'USD')}</div></div>
      </div>
      <div class="grid grid-2 mt-14">
        <div class="card">
          <div class="card-title mb-0" style="font-size:13.5px;">${esc(valHeader)} by Month</div>
          <div class="mt-14">${barData.length? svgBarChart(barData) : '<div class="muted" style="padding:20px;text-align:center;">No data yet</div>'}</div>
        </div>
        <div class="card">
          <div class="card-title mb-0" style="font-size:13.5px;">${mode==='exchange'?'Gain vs Loss Count':'Breakdown by Status'}</div>
          <div class="mt-14">${svgPieChart(pieData, {size:180})}</div>
        </div>
      </div>
      <div class="table-wrap mt-14"><table>
        <thead><tr><th>Ref No.</th><th>Date</th><th>Client</th><th class="num">${valHeader}</th></tr></thead>
        <tbody>${entries.length? entries.map(e=>{
          return `<tr><td class="mono">${esc(e.refNo)}</td><td>${fmtDate(e.date)}</td><td>${esc(whoName(e,cfg))}</td><td class="num">${entryValueDisplay(e,mode)}</td></tr>`;
        }).join('') : `<tr class="empty-row"><td colspan="4">No entries in this period.</td></tr>`}</tbody>
      </table></div>`;
    document.getElementById('sr_print').onclick = ()=>{
      const html = `<div class="print-doc">${printHeaderHTML(label+' Report', '', todayISO())}
        <p><b>Period:</b> ${from?fmtDate(from):'Inception'} — ${to?fmtDate(to):'Today'}</p>
        <table><thead><tr><th>Ref No.</th><th>Date</th><th>Client</th><th class="num">${valHeader}</th></tr></thead>
        <tbody>${entries.map(e=>{
          return `<tr><td>${esc(e.refNo)}</td><td>${fmtDate(e.date)}</td><td>${esc(whoName(e,cfg))}</td><td class="num">${entryValueDisplay(e,mode)}</td></tr>`; }).join('')}</tbody></table>
        <div class="totals"><div class="grand"><span>Total (USD)</span><span>${fmtMoney(totalBase,'USD')}</span></div></div></div>`;
      doPrint(html);
    };
  }
  document.getElementById('sr_service').addEventListener('change', ()=>refresh(lastFrom, lastTo));
  wirePeriodControls(container, 'sr_period', 'sr_from', 'sr_to', refresh);
}


