      <thead><tr><th>Ref No.</th><th>Service</th><th>Client</th><th>Expiry Date</th><th>Days Left</th></tr></thead>
      <tbody>${list.map(a=>{
        const cls = a.days<0?'badge-red':(a.days<=30?'badge-red':'badge-amber');
        const txt = a.days<0 ? `Expired ${Math.abs(a.days)}d ago` : `${a.days} days`;
        return `<tr><td class="mono">${esc(a.refNo)}</td><td>${esc(a.service)}</td><td>${esc(a.client)}</td><td>${fmtDate(a.expiry)}</td><td><span class="badge ${cls}">${txt}</span></td></tr>`;
      }).join('')}</tbody></table>`;
