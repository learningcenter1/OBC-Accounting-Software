  document.getElementById('rp_print_c').onclick = ()=>doPrint(`<div class="print-doc">${printHeaderHTML('Receivable Report','',todayISO())}
    <table><thead><tr><th>Customer</th><th class="num">Balance (USD)</th></tr></thead><tbody>${custRows.map(r=>`<tr><td>${esc(r.name)}</td><td class="num">${fmtMoney(r.balance,'USD')}</td></tr>`).join('')}</tbody></table>
    <div class="totals"><div class="grand"><span>Total Receivable</span><span>${fmtMoney(totalReceivable,'USD')}</span></div></div></div>`);
  document.getElementById('rp_print_v').onclick = ()=>doPrint(`<div class="print-doc">${printHeaderHTML('Payable Report','',todayISO())}
    <table><thead><tr><th>Vendor</th><th class="num">Balance (USD)</th></tr></thead><tbody>${vendRows.map(r=>`<tr><td>${esc(r.name)}</td><td class="num">${fmtMoney(r.balance,'USD')}</td></tr>`).join('')}</tbody></table>
