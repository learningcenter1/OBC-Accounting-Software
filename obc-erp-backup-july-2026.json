// Routes that should be treated as "inside" Data Entry for sidebar highlighting
// and for the breadcrumb back-link, even though they aren't top-level NAV items.
function isDataEntryRoute(route){
  return route === 'data-entry' || route.startsWith('service/') || route === 'money-exchange';
}

function routeTitle(route){
  for(const g of NAV){ const f = g.items.find(i=>i.route===route); if(f) return f.label; }
  if(route.startsWith('service/')){ const c = getServiceCfg(route.split('/')[1]); if(c) return c.label; }
  if(route==='money-exchange') return 'Money Exchange';
  if(route.startsWith('ledger/')) return 'Ledger';
  return 'OBC Indonesia ERP';
}

/* ---------------------------------------------------------
   7. ROUTER
--------------------------------------------------------- */
window.addEventListener('hashchange', handleRoute);

function navigate(route){
  window.location.hash = '#/' + route;
}

async function handleRoute(){
  let hash = window.location.hash.replace(/^#\/?/, '');
  if(!hash) hash = 'dashboard';
  STATE.route = hash;
  STATE.sidebarOpen = false;
  await reloadCoreCaches();
  renderShell();
}

/* ---------------------------------------------------------
   8. APP SHELL (sidebar + topbar + content mount)
--------------------------------------------------------- */
function renderShell(){
  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="app-shell">
      <div class="sidebar-scrim ${STATE.sidebarOpen?'open':''}" id="scrim"></div>
      <aside class="sidebar ${STATE.sidebarOpen?'open':''}" id="sidebar">
        <div class="sidebar-brand">
          ${logoMarkSVG(42)}
          <div class="brand-text">
            <div class="name">OBC Indonesia</div>
            <div class="tag">Travel · Business · Immigration</div>
          </div>
        </div>
        <div class="sidebar-scroll">
          ${NAV.map(g=>{
            const hasActive = g.items.some(it=> it.route==='data-entry' ? isDataEntryRoute(STATE.route) : STATE.route===it.route);
            const explicit = STATE.navOpen[g.group];
            const open = explicit===undefined ? hasActive : explicit;
            return `<div class="nav-group ${open?'open':''} ${hasActive?'has-active':''}" data-group="${esc(g.group)}">
              <button type="button" class="nav-group-head"><span>${esc(g.group)}</span><span class="chev"></span></button>
              <div class="nav-group-items">
              ${g.items.map(it=>{
                const isActive = it.route==='data-entry' ? isDataEntryRoute(STATE.route) : STATE.route===it.route;
                return `<a class="nav-item ${isActive?'active':''}" data-route="${it.route}">
                  <span class="ico">${it.icon}</span><span>${esc(it.label)}</span>
                </a>`;
              }).join('')}
              </div>
            </div>`;
          }).join('')}
        </div>
      </aside>
      <div class="main">
        <div class="topbar">
          <div class="topbar-left">
            <button class="hamburger" id="hamburger-btn">&#9776;</button>
            <div>
              <div class="page-title">${esc(routeTitle(STATE.route))}</div>
              <div class="page-sub">${esc(COMPANY.name)} — ${esc(COMPANY.tagline)}</div>
            </div>
          </div>
          <div class="topbar-right">
            <button class="btn btn-sm" id="qr-btn">&#8644; Receipt &amp; Payment</button>
            ${STATE.currentUser?`<div class="user-chip">&#128100; ${esc(STATE.currentUser.name)} <span class="badge ${STATE.currentUser.role==='admin'?'badge-navy':'badge-gray'}">${STATE.currentUser.role==='admin'?'Admin':'Staff'}</span></div><button class="btn btn-sm" id="logout-btn">Sign out</button>`:''}
            <div class="topbar-date">${new Date().toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric'})}</div>
          </div>
        </div>
        <div class="content" id="content"></div>
        <div class="footer-note">OBC Indonesia ERP — all data stored locally on this device/browser. Remember to back up regularly from Settings.</div>
      </div>
    </div>
  `;
  app.querySelectorAll('.nav-group-head').forEach(h=>{
    h.addEventListener('click', ()=>{
      const grp = h.parentElement, name = grp.dataset.group;
      const open = !grp.classList.contains('open');
      grp.classList.toggle('open', open);
      STATE.navOpen[name] = open;
      try{ localStorage.setItem('obc_nav_open', JSON.stringify(STATE.navOpen)); }catch(e){}
    });
  });
  app.querySelectorAll('.nav-item').forEach(el=>{
    el.addEventListener('click', ()=> navigate(el.dataset.route));
  });
  document.getElementById('hamburger-btn').addEventListener('click', ()=>{
    STATE.sidebarOpen = !STATE.sidebarOpen;
    document.getElementById('sidebar').classList.toggle('open', STATE.sidebarOpen);
    document.getElementById('scrim').classList.toggle('open', STATE.sidebarOpen);
  });
  document.getElementById('scrim').addEventListener('click', ()=>{
    STATE.sidebarOpen=false;
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('scrim').classList.remove('open');
  });
  document.getElementById('qr-btn').addEventListener('click', ()=>navigate('receipt-payment'));
  const lo = document.getElementById('logout-btn'); if(lo) lo.addEventListener('click', logout);

  renderRoute();
}

function logoMarkSVG(size){
  return `<div class="brand-mark" style="width:${size}px;height:${size}px;overflow:hidden;padding:0;">
    <img src="${LOGO_ICON_DATA_URI}" alt="OBC Indonesia" style="width:100%;height:100%;object-fit:cover;display:block;">
  </div>`;
}

const ROUTE_RENDERERS = {}; // populated later in file: route -> async function(container, param)

async function renderRoute(){
  const content = document.getElementById('content');
  content.innerHTML = '<div class="muted" style="padding:40px;text-align:center;">Loading…</div>';
  let route = STATE.route;
  let param = null;
  let handlerKey = route;

  if(route.startsWith('service/')){ handlerKey='service'; param = route.split('/')[1]; }
  else if(route.startsWith('ledger/')){ handlerKey='ledger'; param = route.split('/')[1]; }
  else if(route.startsWith('reports/')){ handlerKey='reports'; param = route.split('/')[1]; }

  const fn = ROUTE_RENDERERS[handlerKey];
  if(fn){
    try{ await fn(content, param); }
    catch(err){ console.error(err); content.innerHTML = `<div class="callout callout-red">Something went wrong rendering this page: ${esc(err.message)}</div>`; }
  } else {
    content.innerHTML = `<div class="callout callout-amber">Page not found.</div>`;
  }
}

