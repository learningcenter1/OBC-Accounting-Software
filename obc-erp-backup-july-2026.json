<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OBC Indonesia — ERP</title>
<style>
/* ============================================================
   OBC INDONESIA ERP — DESIGN TOKENS
   Brand: navy "OBC" wordmark + airplane trail, peach background.
   Sidebar: brown (per spec). Accents derived from brand palette.
   Printable docs: light background, high contrast.
   ============================================================ */
:root{
  --brown-900:#2E2015;
  --brown-800:#3B2A1C;
  --brown-700:#4A3524;
  --brown-600:#5C4230;
  --brown-500:#6E5138;
  --brown-100:#EFE2D0;
  --navy:#152A4E;
  --navy-700:#1D3760;
  --peach:#F6C79A;
  --peach-light:#FBEEDF;
  --orange:#E07A2C;
  --orange-dark:#B85E1B;
  --bg:#FAF7F1;
  --surface:#FFFFFF;
  --surface-2:#FCFAF6;
  --border:#E6DAC6;
  --border-strong:#D6C4A6;
  --text:#2A2016;
  --text-muted:#7C6B54;
  --text-faint:#A6957B;
  --green:#2E7A4F;
  --green-bg:#E7F3EB;
  --red:#C13E2E;
  --red-bg:#FBEAE7;
  --amber:#B9790A;
  --amber-bg:#FBF0DC;
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: "SFMono-Regular", Consolas, "Roboto Mono", Menlo, monospace;
  --radius: 8px;
  --radius-lg: 14px;
  --shadow-sm: 0 1px 2px rgba(46,32,21,0.08);
  --shadow-md: 0 4px 16px rgba(46,32,21,0.10);
  --sidebar-w: 252px;
}

*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  font-family:var(--font);
  background:var(--bg);
  color:var(--text);
  font-size:14px;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit;}
button{font-family:inherit;}
h1,h2,h3,h4{margin:0 0 4px 0; font-weight:700; letter-spacing:-0.01em;}
::selection{background:var(--peach); color:var(--navy);}
:focus-visible{outline:2px solid var(--orange); outline-offset:2px;}

/* ---------- App shell ---------- */
.app-shell{
  display:flex;
  min-height:100vh;
}

/* ---------- Sidebar ---------- */
.sidebar{
  width:var(--sidebar-w);
  flex-shrink:0;
  background:linear-gradient(180deg,var(--brown-800),var(--brown-900));
  color:var(--brown-100);
  display:flex;
  flex-direction:column;
  position:fixed;
  top:0; left:0; bottom:0;
  z-index:40;
  transition:transform .25s ease;
}
.sidebar-brand{
  display:flex;
  align-items:center;
  gap:10px;
  padding:18px 16px;
  border-bottom:1px solid rgba(255,255,255,0.08);
}
.brand-mark{
  width:42px;height:42px;border-radius:10px;
  background:var(--peach);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
  box-shadow:var(--shadow-sm);
  overflow:hidden;
}
.brand-text{line-height:1.15;}
.brand-text .name{font-weight:800; font-size:15.5px; color:#fff; letter-spacing:0.01em;}
.brand-text .tag{font-size:10px; color:var(--peach); text-transform:uppercase; letter-spacing:0.06em;}

.sidebar-scroll{
  flex:1 1 auto;
  min-height:0;
  overflow-y:scroll;               /* always show the scroll track */
  overscroll-behavior:contain;
  padding:10px 6px 20px 10px;
}
@supports not selector(::-webkit-scrollbar){
  .sidebar-scroll{scrollbar-width:auto; scrollbar-color:#F6C79A rgba(255,255,255,0.14);}
}
.sidebar-scroll::-webkit-scrollbar{width:12px;}
.sidebar-scroll::-webkit-scrollbar-track{background:rgba(255,255,255,0.12); border-radius:6px; margin:4px 0;}
.sidebar-scroll::-webkit-scrollbar-thumb{background:#F6C79A; border-radius:6px; border:2px solid transparent; background-clip:padding-box; min-height:40px;}
.sidebar-scroll::-webkit-scrollbar-thumb:hover{background:#E07A2C; background-clip:padding-box;}

/* Sidebar dropdown groups */
.nav-group-head{
  width:100%; display:flex; align-items:center; justify-content:space-between;
  background:transparent; border:0; cursor:pointer; text-align:left;
  padding:10px 10px; margin-top:4px; border-radius:8px;
  font-size:11.5px; font-weight:800; letter-spacing:0.07em; text-transform:uppercase;
  color:var(--peach);
}
.nav-group-head:hover{background:rgba(255,255,255,0.07);}
.nav-group-head .chev{box-sizing:content-box; flex-shrink:0; width:6px; height:6px; border-right:2px solid currentColor; border-bottom:2px solid currentColor; transform:rotate(-45deg); transition:transform .2s; margin-right:4px; opacity:.85;}
.nav-group.open > .nav-group-head .chev{transform:rotate(45deg);}
.nav-group.has-active > .nav-group-head{color:#fff;}
.nav-group-items{display:none; padding:2px 0 6px 6px; margin-left:8px; border-left:1px solid rgba(255,255,255,0.14);}
.nav-group.open > .nav-group-items{display:block;}
.user-chip{display:flex; align-items:center; gap:8px; font-size:12px; color:var(--text-muted); padding:4px 10px; border:1px solid var(--border); border-radius:99px; background:var(--surface);}

.nav-group-label{
  font-size:10.5px;
  text-transform:uppercase;
  letter-spacing:0.08em;
  color:var(--peach);
  opacity:0.75;
  padding:16px 10px 6px;
  font-weight:700;
}
.nav-group-label:first-child{padding-top:6px;}
.nav-item{
  display:flex;
  align-items:center;
  gap:10px;
  padding:9px 10px;
  border-radius:8px;
  cursor:pointer;
  color:var(--brown-100);
  font-size:13.3px;
  font-weight:500;
  text-decoration:none;
  margin-bottom:1px;
  border:1px solid transparent;
}
.nav-item .ico{width:18px; text-align:center; flex-shrink:0; opacity:0.9; font-size:14px;}
.nav-item:hover{background:rgba(255,255,255,0.08); color:#fff;}
.nav-item.active{
  background:var(--orange);
  color:#fff;
  font-weight:700;
  box-shadow:var(--shadow-sm);
}
.nav-item.active .ico{opacity:1;}
.nav-sub{margin-left:8px; padding-left:10px; border-left:1px dashed rgba(255,255,255,0.15);}

/* ---------- Main ---------- */
.main{
  margin-left:var(--sidebar-w);
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  min-height:100vh;
}
.topbar{
  position:sticky; top:0; z-index:30;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  background:var(--surface);
  border-bottom:1px solid var(--border);
  padding:12px 22px;
}
.topbar-left{display:flex; align-items:center; gap:12px; min-width:0;}
.hamburger{display:none; background:none; border:1px solid var(--border); border-radius:8px; width:36px;height:36px; cursor:pointer; font-size:16px; color:var(--brown-800);}
.page-title{font-size:19px; font-weight:800; color:var(--brown-900); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.page-sub{font-size:12px; color:var(--text-muted); margin-top:1px;}
.topbar-right{display:flex; align-items:center; gap:10px; flex-shrink:0;}
.topbar-date{font-size:12px; color:var(--text-muted); text-align:right; line-height:1.3;}

.content{
  padding:22px;
  flex:1;
  width:100%;
  max-width:1400px;
}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex; align-items:center; gap:7px;
  padding:9px 15px;
  border-radius:8px;
  border:1px solid var(--border-strong);
  background:var(--surface);
  color:var(--brown-900);
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  transition:all .12s ease;
  white-space:nowrap;
}
.btn:hover{border-color:var(--orange); color:var(--orange-dark); background:var(--peach-light);}
.btn-primary{background:var(--orange); border-color:var(--orange-dark); color:#fff;}
.btn-primary:hover{background:var(--orange-dark); color:#fff;}
.btn-navy{background:var(--navy); border-color:var(--navy); color:#fff;}
.btn-navy:hover{background:var(--navy-700); color:#fff;}
.btn-danger{background:var(--red-bg); border-color:var(--red); color:var(--red);}
.btn-danger:hover{background:var(--red); color:#fff;}
.btn-ghost{background:transparent; border-color:transparent;}
.btn-sm{padding:5px 10px; font-size:12px; border-radius:6px;}
.btn:disabled{opacity:0.5; cursor:not-allowed;}
.btn-icon{width:32px; height:32px; padding:0; justify-content:center;}

/* ---------- Cards / Panels ---------- */
.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:18px;
  box-shadow:var(--shadow-sm);
}
.card + .card{margin-top:16px;}
.card-header{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; flex-wrap:wrap;}
.card-title{font-size:15px; font-weight:800; color:var(--brown-900);}
.card-title .muted{font-weight:500; color:var(--text-muted); font-size:12px;}

.grid{display:grid; gap:16px;}
.grid-4{grid-template-columns:repeat(4,1fr);}
.grid-3{grid-template-columns:repeat(3,1fr);}
.grid-2{grid-template-columns:repeat(2,1fr);}
@media(max-width:1100px){.grid-4{grid-template-columns:repeat(2,1fr);} .grid-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.grid-4,.grid-3,.grid-2{grid-template-columns:1fr;}}

/* ---------- KPI Stat cards ---------- */
.stat-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:16px 18px;
  position:relative;
  overflow:hidden;
}
.stat-card::before{
  content:"";
  position:absolute; top:0; left:0; width:4px; height:100%;
  background:var(--accent, var(--orange));
}
.stat-label{font-size:11.5px; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); font-weight:700;}
.stat-value{font-size:24px; font-weight:800; color:var(--brown-900); margin-top:6px; letter-spacing:-0.02em;}
.stat-foot{font-size:11.5px; color:var(--text-faint); margin-top:4px;}
.de-tile{transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;}
.de-tile:hover{transform:translateY(-2px); box-shadow:var(--shadow-md); border-color:var(--orange);}
.breadcrumb{font-size:12.5px; color:var(--text-muted); margin-bottom:10px;}
.breadcrumb a{color:var(--navy-700); text-decoration:none; font-weight:700; cursor:pointer;}
.breadcrumb a:hover{text-decoration:underline;}

/* ---------- Tables ---------- */
.table-wrap{overflow-x:auto; border-radius:10px; border:1px solid var(--border);}
table{width:100%; border-collapse:collapse; font-size:13px; background:var(--surface);}
thead th{
  text-align:left;
  background:var(--peach-light);
  color:var(--brown-900);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:0.04em;
  padding:10px 12px;
  border-bottom:1px solid var(--border-strong);
  white-space:nowrap;
  position:sticky; top:0;
}
tbody td{padding:9px 12px; border-bottom:1px solid var(--border); vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr:hover{background:var(--surface-2);}
td.num, th.num{text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap;}
.table-wrap td:first-child{white-space:nowrap;}
.row-actions{display:flex; gap:6px; justify-content:flex-end;}
.empty-row td{text-align:center; padding:28px; color:var(--text-faint); font-style:italic;}

/* ---------- Forms ---------- */
.form-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px 16px;}
@media(max-width:700px){.form-grid{grid-template-columns:1fr;}}
.field{display:flex; flex-direction:column; gap:5px;}
.field.span-2{grid-column:span 2;}
@media(max-width:700px){.field.span-2{grid-column:span 1;}}
.field label{font-size:12px; font-weight:700; color:var(--brown-800);}
.field .hint{font-size:11px; color:var(--text-faint); font-weight:400;}
input, select, textarea{
  font-family:inherit;
  font-size:13.5px;
  padding:9px 11px;
  border-radius:7px;
  border:1px solid var(--border-strong);
  background:var(--surface);
  color:var(--text);
  width:100%;
}
input:focus, select:focus, textarea:focus{border-color:var(--orange); outline:none; box-shadow:0 0 0 3px rgba(224,122,44,0.14);}
textarea{resize:vertical; min-height:64px;}
fieldset{border:1px dashed var(--border-strong); border-radius:10px; padding:14px 16px; margin:6px 0;}
fieldset legend{font-size:12px; font-weight:800; color:var(--orange-dark); padding:0 6px; text-transform:uppercase; letter-spacing:0.04em;}
.form-actions{display:flex; gap:10px; justify-content:flex-end; margin-top:16px; padding-top:14px; border-top:1px solid var(--border);}

/* ---------- Badges ---------- */
.badge{display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:99px; font-size:11px; font-weight:700;}
.badge-green{background:var(--green-bg); color:var(--green);}
.badge-red{background:var(--red-bg); color:var(--red);}
.badge-amber{background:var(--amber-bg); color:var(--amber);}
.badge-navy{background:#EAF0FB; color:var(--navy-700);}
.badge-gray{background:var(--brown-100); color:var(--brown-700);}

/* ---------- Tabs ---------- */
.tabs{display:flex; gap:4px; border-bottom:1px solid var(--border); margin-bottom:16px; flex-wrap:wrap;}
.tab{padding:9px 14px; font-size:13px; font-weight:700; color:var(--text-muted); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px;}
.tab:hover{color:var(--orange-dark);}
.tab.active{color:var(--orange-dark); border-bottom-color:var(--orange);}

/* ---------- Toast ---------- */
#toast-wrap{position:fixed; bottom:20px; right:20px; z-index:200; display:flex; flex-direction:column; gap:8px;}
.toast{
  background:var(--brown-900); color:#fff; padding:11px 16px; border-radius:8px;
  font-size:13px; box-shadow:var(--shadow-md); display:flex; align-items:center; gap:8px;
  animation:toast-in .2s ease;
  max-width:340px;
}
.toast.success{background:var(--green);}
.toast.error{background:var(--red);}
@keyframes toast-in{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}

/* ---------- Modal ---------- */
.modal-overlay{
  position:fixed; inset:0; background:rgba(20,14,8,0.55); z-index:100;
  display:flex; align-items:flex-start; justify-content:center; padding:40px 16px; overflow-y:auto;
}
.modal{
  background:var(--surface); border-radius:var(--radius-lg); width:100%; max-width:640px;
  box-shadow:var(--shadow-md); animation:modal-in .18s ease;
}
.modal.wide{max-width:900px;}
@keyframes modal-in{from{opacity:0; transform:translateY(-10px);} to{opacity:1; transform:translateY(0);}}
.modal-header{display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border);}
.modal-header h3{font-size:16px;}
.modal-body{padding:20px; max-height:70vh; overflow-y:auto;}
.modal-close{background:none; border:none; font-size:20px; cursor:pointer; color:var(--text-muted); line-height:1;}

/* ---------- Alerts / callouts ---------- */
.callout{border-radius:10px; padding:12px 14px; font-size:13px; display:flex; gap:10px; align-items:flex-start;}
.callout-amber{background:var(--amber-bg); border:1px solid #EED9A8; color:#7A5504;}
.callout-red{background:var(--red-bg); border:1px solid #F0C4BC; color:#8A2A1E;}
.callout-navy{background:#EAF0FB; border:1px solid #C9D8F2; color:var(--navy-700);}

/* ---------- Sidebar overlay (mobile) ---------- */
.sidebar-scrim{display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:35;}

/* ---------- Charts (SVG) ---------- */
.chart-legend{display:flex; flex-wrap:wrap; gap:10px 16px; margin-top:10px; font-size:12px;}
.legend-item{display:flex; align-items:center; gap:6px; color:var(--text-muted);}
.legend-dot{width:9px; height:9px; border-radius:3px; flex-shrink:0;}

/* ---------- Utility ---------- */
.flex{display:flex; align-items:center;}
.flex-between{display:flex; align-items:center; justify-content:space-between;}
.gap-8{gap:8px;} .gap-10{gap:10px;} .gap-14{gap:14px;}
.muted{color:var(--text-muted);}
.faint{color:var(--text-faint);}
.mono{font-family:var(--mono);}
.text-right{text-align:right;}
.mt-0{margin-top:0;} .mt-8{margin-top:8px;} .mt-14{margin-top:14px;} .mt-20{margin-top:20px;}
.mb-0{margin-bottom:0;}
.w-full{width:100%;}
.divider{height:1px; background:var(--border); margin:14px 0;}
.pill-tabs{display:flex; gap:6px; flex-wrap:wrap;}
.pill{padding:6px 12px; border-radius:99px; font-size:12px; font-weight:700; border:1px solid var(--border-strong); background:var(--surface); cursor:pointer; color:var(--brown-800);}
.pill.active{background:var(--brown-800); color:#fff; border-color:var(--brown-800);}
.search-input{max-width:280px;}
.toolbar{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:16px; flex-wrap:wrap;}
.toolbar-left{display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
.link{color:var(--navy-700); text-decoration:underline; cursor:pointer; font-weight:600;}
.icon-btn{background:none; border:none; cursor:pointer; font-size:15px; color:var(--text-muted); padding:4px;}
.icon-btn:hover{color:var(--orange-dark);}
.footer-note{margin-top:26px; padding-top:14px; border-top:1px solid var(--border); font-size:11.5px; color:var(--text-faint); text-align:center;}

/* ---------- Print ---------- */
#print-area{display:none;}
@media print{
  body *{visibility:hidden;}
  #print-area, #print-area *{visibility:visible;}
  #print-area{display:block; position:absolute; top:0; left:0; width:100%; padding:24px; background:#fff;}
  .no-print{display:none !important;}
}
.print-doc{font-family:var(--font); color:#20160E;}
.print-doc .ph-header{display:flex; justify-content:space-between; align-items:flex-start; border-bottom:3px solid var(--navy); padding-bottom:14px; margin-bottom:18px;}
.print-doc .ph-brand{display:flex; gap:12px; align-items:center;}
.print-doc .ph-logo{width:50px;height:50px;border-radius:10px;background:var(--peach);display:flex;align-items:center;justify-content:center;overflow:hidden;}
.print-doc .ph-company{font-size:17px; font-weight:800; color:var(--navy);}
.print-doc .ph-tag{font-size:11px; color:var(--orange-dark); text-transform:uppercase; letter-spacing:0.05em;}
.print-doc .ph-addr{font-size:11px; color:#555; max-width:280px; margin-top:4px; line-height:1.4;}
.print-doc .ph-meta{text-align:right; font-size:12px;}
.print-doc .ph-meta .doc-title{font-size:19px; font-weight:800; color:var(--navy); margin-bottom:4px;}
.print-doc table{width:100%; border-collapse:collapse; margin-top:10px; font-size:12px;}
.print-doc th{background:var(--peach-light); text-align:left; padding:8px 10px; border:1px solid #DDD; font-size:10.5px; text-transform:uppercase;}
.print-doc td{padding:7px 10px; border:1px solid #DDD;}
.print-doc .totals{margin-top:10px; margin-left:auto; width:280px;}
.print-doc .totals div{display:flex; justify-content:space-between; padding:5px 0; font-size:12.5px; border-bottom:1px solid #EEE;}
.print-doc .totals .grand{font-weight:800; font-size:15px; color:var(--navy); border-bottom:none; border-top:2px solid var(--navy); margin-top:4px; padding-top:8px;}
.print-doc .ph-footer{margin-top:30px; font-size:11px; color:#777; text-align:center;}

/* ---------- Login / lock (simple local gate) ---------- */
.boot-screen{
  min-height:100vh; display:flex; align-items:center; justify-content:center;
  background:radial-gradient(circle at 20% 20%, var(--peach-light), var(--bg) 60%);
}
.boot-card{background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:30px; width:100%; max-width:360px; box-shadow:var(--shadow-md); text-align:center;}

/* scrollbar (webkit) general */
::-webkit-scrollbar{height:8px; width:8px;}
::-webkit-scrollbar-thumb{background:var(--border-strong); border-radius:4px;}

@media(max-width:960px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .main{margin-left:0;}
  .hamburger{display:flex; align-items:center; justify-content:center;}
  .sidebar-scrim.open{display:block;}
}
</style>
</head>
<body>

<div id="app"></div>
