        await dbPut('settings', {key:'visaAlertDays', value: days});
        toast('Visa alert threshold updated','success');
        renderRoute();
      };
    }
    if(t==='users'){ if(!isAdmin()){ body.innerHTML='<div class="callout callout-red">Admins only.</div>'; return; } await renderUsersTab(body); }
    if(t==='mypw'){ renderMyPasswordTab(body); }
    if(false && t==='security'){
      body.innerHTML = `
        <div class="card">
          <div class="card-title">App Lock (local PIN)</div>
          <p class="muted mt-0">Adds a basic PIN prompt when this app is opened on this device. This is a light deterrent for shared computers, not encryption — the underlying data in this browser is not encrypted at rest.</p>
          <div class="form-grid mt-14">
            <div class="field"><label>Enable App Lock</label>
              <select id="lk_enabled"><option value="no" ${!lockSetting.enabled?'selected':''}>Off</option><option value="yes" ${lockSetting.enabled?'selected':''}>On</option></select>
            </div>
            <div class="field"><label>PIN (4–8 digits)</label><input id="lk_pin" value="${esc(lockSetting.pin||'')}" placeholder="e.g. 1234"></div>
