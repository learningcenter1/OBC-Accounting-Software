        if(onBtn) onBtn.onclick = async ()=>{ await enableAutosave(); showTab('autosave'); };
        const offBtn = document.getElementById('as-off2');
        if(offBtn) offBtn.onclick = async ()=>{ await disableAutosave(); showTab('autosave'); };
        const saveBtn = document.getElementById('as-savenow');
        if(saveBtn) saveBtn.onclick = async ()=>{ const ok = await writeSnapshotToFile(); toast(ok?'Saved to file':'Could not save — check file permission', ok?'success':'error'); };
      }
    }
    if(t==='backup'){
      body.innerHTML = `
        <div class="card">
          <div class="card-title">Backup &amp; Restore</div>
          <p class="muted mt-0">All data lives only in this browser (IndexedDB) on this device. Export a backup regularly — especially before clearing browser data, switching computers, or updating this file.</p>
          <div class="flex gap-10 mt-14" style="flex-wrap:wrap;">
            <button class="btn btn-primary" id="bk-export">&#11015; Download Backup (.json)</button>
            ${isAdmin()?`<label class="btn" style="cursor:pointer;">&#11014; Restore From Backup
              <input type="file" id="bk-import" accept="application/json" style="display:none;">
            </label>`:''}
          </div>
          ${isAdmin()?`<div class="divider"></div>
          <div class="callout callout-red">
            <div><b>Danger zone.</b> This permanently erases every customer, transaction, ledger entry, and setting stored in this browser and re-seeds the default chart of accounts. This cannot be undone — export a backup first.</div>
          </div>
          <div class="mt-14"><button class="btn btn-danger" id="bk-reset">Erase All Data &amp; Reset</button></div>`:''}
        </div>`;
      document.getElementById('bk-export').onclick = exportBackup;
      if(isAdmin()){ document.getElementById('bk-import').addEventListener('change', importBackup);
      document.getElementById('bk-reset').onclick = async ()=>{
        const ok1 = await confirmModal('This will permanently delete ALL data in this app. Continue?');
        if(!ok1) return;
        const ok2 = await confirmModal('Really sure? This cannot be undone. Type nothing — just confirm to proceed.');
        if(!ok2) return;
        await dbClearAll();
        await seedIfEmpty();
        await ensureUsers(); await ensureCOA();
        toast('All data erased and defaults restored — please sign in again','success');
        setTimeout(logout, 900);
      }; }
    }
  }
  container.querySelectorAll('#settings-tabs .tab').forEach(t=>t.onclick=()=>showTab(t.dataset.t));
  showTab('profile');
};

const BACKUP_STORES = ['customers','vendors','currencies','accounts','employees','partners','serviceEntries','transactions','invoices','expenses','transfers','partnerTxns','counters','settings','coa','users','bankLines','reconciliations'];

async function exportBackup(){
  const dump = {};
  for(const s of BACKUP_STORES) dump[s] = await dbGetAll(s);
  dump._meta = {app:'OBC Indonesia ERP', exportedAt: new Date().toISOString(), version:1};
  const blob = new Blob([JSON.stringify(dump, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `obc-erp-backup-${todayISO()}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 4000);
  toast('Backup downloaded','success');
}

function importBackup(e){
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async ()=>{
    try{
      const dump = JSON.parse(reader.result);
      const ok = await confirmModal('Importing will REPLACE all current data with this backup. Continue?');
      if(!ok){ e.target.value=''; return; }
      await dbClearAll();
      for(const s of BACKUP_STORES){
        if(Array.isArray(dump[s])){ for(const rec of dump[s]) await dbPut(s, rec); }
      }
      toast('Backup restored successfully','success');
      navigate('dashboard');
      setTimeout(()=>window.location.reload(), 600);
    }catch(err){
      console.error(err);
      toast('Could not read that backup file','error');
    }
    e.target.value='';
  };
  reader.readAsText(file);
}

/* ---------------------------------------------------------
   21b. AUTOMATIC SAVING TO FILE
   Uses the File System Access API (Chrome/Edge) to write the entire app
   state back into THIS SAME .html file, embedded in a small JSON blob, so
   the file itself carries its own data — no separate database file to
   manage, and the file stays portable (copy it anywhere, the data goes
   with it). Falls back gracefully where the API isn't available.
--------------------------------------------------------- */
let autosaveTimer = null;
let autosaveInFlight = false;
let autosaveDirty = false;

function fsaSupported(){ return typeof window.showSaveFilePicker === 'function'; }

async function buildFullDump(){
  const dump = {};
  for(const s of BACKUP_STORES) dump[s] = await dbGetAll(s);
  dump._meta = {app:'OBC Indonesia ERP', savedAt: new Date().toISOString(), version:1};
  return dump;
}

async function getAutosaveHandle(){
  try{ const rec = await dbGet('fileHandles','autosave'); return rec ? rec.handle : null; }
  catch(e){ return null; }
}

function triggerAutosaveIfEnabled(){
  if(!STATE.settings.autosaveEnabled) return;
  autosaveDirty = true;
  if(autosaveTimer) clearTimeout(autosaveTimer);
  autosaveTimer = setTimeout(()=>{ writeSnapshotToFile().catch(err=>console.error('Autosave failed', err)); }, 900);
}

async function writeSnapshotToFile(){
  if(autosaveInFlight) return false;
  const handle = await getAutosaveHandle();
  if(!handle) return false;
  autosaveInFlight = true;
  try{
    let perm = await handle.queryPermission({mode:'readwrite'});
    if(perm !== 'granted'){
      perm = await handle.requestPermission({mode:'readwrite'});
    }
    if(perm !== 'granted'){
      await dbPutRaw('settings', {key:'autosaveEnabled', value:false});
      STATE.settings.autosaveEnabled = false;
      toast('Automatic saving paused — file permission was not granted. Re-enable it from Settings.','error');
      return false;
    }
    const dump = await buildFullDump();
    const json = JSON.stringify(dump).replace(/</g, '\\u003c');
    const newHtml = PRISTINE_HTML_SHELL.replace(
      /(<script type="application\/json" id="obc-data-blob">)([\s\S]*?)(<\/script>)/,
      (m, open, _old, close) => open + json + close
    );
    const writable = await handle.createWritable();
    await writable.write(newHtml);
    await writable.close();
    autosaveDirty = false;
    updateAutosaveStatusPill();
    return true;
  }catch(err){
    console.error('writeSnapshotToFile error', err);
    toast('Automatic saving hit an error: '+(err.message||err),'error');
    return false;
  }finally{
    autosaveInFlight = false;
  }
}

// Raw put that bypasses the autosave trigger — used internally by the
// autosave system itself so a permission failure doesn't loop back into
// scheduling another save.
function dbPutRaw(name, val){
  return new Promise((res,rej)=>{
    const tx = DB.transaction(name,'readwrite');
    const r = tx.objectStore(name).put(val);
    r.onsuccess=()=>res(val);
    r.onerror=()=>rej(r.error);
  });
}

async function enableAutosave(){
  if(!fsaSupported()){
    toast('Automatic saving needs Chrome or Edge, opened directly from a folder on disk.','error');
    return false;
  }
  try{
    const handle = await window.showSaveFilePicker({
      suggestedName: 'OBC_Indonesia_ERP.html',
      types: [{description:'HTML File', accept:{'text/html':['.html']}}],
    });
    const perm = await handle.requestPermission({mode:'readwrite'});
    if(perm !== 'granted'){
      toast('Permission not granted — automatic saving stayed off.','error');
      return false;
    }
    await dbPutRaw('fileHandles', {key:'autosave', handle, fileName: handle.name});
    await dbPut('settings', {key:'autosaveEnabled', value:true});
    STATE.settings.autosaveEnabled = true;
    await writeSnapshotToFile();
    toast('Automatic saving turned on — this file now updates itself as you work.','success');
    return true;
  }catch(err){
    if(err && err.name==='AbortError') return false; // user cancelled the picker
    console.error(err);
    toast('Could not enable automatic saving: '+(err.message||err),'error');
    return false;
  }
}

async function disableAutosave(){
  await dbPut('settings', {key:'autosaveEnabled', value:false});
  STATE.settings.autosaveEnabled = false;
  toast('Automatic saving turned off. You can still back up manually anytime.','success');
}

function updateAutosaveStatusPill(){
  const el = document.getElementById('autosave-status-pill');
  if(!el) return;
  if(STATE.settings.autosaveEnabled) el.textContent = autosaveInFlight ? 'Saving…' : 'Saved';
}

/* "Automatic Saving" reminder — shown on EVERY app launch, no exceptions,
   even if automatic saving is already turned on. Browsers can silently drop
   the saved file permission between sessions, so this doubles as a chance
   to reconfirm access with a genuine click (required for the file picker /
   permission prompt to work) rather than relying on a background retry. */
function maybeShowAutosavePrompt(){
  const already = !!STATE.settings.autosaveEnabled;
  const body = already ? `
    <p>Automatic saving is currently <b>ON</b> for this file. Browsers sometimes forget file access permission between sessions, so click below to reconfirm it and make sure every sale, purchase, receipt and payment keeps writing straight back into this file.</p>
    <p class="muted" style="font-size:12.5px;">This check-in appears every time you open the app so saving never silently stops.</p>
    <div class="form-actions">
      <button class="btn" id="as-off">Dismiss</button>
      <button class="btn btn-primary" id="as-on">Reconfirm Automatic Saving</button>
    </div>` : `
    <p>This app saves your data <b>inside this very .html file</b> — no separate data file to manage. Turn on automatic saving so every sale, purchase, receipt and payment writes straight back into it as you work.</p>
    <p class="muted" style="font-size:12.5px;">You'll be asked to pick a file — choose <b>this exact .html file</b> (the one you just opened). You can do this anytime later from Backup &amp; Restore instead. This reminder appears every time you open the app until automatic saving is turned on.</p>
    <div class="form-actions">
      <button class="btn" id="as-off">Keep Off (Manual Backup)</button>
      <button class="btn btn-primary" id="as-on">Enable Automatic Saving</button>
    </div>`;
  const {close} = openModal('Automatic Saving', body);
  document.getElementById('as-off').onclick = ()=>{ close(); };
  document.getElementById('as-on').onclick = async ()=>{
    close();
    await enableAutosave();
  };
}

/* On boot, if the currently-open file already has embedded data (i.e. it was
   previously auto-saved), that data is authoritative for THIS copy of the
   file — import it so the file stays fully portable across machines/browsers. */
async function importEmbeddedDataIfPresent(){
  if(!EMBEDDED_DATA_RAW) return false;
  let dump;
  try{ dump = JSON.parse(EMBEDDED_DATA_RAW); }catch(e){ return false; }
  if(!dump || !dump._meta || !Array.isArray(dump.currencies)) return false;
  // Only trust the embedded snapshot if it actually has content — an empty/pristine template has empty arrays.
  // Settings/counters/users/coa alone are app scaffolding, not business data. An embedded blob that
  // only carries those (e.g. the pristine template with autosaveEnabled) must NOT wipe the browser's
  // IndexedDB on every page load — that silently erased restored backups and newly entered data.
  const DATA_STORES = BACKUP_STORES.filter(s => !['settings','counters','users','coa'].includes(s));
  const hasContent = DATA_STORES.some(s => Array.isArray(dump[s]) && dump[s].length>0);
  if(!hasContent) return false;
  await dbClearAll();
  for(const s of BACKUP_STORES){
    if(Array.isArray(dump[s])){ for(const rec of dump[s]) await dbPutRaw(s, rec); }
  }
  return true;
}

/* ---------------------------------------------------------
   22. BOOTSTRAP
--------------------------------------------------------- */

// Safety net: every "Save" button handler is an async function. If one throws
// (a bug, a missing field, a storage error), the promise rejects silently and
// the button just looks "dead" with no feedback. Surface it instead.
window.addEventListener('unhandledrejection', (e)=>{
  console.error('Unhandled error:', e.reason);
  const msg = (e.reason && (e.reason.message || String(e.reason))) || 'Unknown error';
  toast('Something went wrong — ' + msg, 'error');
  e.preventDefault();
});

async function loadCompanyProfile(){
  const rec = await dbGet('settings','companyProfile');
  if(rec && rec.value){ Object.assign(COMPANY, rec.value); }
}

function renderLockScreen(correctPin, onUnlock){
  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="boot-screen">
      <div class="boot-card">
        ${logoMarkSVG(56)}
        <h2 class="mt-14" style="font-size:18px;">OBC Indonesia ERP</h2>
        <p class="muted" style="font-size:12.5px;">Enter your PIN to continue</p>
        <input type="password" id="lock-pin" inputmode="numeric" maxlength="8" style="text-align:center;letter-spacing:6px;font-size:20px;margin-top:10px;" placeholder="••••">
        <div id="lock-error" class="callout callout-red mt-14" style="display:none;">Incorrect PIN. Try again.</div>
        <button class="btn btn-primary w-full mt-14" id="lock-submit">Unlock</button>
      </div>
    </div>`;
  const input = document.getElementById('lock-pin');
  input.focus();
  function tryUnlock(){
    if(input.value === correctPin){ onUnlock(); }
    else { document.getElementById('lock-error').style.display='flex'; input.value=''; input.focus(); }
  }
  document.getElementById('lock-submit').onclick = tryUnlock;
  input.addEventListener('keydown', e=>{ if(e.key==='Enter') tryUnlock(); });
}

async function boot(){
  await openDB();
  await importEmbeddedDataIfPresent();
  await seedIfEmpty();
  await loadCompanyProfile();
  await ensureUsers();
  await ensureCOA();
  await reloadCoreCaches();
  const start = async ()=>{ await handleRoute(); setTimeout(maybeShowAutosavePrompt, 400); };
  const sid = sessionGet();
  const su = sid ? await dbGet('users', sid) : null;
  if(su && su.active!==false){ STATE.currentUser = su; await start(); }
  else renderLoginScreen(start);
}

boot().catch(err=>{
  console.error('Failed to start OBC ERP', err);
  document.getElementById('app').innerHTML = `
    <div class="boot-screen"><div class="boot-card">
      <h2>Could not start the app</h2>
      <p class="muted">${esc(err.message||String(err))}</p>
      <p class="muted" style="font-size:11.5px;">This app requires a modern browser with IndexedDB support (Chrome, Edge, Firefox, or Safari). Try opening it directly in one of these browsers.</p>
    </div></div>`;
});

</script></body></html>